prefix=${pcfiledir}/@LIBNOSTRGO_PC_PREFIX_RELATIVE@
exec_prefix=${prefix}
libdir=@LIBNOSTRGO_PC_LIBDIR@
includedir=@LIBNOSTRGO_PC_INCLUDEDIR@

Name: libnostrgo
Description: Go-inspired concurrency primitives for C (formerly libgo)
Version: @LIBGO_VERSION@
Libs: -L${libdir} -lnostrgo
Libs.private: @LIBNOSTRGO_PC_NSYNC_LIB@-lpthread
Cflags: -I${includedir} @LIBNOSTRGO_PC_NSYNC_CFLAGS@
