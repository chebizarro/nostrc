prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: libnostrgo
Description: Go-inspired concurrency primitives for C (formerly libgo)
Version: @LIBGO_VERSION@
Libs: -L${libdir} -lnostrgo
Libs.private: @LIBNOSTRGO_PC_NSYNC_LIB@-lpthread
Cflags: -I${includedir}
