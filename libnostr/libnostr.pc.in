prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@/nostr

Name: libnostr
Description: Nostr protocol implementation for C (core + optional GLib integration)
Version: @NOSTR_VERSION@
Requires: @NOSTR_PKG_REQUIRES@
Libs: -L${libdir} -lnostr
Cflags: -I${includedir}
