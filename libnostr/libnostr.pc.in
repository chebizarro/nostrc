prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@/nostr

Name: libnostr
Description: Nostr protocol implementation for C (core + optional GLib integration)
Version: @NOSTR_VERSION@
Requires: libnostrgo >= 0.3.1
Libs: -L${libdir} -lnostr @NOSTR_PKG_LIBS_PUBLIC@
Libs.private: @NOSTR_PKG_LIBS_PRIVATE@
Cflags: -I${includedir} @NOSTR_PKG_CFLAGS@
