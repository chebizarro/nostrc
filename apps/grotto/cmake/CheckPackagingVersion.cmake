cmake_minimum_required(VERSION 3.22)

# All Grotto version authorities must agree with GROTTO_VERSION_FULL.
# Native package syntax may differ: Debian uses ~, RPM a pre-final Release,
# Arch strips the hyphen, and Apple's bundle fields retain the numeric base.
if (NOT VERSION OR NOT ROOT)
  message(FATAL_ERROR "usage: cmake -DVERSION=... -DROOT=... -P CheckPackagingVersion.cmake")
endif()
string(REGEX REPLACE "-.*$" "" BASE_VERSION "${VERSION}")
string(REGEX REPLACE "^[0-9.]+-?" "" PRERELEASE "${VERSION}")
string(REPLACE "-" "~" DEB_VERSION "${VERSION}")
set(failed FALSE)
function(expect file needle)
  file(READ "${ROOT}/${file}" content)
  string(FIND "${content}" "${needle}" found)
  if (found EQUAL -1)
    message(SEND_ERROR "${file}: expected ${needle} (version ${VERSION})")
    set(failed TRUE PARENT_SCOPE)
  endif()
endfunction()
set(APP apps/grotto)
expect(${APP}/CMakeLists.txt "project(grotto VERSION ${BASE_VERSION} LANGUAGES C)")
expect(${APP}/CMakeLists.txt "set(GROTTO_PRERELEASE \"${PRERELEASE}\")")
expect(${APP}/meson.build "version: '${VERSION}',")
expect(${APP}/data/org.nostr.Grotto.metainfo.xml "<release version=\"${VERSION}\"")
expect(VERSION_MANIFEST.md "| Grotto | `apps/grotto/` | ${VERSION} |")
expect(flake.nix "pname = \"grotto\";\n            version = \"${VERSION}\";")
expect(${APP}/packaging/archlinux/PKGBUILD "\n_version=${VERSION}\n")
expect(${APP}/packaging/archlinux/PKGBUILD [=[pkgver=${_version//-/}]=])
expect(${APP}/packaging/archlinux/PKGBUILD [=[source=("grotto-${_version}.tar.gz")]=])
expect(${APP}/packaging/rpm/grotto.spec "\n%global upstream_version ${VERSION}\n")
expect(${APP}/packaging/rpm/grotto.spec "\nVersion:        ${BASE_VERSION}\n")
expect(${APP}/packaging/rpm/grotto.spec [=[Source0:        grotto-%{upstream_version}.tar.gz]=])
expect(${APP}/packaging/rpm/grotto.spec [=[%autosetup -n grotto-%{upstream_version}]=])
if (PRERELEASE)
  file(READ "${ROOT}/${APP}/packaging/rpm/grotto.spec" spec)
  if (NOT spec MATCHES "\nRelease: +0\\.[0-9]+\\.${PRERELEASE}%\\{\\?dist\\}\n")
    message(SEND_ERROR "RPM Release must sort before the final release and name ${PRERELEASE}")
    set(failed TRUE)
  endif()
endif()
file(STRINGS "${ROOT}/${APP}/packaging/debian/changelog" first_entry LIMIT_COUNT 1)
string(FIND "${first_entry}" "grotto (${DEB_VERSION}-" first_entry_version)
if (NOT first_entry_version EQUAL 0)
  message(SEND_ERROR "Debian first changelog entry must name ${DEB_VERSION}")
  set(failed TRUE)
endif()
expect(${APP}/packaging/macos/create-dmg.sh "VERSION=\"\${VERSION:-${VERSION}}\"")
expect(${APP}/packaging/macos/create-dmg.sh [=[sed "s/@VERSION@/${VERSION%%-*}/g"]=])
expect(${APP}/CMakeLists.txt [=[string(REPLACE "@VERSION@" "${PROJECT_VERSION}" INFO_PLIST_CONTENT]=])
expect(${APP}/packaging/macos/Info.plist.in "<key>CFBundleVersion</key>\n    <string>@VERSION@</string>")
expect(${APP}/packaging/macos/Info.plist.in "<key>CFBundleShortVersionString</key>\n    <string>@VERSION@</string>")
expect(${APP}/packaging/windows/grotto.nsi "!define VERSION \"${VERSION}\"")
expect(${APP}/packaging/windows/build-msys2.sh "-DVERSION=\"${VERSION}\"")
foreach(package grotto grotto-daemon)
  expect(snap/${package}/snapcraft.yaml "\nversion: ${VERSION}\n")
endforeach()
if (failed)
  message(FATAL_ERROR "packaging files disagree with GROTTO_VERSION_FULL=${VERSION}")
endif()
message(STATUS "Grotto packaging files name ${VERSION}")
