using Gtk 4.0;
using Adw 1;
template $GrottoPageConnect: Adw.PreferencesPage {
  title: _("Connect");
  Adw.PreferencesGroup {
    title: _("Connect an Application");
    description: _("Connect an app on another device. You'll choose an identity and review the connection first.");
    Adw.ActionRow paste {
      title: _("Paste App Link"); subtitle: _("Preview a link from your clipboard"); activatable: true;
      [prefix] Image { icon-name: "edit-paste-symbolic"; }
      [suffix] Image { icon-name: "go-next-symbolic"; }
    }
    Adw.ActionRow scan {
      title: _("Scan QR Code…"); subtitle: _("Use your camera or a QR image"); activatable: true;
      [prefix] Image { icon-name: "camera-photo-symbolic"; }
      [suffix] Image { icon-name: "go-next-symbolic"; }
    }
    Adw.ActionRow open_link {
      title: _("Open Link File…"); subtitle: _("Choose a connection link saved by your app"); activatable: true;
      [prefix] Image { icon-name: "insert-link-symbolic"; }
      [suffix] Image { icon-name: "go-next-symbolic"; }
    }
    Adw.ActionRow create_link {
      title: _("Create Pairing Link…"); subtitle: _("Show a single-use link or QR code"); activatable: true;
      [prefix] Image { icon-name: "list-add-symbolic"; }
      [suffix] Image { icon-name: "go-next-symbolic"; }
    }
  }
  Adw.PreferencesGroup {
    Adw.ActionRow runtime { title: _("Remote Signing"); subtitle: _("Connecting to signer…"); subtitle-lines: 3; }
    Label {
      label: _("Apps on this device ask for permission automatically. Apps can sign only after you approve their permissions.");
      wrap: true; xalign: 0;
    }
  }
}
