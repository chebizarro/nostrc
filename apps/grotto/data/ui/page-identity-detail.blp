using Gtk 4.0;
using Adw 1;
template $GrottoIdentityDetail: Adw.NavigationPage {
  title: _("Identity and backup");
  tag: "identity-detail";
  Adw.ToolbarView {
    [top] Adw.HeaderBar {}
    content: ScrolledWindow {
      hscrollbar-policy: never;
      Adw.Clamp {
        maximum-size: 560;
        margin-start: 20; margin-end: 20; margin-top: 16; margin-bottom: 20;
        Box {
          orientation: vertical; spacing: 18;
          DropDown identities { accessibility { label: _("Identity to manage"); } }
          Label setup_warning { wrap: true; xalign: 0; styles ["warning"] }
          Label public_key { wrap: true; selectable: true; xalign: 0; styles ["monospace"] }
          Entry label_entry { placeholder-text: _("Local identity label"); }
          Button btn_label { label: _("Save local label"); }
          Adw.PreferencesGroup {
            title: _("Key backup and safety tips");
            description: _("Your secret key gives full control. Never paste it into software you do not trust. Grotto developers never ask for it. Keep a private backup. Clipboard managers can retain anything you copy.");
            Adw.ActionRow {
              title: _("Show seed words");
              subtitle: _("Primary backup for identities created in Grotto");
              activatable-widget: btn_seed;
              [suffix] Button btn_seed { label: _("Show"); valign: center; styles ["suggested-action"] }
            }
          }
          Box seed_words { orientation: vertical; styles ["monospace"] }
          CheckButton backup_written_down { label: _("I have safely backed up this identity"); }
          Button btn_backup_done { label: _("Confirm backup"); }
          Label { label: _("Encrypted export passphrase (NIP-49 only)"); wrap: true; xalign: 0; }
          Box export_passphrase_box { orientation: vertical; }
          Button btn_export { label: _("Export encrypted key (NIP-49)"); }
          Button btn_qr { label: _("Show encrypted key QR code"); }
          Button btn_raw { label: _("Copy secret key…"); styles ["destructive-action"] }
          Adw.PreferencesGroup {
            title: _("Identity management");
            description: _("Managing this identity never switches identities for another application.");
            Adw.ActionRow {
              title: _("Default for older apps");
              subtitle: _("Only applications that do not specify an identity use this default");
              [suffix] Button btn_default { label: _("Set default"); valign: center; }
            }
          }
          Button btn_test { label: _("Retry identity self-test"); }
          Button btn_rotate { label: _("Create successor identity…"); }
          Button btn_migration { label: _("Export saved migration announcement"); }
          Button btn_remove { label: _("Remove this identity…"); styles ["destructive-action"] }
          Label status_label { wrap: true; xalign: 0; }
        }
      }
    };
  }
}
