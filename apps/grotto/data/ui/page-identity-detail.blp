using Gtk 4.0;
using Adw 1;
template $GrottoIdentityDetail: Adw.NavigationPage {
  title: _("Back Up Identity");
  tag: "backup";
  Adw.ToolbarView {
    [top] Adw.HeaderBar header {}
    [top] Adw.Banner setup_banner { title: _("Backup incomplete"); revealed: false; }
    [top] Adw.Banner error_banner { title: _("The backup action couldn't be completed"); button-label: _("Retry"); revealed: false; }
    content: Adw.PreferencesPage {
      description: _("Anyone with this backup controls your identity. Grotto developers will never ask for it");
      Adw.PreferencesGroup {
        Adw.ActionRow public_key { title: _("Identity"); subtitle-selectable: true; subtitle-lines: 0; }
        Adw.ActionRow phrase_row { title: _("Show Recovery Phrase…"); subtitle: _("Words to write down and keep offline"); activatable: true; }
      }
      Adw.PreferencesGroup encrypted_group {
        title: _("Encrypted Backup"); description: _("Protected by a passphrase you choose");
        Adw.ActionRow save_row { title: _("Save to File…"); activatable: true; }
        Adw.ActionRow qr_row { title: _("Show QR Code…"); activatable: true; }
      }
      Adw.PreferencesGroup advanced_group {
        title: _("Advanced");
        Adw.ActionRow raw_row { title: _("Copy Secret Key…"); subtitle: _("Clipboard managers may keep a copy"); activatable: true; }
        Adw.ActionRow test_row { title: _("Test This Identity"); subtitle: _("Signs and encrypts a test message on this device"); activatable: true; }
        Adw.ActionRow replace_row { title: _("Create Replacement Identity…"); subtitle: _("Apps aren't moved and permissions aren't copied"); activatable: true; }
        Adw.ActionRow announcement_row { title: _("Save Migration Announcement…"); activatable: true; visible: false; }
      }
    };
  }
}
