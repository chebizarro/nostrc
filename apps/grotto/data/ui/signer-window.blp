using Gtk 4.0;
using Adw 1;
template $SignerWindow: Adw.ApplicationWindow {
  default-width: 920; default-height: 640;
  width-request: 360; height-request: 480;
  accessibility { label: _("Grotto Main Window"); }
  Adw.Breakpoint { condition ("max-width: 600sp") setters { split_view.collapsed: true; } }
  Adw.ToastOverlay toast_overlay {
    Stack main_stack {
      StackPage { name: "locked"; child: $GnLockScreen lock_screen {}; }
      StackPage {
        name: "unlocked";
        child: Adw.NavigationSplitView split_view {
          min-sidebar-width: 200; max-sidebar-width: 280;
          [content] Adw.NavigationPage content_page {
            title: _("Identity");
            child: Stack panel_stack { hhomogeneous: false; vhomogeneous: false; };
          }
          [sidebar] Adw.NavigationPage {
            title: _("Grotto");
            child: Adw.ToolbarView {
              [top] Adw.HeaderBar {
                [end] MenuButton menu_btn {
                  icon-name: "open-menu-symbolic";
                  primary: true;
                  tooltip-text: _("Main Menu");
                  accessibility { label: _("Main Menu"); }
                }
              }
              content: ScrolledWindow {
                hscrollbar-policy: never;
                ListBox sidebar {
                  selection-mode: browse;
                  activate-on-single-click: true;
                  styles ["navigation-sidebar"]
                  accessibility { label: _("Panels"); }
                }
              };
            };
          }
        };
      }
    }
  }
}
