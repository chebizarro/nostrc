using Gtk 4.0;
using Adw 1;
template $SheetQrDisplay: Adw.Dialog {
  title: _("QR Code");
  content-width: 360;
  follows-content-size: true;
  Adw.ToolbarView {
    [top] Adw.HeaderBar {
      show-end-title-buttons: false;
      show-start-title-buttons: false;
      [start] Button btn_close { label: _("_Close"); use-underline: true; }
      [end] Button btn_copy { icon-name: "edit-copy-symbolic"; tooltip-text: _("Copy to Clipboard"); }
    }
    ScrolledWindow {
      hscrollbar-policy: never; propagate-natural-height: true;
      min-content-height: 200; max-content-height: 560;
      Box content_box {
        orientation: vertical; spacing: 16;
        margin-start: 20; margin-end: 20; margin-top: 16; margin-bottom: 24;
        Picture qr_picture {
          content-fit: contain; width-request: 248; height-request: 248;
          halign: center;
          accessibility { label: _("QR Code"); description: _("Scan with a compatible app"); }
        }
        Box warning_box {
          visible: false;
          Label warning_label { wrap: true; xalign: 0; hexpand: true; }
        }
        Expander data_details {
          label: _("Details");
          Box {
            orientation: vertical; spacing: 8;
            Label type_label { wrap: true; xalign: 0; styles ["dim-label"] }
            Label data_label { wrap: true; wrap-mode: char; selectable: true; xalign: 0; styles ["monospace", "caption"] }
          }
        }
      }
    }
  }
}
