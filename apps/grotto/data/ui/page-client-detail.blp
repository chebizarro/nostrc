using Gtk 4.0;
using Adw 1;
template $GrottoClientDetail: Adw.NavigationPage {
  title: _("Client");
  child: Adw.NavigationView navigation {
    Adw.NavigationPage {
      title: _("Client");
      child: Adw.ToolbarView {
        [top] Adw.HeaderBar { show-start-title-buttons: false; show-end-title-buttons: false; }
        Adw.PreferencesPage {
          Adw.PreferencesGroup {
            Adw.EntryRow label_entry { title: _("Client label"); show-apply-button: true; }
            Adw.ActionRow fingerprint { title: _("Verified identity / fingerprint"); subtitle-lines: 3; }
            Adw.ActionRow connected_since { title: _("Connected since"); }
            Label message { wrap: true; xalign: 0; }
          }
          Adw.PreferencesGroup {
            title: _("Trust Level");
            description: _("Explicit denials win. Saved permissions override presets; ask-by-default kinds need a scoped first grant.");
            Adw.ActionRow full_access_row { title: _("Routine access"); subtitle: _("Routine operations, not custom kinds");
              activatable-widget: full;
              [prefix] CheckButton full { accessibility { label: _("Full: Routine operations, not custom kinds"); } }
            }
            Adw.ActionRow { title: _("Medium"); subtitle: _("Ask for sensitive operations");
              activatable-widget: medium;
              [prefix] CheckButton medium { group: full; accessibility { label: _("Medium: Ask for sensitive operations"); } }
            }
            Adw.ActionRow { title: _("Ask unless permitted"); subtitle: _("Ask unless permitted");
              activatable-widget: low;
              [prefix] CheckButton low { group: full; active: true; accessibility { label: _("Ask unless permitted"); } }
            }
            Adw.ActionRow permissions { title: _("Permissions"); activatable: true;
              [suffix] Image { icon-name: "go-next-symbolic"; }
            }
            Button clear_permissions { label: _("Clear Remembered Permissions…"); halign: start; }
          }
          Adw.PreferencesGroup {
            title: _("Recent Activity");
            ListBox activity { selection-mode: none; styles ["boxed-list"] }
          }
          Adw.PreferencesGroup {
            Button revoke { label: _("Revoke Client…"); halign: start; styles ["destructive-action"] }
          }
        }
      };
    }
  };
}
