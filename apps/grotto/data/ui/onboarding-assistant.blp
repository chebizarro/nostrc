using Gtk 4.0;
using Adw 1;
template $OnboardingAssistant: Adw.Window {
  title: _("Set Up Grotto");
  default-width: 480;
  default-height: 600;
  width-request: 320;
  Box {
    orientation: vertical;
    Adw.NavigationView steps {
      vexpand: true;
      Adw.NavigationPage page_welcome {
        tag: "welcome"; title: _("Set Up Grotto");
        Adw.ToolbarView {
          [top] Adw.HeaderBar header_welcome {
            show-start-title-buttons: false; show-end-title-buttons: false;
            title-widget: Label { label: bind page_welcome.title; wrap: true; justify: center; styles ["heading"] };
            [start] Button btn_skip { label: _("_Skip Setup"); use-underline: true; }
          }
          Adw.StatusPage {
            icon-name: "org.nostr.Grotto";
            title: _("Your Identity, Your Control");
            description: _("Keep your keys in the system keyring. Choose which apps may use your identity without sharing your secret key.");
            child: Box welcome_actions {
              orientation: vertical; halign: center;
              Button btn_next { label: _("_Get Started"); use-underline: true; styles ["suggested-action", "pill"] }
            };
          }
        }
      }
      Adw.NavigationPage page_choice {
        tag: "choice"; title: _("Add Identity");
        Adw.ToolbarView {
          [top] Adw.HeaderBar header_choice { show-start-title-buttons: false; show-end-title-buttons: false; title-widget: Label { label: bind page_choice.title; wrap: true; justify: center; styles ["heading"] }; }
          Adw.PreferencesPage {
            Adw.PreferencesGroup {
              Adw.ActionRow choose_create { title: _("Create Identity"); subtitle: _("Start with a new identity"); activatable: true; [suffix] Image { icon-name: "go-next-symbolic"; } }
              Adw.ActionRow choose_import { title: _("Import Identity"); subtitle: _("Use a key or recovery phrase you already have"); activatable: true; [suffix] Image { icon-name: "go-next-symbolic"; } }
              Adw.ActionRow choose_connect { title: _("Connect App"); subtitle: _("Use an identity already on this device"); activatable: true; [suffix] Image { icon-name: "go-next-symbolic"; } }
            }
          }
        }
      }
      Adw.NavigationPage page_create {
        tag: "create"; title: _("Create Identity");
        Adw.ToolbarView {
          [top] Adw.HeaderBar header_create { show-start-title-buttons: false; show-end-title-buttons: false; title-widget: Label { label: bind page_create.title; wrap: true; justify: center; styles ["heading"] }; }
          Adw.PreferencesPage {
            description: _("Your new key is saved in the system keyring. Next, check that it works and save a recovery phrase.");
            Adw.PreferencesGroup { Adw.EntryRow entry_profile_name { title: _("Name on This Device"); activates-default: true; } }
          }
        }
      }
      Adw.NavigationPage page_import {
        tag: "import"; title: _("Import Identity");
        Adw.ToolbarView {
          [top] Adw.HeaderBar header_import { show-start-title-buttons: false; show-end-title-buttons: false; title-widget: Label { label: bind page_import.title; wrap: true; justify: center; styles ["heading"] }; }
          Adw.PreferencesPage {
            description: _("Enter your secret key, encrypted backup, or recovery phrase.");
            Adw.PreferencesGroup {
              Adw.EntryRow entry_import_label { title: _("Name on This Device"); activates-default: true; }
              Adw.PasswordEntryRow text_import_data {
                title: _("Key or Recovery Phrase");
                enable-undo: false;
                activates-default: true;
              }
            }
            Adw.PreferencesGroup import_passphrase_group {
              Label import_passphrase_label { label: _("Backup passphrase"); wrap: true; xalign: 0; }
              Box box_import_passphrase_container { orientation: vertical; }
            }
          }
        }
      }
      Adw.NavigationPage page_connect {
        tag: "connect"; title: _("Connect App");
        Adw.ToolbarView {
          [top] Adw.HeaderBar header_connect { show-start-title-buttons: false; show-end-title-buttons: false; title-widget: Label { label: bind page_connect.title; wrap: true; justify: center; styles ["heading"] }; }
          Adw.StatusPage {
            icon-name: "application-x-addon-symbolic"; title: _("Connect App");
            description: _("Apps on this device ask for permission when they first use Grotto. For an app on another device, open Connected Apps to pair it.");
            child: Box connect_actions {
              orientation: vertical; spacing: 18;
              Adw.PreferencesGroup {
                Adw.ActionRow connect_create { title: _("Create Identity"); subtitle: _("If you don't have one on this device yet"); activatable: true; [suffix] Image { icon-name: "go-next-symbolic"; } }
                Adw.ActionRow connect_import { title: _("Import Identity"); activatable: true; [suffix] Image { icon-name: "go-next-symbolic"; } }
              }
            };
          }
        }
      }
      Adw.NavigationPage page_test {
        tag: "test"; title: _("Check Identity");
        Adw.ToolbarView {
          [top] Adw.HeaderBar header_test { show-start-title-buttons: false; show-end-title-buttons: false; title-widget: Label { label: bind page_test.title; wrap: true; justify: center; styles ["heading"] }; }
          Adw.PreferencesPage {
            description: _("Approve a one-time signing and encryption check. Nothing is published and no app permissions are saved.");
            Adw.PreferencesGroup { Box pending_requests { orientation: vertical; } }
            Adw.PreferencesGroup {
              Adw.ExpanderRow {
                title: _("Details");
                Adw.ActionRow { title: _("On This Device Only"); subtitle: _("Signs and verifies a test message, then encrypts and decrypts it with a temporary key."); subtitle-lines: 0; }
              }
            }
          }
        }
      }
      Adw.NavigationPage page_failed {
        tag: "failed"; title: _("Identity Check Failed");
        Adw.ToolbarView {
          [top] Adw.HeaderBar header_failed { show-start-title-buttons: false; show-end-title-buttons: false; title-widget: Label { label: bind page_failed.title; wrap: true; justify: center; styles ["heading"] }; }
          Adw.StatusPage {
            icon-name: "dialog-warning-symbolic"; title: _("Identity Check Failed");
            description: _("Your identity is saved. Try the check again, or skip it and keep a warning on this identity.");
            child: Box failed_actions { orientation: vertical; halign: center; };
          }
        }
      }
      Adw.NavigationPage page_backup {
        tag: "backup"; title: _("Back Up Identity");
        Adw.ToolbarView {
          [top] Adw.HeaderBar header_backup { show-start-title-buttons: false; show-end-title-buttons: false; title-widget: Label { label: bind page_backup.title; wrap: true; justify: center; styles ["heading"] }; }
          Adw.PreferencesPage {
            description: _("Write these words down in order and keep them private. Anyone with them controls your identity.");
            Adw.PreferencesGroup { Box seed_words { orientation: vertical; styles ["monospace"] } }
            Adw.PreferencesGroup {
              CheckButton seed_written_down {
                accessibility { label: _("I have safely backed up my identity"); }
                child: Label { label: _("I have safely backed up my identity"); wrap: true; xalign: 0; };
              }
            }
            Adw.PreferencesGroup {
              Adw.ExpanderRow {
                title: _("Other Backup Options");
                Adw.ActionRow {
                  title: _("Copy Recovery Phrase"); subtitle: _("Clipboard managers may keep a copy"); subtitle-lines: 0;
                  [suffix] Button btn_copy_seed { label: _("Cop_y"); use-underline: true; valign: center; accessibility { label: _("Copy Recovery Phrase"); } }
                }
                Adw.ActionRow { title: _("Encrypted Backup"); [suffix] Button btn_backup_export { label: _("_Open Backup…"); use-underline: true; valign: center; } }
                Adw.ActionRow { title: _("Recovery Phrase Unavailable?"); [suffix] Button btn_backup_retry { label: _("_Try Again"); use-underline: true; valign: center; } }
              }
            }
          }
        }
      }
      Adw.NavigationPage page_ready {
        tag: "ready"; title: _("Setup Complete");
        Adw.ToolbarView {
          [top] Adw.HeaderBar header_ready { show-start-title-buttons: false; show-end-title-buttons: false; title-widget: Label { label: bind page_ready.title; wrap: true; justify: center; styles ["heading"] }; }
          Adw.StatusPage {
            icon-name: "emblem-ok-symbolic"; title: _("Your Identity Is Ready");
            child: Box ready_actions {
              orientation: vertical; spacing: 18;
              Label ready_summary { wrap: true; }
            };
          }
        }
      }
    }
    Adw.Clamp {
      maximum-size: 480; tightening-threshold: 320;
      Box {
        orientation: vertical; spacing: 8;
        margin-start: 20; margin-end: 20; margin-bottom: 12;
        Spinner spinner_status {}
        Label lbl_status { wrap: true; xalign: 0; }
      }
    }
  }
}
