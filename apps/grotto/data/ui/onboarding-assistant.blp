using Gtk 4.0;
using Adw 1;
template $OnboardingAssistant: Adw.Window {
  title: _("Set Up Grotto");
  default-width: 480;
  default-height: 600;
  width-request: 320;
  Adw.ToolbarView {
    [top] Adw.HeaderBar header_actions {
      title-widget: Label {
        label: bind template.title;
        ellipsize: end;
        styles ["title"]
      };
      show-start-title-buttons: false;
      show-end-title-buttons: false;
      [start] MenuButton finish_menu {
        visible: false;
        icon-name: "view-more-symbolic";
        tooltip-text: _("More Setup Options");
        popover: Popover finish_popover {};
      }
      [start] Button btn_skip { label: _("_Skip Setup"); use-underline: true; }
      [start] Button btn_back {
        icon-name: "go-previous-symbolic";
        tooltip-text: _("Back");
        accessibility { label: _("Back"); }
      }
      [end] Button btn_next { label: _("_Get Started"); use-underline: true; styles ["suggested-action"] }
    }
    Box {
      orientation: vertical;
      Adw.NavigationView steps {
        vexpand: true;
        Adw.NavigationPage {
          tag: "welcome"; title: _("Set Up Grotto");
          Adw.StatusPage {
            icon-name: "org.nostr.Grotto";
            title: _("Your Identity, Your Control");
            description: _("Keep your keys in the system keyring. Choose which apps may use your identity without sharing your secret key.");
          }
        }
        Adw.NavigationPage {
          tag: "choice"; title: _("Add an Identity");
          Adw.PreferencesPage {
            Adw.PreferencesGroup {
              Adw.ActionRow choose_create { title: _("Create an Identity"); subtitle: _("Start with a new identity"); activatable: true; [suffix] Image { icon-name: "go-next-symbolic"; } }
              Adw.ActionRow choose_import { title: _("Import an Identity"); subtitle: _("Use a key or recovery phrase you already have"); activatable: true; [suffix] Image { icon-name: "go-next-symbolic"; } }
              Adw.ActionRow choose_connect { title: _("Connect an App"); subtitle: _("Use an identity already on this device"); activatable: true; [suffix] Image { icon-name: "go-next-symbolic"; } }
            }
          }
        }
        Adw.NavigationPage {
          tag: "create"; title: _("Create an Identity");
          Adw.PreferencesPage {
            description: _("Your new key is saved in the system keyring. Next, check that it works and save a recovery phrase.");
            Adw.PreferencesGroup { Adw.EntryRow entry_profile_name { title: _("Name on This Device"); } }
          }
        }
        Adw.NavigationPage {
          tag: "import"; title: _("Import an Identity");
          Adw.PreferencesPage {
            description: _("Enter your secret key, encrypted backup, or recovery phrase.");
            Adw.PreferencesGroup {
              Adw.EntryRow entry_import_label { title: _("Name on This Device"); }
              Adw.PreferencesRow {
                Box {
                  orientation: vertical; spacing: 6;
                  margin-start: 12; margin-end: 12; margin-top: 12; margin-bottom: 12;
                  Label { label: _("Key or Recovery Phrase"); xalign: 0; }
                  Entry text_import_data { visibility: false; enable-undo: false; accessibility { label: _("Key or Recovery Phrase"); } }
                }
              }
            }
            Adw.PreferencesGroup import_passphrase_group {
              Label import_passphrase_label { label: _("Backup passphrase"); wrap: true; xalign: 0; }
              Box box_import_passphrase_container { orientation: vertical; }
            }
          }
        }
        Adw.NavigationPage {
          tag: "connect"; title: _("Connect an App");
          Adw.PreferencesPage {
            description: _("Apps on this device ask for permission when they first use Grotto. For an app on another device, open Connected Apps to pair it.");
            Adw.PreferencesGroup {
              Adw.ActionRow connect_create { title: _("Create an Identity"); subtitle: _("If you don't have one on this device yet"); activatable: true; [suffix] Image { icon-name: "go-next-symbolic"; } }
              Adw.ActionRow connect_import { title: _("Import an Identity"); activatable: true; [suffix] Image { icon-name: "go-next-symbolic"; } }
            }
          }
        }
        Adw.NavigationPage {
          tag: "test"; title: _("Check Your Identity");
          Adw.PreferencesPage {
            description: _("Approve a one-time signing and encryption check. Nothing is published and no app permissions are saved.");
            Adw.PreferencesGroup { Box pending_requests { orientation: vertical; } }
            Adw.PreferencesGroup {
              Adw.ExpanderRow {
                title: _("Details");
                Adw.ActionRow { title: _("On This Device Only"); subtitle: _("Signs and verifies a test message, then encrypts and decrypts it with a temporary key."); subtitle-lines: 0; }
              }
              Button btn_retry { label: _("_Try Check Again"); use-underline: true; halign: center; }
            }
          }
        }
        Adw.NavigationPage {
          tag: "backup"; title: _("Back Up Identity");
          Adw.PreferencesPage {
            description: _("Write these words down in order and keep them private. Anyone with them controls your identity.");
            Adw.PreferencesGroup { Box seed_words { orientation: vertical; styles ["monospace"] } }
            Adw.PreferencesGroup {
              CheckButton seed_written_down {
                accessibility { label: _("I have safely backed up my identity"); }
                child: Label { label: _("I have safely backed up my identity"); wrap: true; xalign: 0; };
              }
            }
            Adw.PreferencesGroup {
              Adw.ExpanderRow {
                title: _("Other Backup Options");
                Adw.ActionRow {
                  title: _("Copy Recovery Phrase"); subtitle: _("Clipboard managers may keep a copy"); subtitle-lines: 0;
                  [suffix] Button btn_copy_seed { label: _("Cop_y"); use-underline: true; valign: center; accessibility { label: _("Copy Recovery Phrase"); } }
                }
                Adw.ActionRow { title: _("Encrypted Backup"); [suffix] Button btn_backup_export { label: _("_Open Backup…"); use-underline: true; valign: center; } }
                Adw.ActionRow { title: _("Recovery Phrase Unavailable?"); [suffix] Button btn_backup_retry { label: _("_Try Again"); use-underline: true; valign: center; } }
              }
            }
          }
        }
        Adw.NavigationPage {
          tag: "ready"; title: _("Setup Complete");
          Adw.StatusPage {
            icon-name: "emblem-ok-symbolic"; title: _("Your Identity Is Ready");
            child: Label ready_summary { wrap: true; };
          }
        }
      }
      Box {
        orientation: vertical; spacing: 8;
        margin-start: 20; margin-end: 20; margin-bottom: 16;
        Spinner spinner_status {}
        Label lbl_status { wrap: true; xalign: 0; }
      }
    }
  }
}
