using Gtk 4.0;
using Adw 1;
template $OnboardingAssistant: Adw.Window {
  title: _("Set Up Grotto");
  default-width: 560;
  default-height: 600;
  width-request: 320;
  Box {
    orientation: vertical;
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle { title: _("Identity Setup"); };
      [end] Button btn_skip { label: _("Skip Setup"); }
    }
    ScrolledWindow {
      hscrollbar-policy: never;
      vexpand: true;
      Adw.Clamp {
        maximum-size: 480;
        margin-start: 20; margin-end: 20; margin-top: 16; margin-bottom: 16;
        Stack steps {
          transition-type: none;
          StackPage {
            name: "welcome";
            child: Adw.StatusPage {
              icon-name: "org.nostr.Grotto";
              title: _("Your Identity, Your Control");
              description: _("Keys live in your system keyring. Applications never receive your secret key, and each application asks for permission before signing. Grotto's explicit key-management screens may handle your recovery material briefly.");
            };
          }
          StackPage {
            name: "choice";
            child: Box {
              orientation: vertical; spacing: 18;
              Label { label: _("How Would You Like to Start?"); styles ["title-1"] wrap: true; }
              CheckButton radio_create { label: _("Create an Identity"); active: true; }
              CheckButton radio_import { label: _("Import an Identity"); group: radio_create; }
              CheckButton radio_connect { label: _("Connect an Application"); group: radio_create; }
            };
          }
          StackPage {
            name: "create";
            child: Box {
              orientation: vertical; spacing: 18;
              Label { label: _("Create an Identity"); styles ["title-1"] wrap: true; }
              Label { label: _("Grotto generates a BIP-39 recovery phrase and stores it with your key in the system keyring. No extra creation password is used."); wrap: true; xalign: 0; }
              Entry entry_profile_name { placeholder-text: _("Local label (optional)"); }
            };
          }
          StackPage {
            name: "import";
            child: Box {
              orientation: vertical; spacing: 12;
              Label { label: _("Import an Identity"); styles ["title-1"] wrap: true; }
              Label { label: _("Enter nsec, a 64-character private hex key, an encrypted NIP-49 key, or seed words. Input is validated before storage."); wrap: true; xalign: 0; }
              Entry entry_import_label { placeholder-text: _("Local label (optional)"); }
              CheckButton radio_import_seed { label: _("This is a BIP-39 recovery phrase"); }
              Entry text_import_data { visibility: false; enable-undo: false; placeholder-text: _("Private key or recovery phrase"); }
              Label import_passphrase_label { label: _("NIP-49 decryption passphrase (encrypted imports only)"); wrap: true; xalign: 0; }
              Box box_import_passphrase_container { orientation: vertical; }
            };
          }
          StackPage {
            name: "connect";
            child: Adw.StatusPage {
              icon-name: "network-workgroup-symbolic";
              title: _("Connect an Application");
              description: _("Local GNOME applications need no manual registration: their first call asks for consent. Remote applications pair from Connect after you have a signable identity. If you do not have one yet, go Back and create or import it first.");
            };
          }
          StackPage {
            name: "test";
            child: Box {
              orientation: vertical; spacing: 18;
              Label { label: _("Verify Your Stored Identity"); styles ["title-1"] wrap: true; }
              Label { label: _("One review covers signing an unpublished event and verifying it, then NIP-44 encryption and decryption with an ephemeral peer. Nothing goes to relays, and no client permissions are created."); wrap: true; xalign: 0; }
              Button btn_retry { label: _("Retry Self-Test"); }
            };
          }
          StackPage {
            name: "backup";
            child: Box {
              orientation: vertical; spacing: 18;
              Label { label: _("Back Up Your Identity"); styles ["title-1"] wrap: true; }
              Label { label: _("Anyone with these seed words has full control. Write them down privately; never paste them into software you do not trust. Grotto developers will never ask for them."); wrap: true; xalign: 0; }
              Box seed_words { orientation: vertical; styles ["monospace"] }
              Button btn_copy_seed { label: _("Copy Seed Words (clipboard managers may retain them)"); }
              Button btn_backup_retry { label: _("Retry Seed-Word Export"); }
              Button btn_backup_export { label: _("Use Encrypted Backup Instead…"); }
              CheckButton seed_written_down { label: _("I have safely backed up my identity"); }
            };
          }
          StackPage {
            name: "ready";
            child: Adw.StatusPage {
              icon-name: "emblem-ok-symbolic";
              title: _("Ready to Review Signing Requests");
              child: Label ready_summary { wrap: true; };
            };
          }
        }
      }
    }
    Box {
      orientation: vertical; spacing: 8;
      margin-start: 20; margin-end: 20; margin-bottom: 16;
      Spinner spinner_status {}
      Label lbl_status { wrap: true; xalign: 0; }
      Box {
        spacing: 12;
        Button btn_back { label: _("Back"); }
        Button btn_next { label: _("Next"); hexpand: true; styles ["suggested-action"] }
      }
    }
  }
}
