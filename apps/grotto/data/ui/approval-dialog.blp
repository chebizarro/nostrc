using Gtk 4.0;
using Adw 1;

template $GnostrApprovalDialog: Adw.Dialog {
  title: _("Review request");
  content-width: 440;
  width-request: 300;
  follows-content-size: true;
  Adw.ToolbarView {
    [top]
    Adw.HeaderBar { show-title: false; }
    ScrolledWindow {
      hscrollbar-policy: never;
      propagate-natural-height: true;
      Box {
        orientation: vertical;
        spacing: 12;
        margin-start: 20;
        margin-end: 20;
        margin-bottom: 20;
        Image header_icon { icon-name: "dialog-question-symbolic"; pixel-size: 24; }
        Label header_title { label: _("Review request"); wrap: true; styles ["title-3"] }
        Label subtitle_label { wrap: true; xalign: 0; }
        Label label_from { wrap: true; wrap-mode: word_char; xalign: 0; selectable: true; }
        Label label_event_kind { wrap: true; xalign: 0; }
        Label label_identity { wrap: true; wrap-mode: word_char; xalign: 0; selectable: true; styles ["monospace"] }
        Label label_reason { wrap: true; wrap-mode: word_char; xalign: 0; visible: false; }
        Label label_expiry { wrap: true; xalign: 0; styles ["dim-label"] }
        Frame content_frame {
          Label content_preview {
            wrap: true;
            wrap-mode: word_char;
            xalign: 0;
            selectable: true;
            margin-start: 8;
            margin-end: 8;
            margin-top: 8;
            margin-bottom: 8;
          }
        }
        Box stepper {
          homogeneous: true;
          visible: false;
          Button btn_previous { label: _("Previous"); }
          Label label_position { label: _("1 of 1"); }
          Button btn_next { label: _("Next"); }
        }
        Expander batch_expander {
          label: _("Requests in this flow");
          visible: false;
          Box {
            orientation: vertical;
            spacing: 8;
            Box batch_box { orientation: vertical; spacing: 8; }
            Button btn_approve_selected { label: _("Approve selected once"); sensitive: false; }
          }
        }
        Label label_scope { wrap: true; wrap-mode: word_char; xalign: 0; styles ["dim-label"] }
        CheckButton chk_remember { label: _("Remember this decision for this scope"); }
        DropDown ttl_dropdown { sensitive: false; }
        Box {
          homogeneous: true;
          spacing: 8;
          Button btn_deny { label: _("Deny"); tooltip-text: _("Deny once (Ctrl+D, Escape)"); }
          Button btn_approve { label: _("Approve"); receives-default: false; tooltip-text: _("Approve (Ctrl+A)"); styles ["suggested-action"] }
          Button btn_not_now { label: _("Not now"); tooltip-text: _("Keep this request waiting"); }
        }
        Expander details_expander {
          label: _("Details");
          Box {
            orientation: vertical;
            spacing: 8;
            Label label_details { wrap: true; wrap-mode: word_char; xalign: 0; selectable: true; }
            Label label_timestamp { wrap: true; xalign: 0; }
            Label label_trust_explanation { label: _("Changing trust is separate from remembering this decision. Lowering trust keeps explicit permissions."); wrap: true; xalign: 0; }
            DropDown trust_dropdown { }
            Button btn_change_trust { label: _("Change trust level"); sensitive: false; }
          }
        }
      }
    }
  }
}
