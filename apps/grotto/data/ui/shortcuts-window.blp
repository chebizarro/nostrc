using Gtk 4.0;
ShortcutsWindow shortcuts_window {
  modal: true;
  ShortcutsSection {
    section-name: "management";
    title: _("Management");
    ShortcutsGroup {
      title: _("Grotto");
      ShortcutsShortcut { title: _("New Identity…"); accelerator: "<Control>n"; }
      ShortcutsShortcut { title: _("Import Identity…"); accelerator: "<Control>i"; }
      ShortcutsShortcut { title: _("Back Up Identity…"); accelerator: "<Control>e"; }
      ShortcutsShortcut { title: _("Lock Management"); accelerator: "<Control>l"; }
      ShortcutsShortcut { title: _("Preferences"); accelerator: "<Control>comma"; }
      ShortcutsShortcut { title: _("Close Window"); accelerator: "<Control>w"; }
      ShortcutsShortcut { title: _("Quit Approval UI (authorised signing continues)"); accelerator: "<Control>q"; }
      ShortcutsShortcut { title: _("Keyboard Shortcuts"); accelerator: "<Control>question"; }
    }
  }
}
