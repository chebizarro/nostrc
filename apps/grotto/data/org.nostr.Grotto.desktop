[Desktop Entry]
Type=Application
Name=Grotto (Preview)
GenericName=Nostr Signer
Comment=Manage Nostr identities and review signing requests (NIP-55L, NIP-46)
Exec=grotto %U
Icon=org.nostr.Grotto
Terminal=false
DBusActivatable=true
Categories=Utility;Security;Network;
Keywords=nostr;signer;keys;identity;crypto;signing;
StartupNotify=true
X-GNOME-UsesNotifications=true

# Pairing and local activation only. Never claim the dispatcher's nostr: scheme.
MimeType=x-scheme-handler/bunker;x-scheme-handler/nostrconnect;x-scheme-handler/grotto;

# The signer is not an event viewer: it declares no kinds, so the
# dispatcher never routes nostr: links here.
X-Nostr-Kinds=

# Desktop actions
Actions=new-identity;settings;

[Desktop Action new-identity]
Name=New Identity
Exec=grotto --new-identity

[Desktop Action settings]
Name=Settings
Exec=grotto --settings
