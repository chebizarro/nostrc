msgstr ""
"Grotto no pudo contactar con el firmante. Reintenta cuando esté en ejecución."

#: src/ui/onboarding-assistant.c:309
msgid "An identity could not be created. Try again."
msgstr "No se pudo crear una identidad. Reintenta."

