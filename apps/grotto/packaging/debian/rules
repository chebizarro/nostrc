#!/usr/bin/make -f
# One native Grotto package, GUI and daemon. Never install a testing build.
include /usr/share/dpkg/architecture.mk
export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_APPS=ON -DBUILD_GNOSTR_APP=OFF -DBUILD_GROUNDHOG=OFF \
		-DBUILD_TESTING=OFF -DBUILD_TESTING_FRAMEWORK=OFF \
		-DBUILD_SIGNER_TESTS=OFF -DBUILD_NATIVE_HOST=ON \
		-DGROTTO_WITH_PKCS11=OFF -DGROTTO_WITH_HW_WALLET=OFF \
		-DBUILD_RELAYD=OFF -DSIGNET_ENABLE=OFF -DBUILD_LIBHANAMI=OFF

override_dh_auto_build:
	dh_auto_build -- apps/grotto/all

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/tmp cmake --install obj-$(DEB_HOST_GNU_TYPE)/apps/grotto
	! grep -q '@' debian/tmp/usr/share/dbus-1/services/org.nostr.Signer.service
	! grep -q '@' debian/tmp/usr/share/dbus-1/services/org.nostr.Grotto.service

override_dh_installsystemduser:
	dh_installsystemduser --no-enable

# The full private-bus suites run in grotto-ci, not as root during packaging.
override_dh_auto_test:
