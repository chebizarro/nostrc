# nostr-session-relayd config — copy to
#   $XDG_CONFIG_HOME/nostr/session-relay.conf
# (or $HOME/.config/nostr/session-relay.conf if XDG_CONFIG_HOME is unset).
# All values shown are defaults; the file is optional.

# Storage driver — nostrdb is the only implementation shipped in-tree; the
# store lives under ~/.local/share/nostr/session-relay/. "none" runs
# cache-less on purpose: REQ answers EOSE at once, EVENT is refused, and
# org.nostr.SessionRelay1.StorageBackend reports "none".
storage_driver = "nostrdb"

# NIP-42 authentication policy. The Unix socket itself is the auth boundary,
# so we default to `off`. Set to `optional` or `required` only if you share
# the machine with other users you do not trust (in which case you also
# want stricter DBus policy — see §3.2 D3 caveat).
auth = "off"

# Protocol limits. Match the system relayd defaults; the session relay is
# lightly loaded so these are typically fine to leave alone.
max_filters              = 10
max_limit                = 500
# REQs streaming at once per connection (clamped to 16); see relay.toml.example.
max_subs                 = 8
max_event_bytes          = 262144

rate_ops_per_sec         = 20
rate_burst               = 40
rate_event_cost          = 5

replay_cache_capacity    = 65536
replay_ttl_seconds       = 900
future_skew_seconds      = 600
past_skew_seconds        = 0

# Signature verification budget — the session relay verifies inbound events
# just like the system daemon; keep these conservative to bound CPU during
# federation catch-up.
verification_cost                    = 5
verification_conn_per_sec            = 40
verification_conn_burst              = 80
verification_ip_per_sec              = 200
verification_ip_burst                = 400
verification_global_per_sec          = 2000
verification_global_burst            = 4000
verification_max_ips                 = 4096
verification_max_jobs                = 64
verification_max_bytes               = 16777216
verification_negative_cache_entries  = 4096
verification_negative_ttl_seconds    = 30

# NIP-11 identity — advertised to any local client that requests it.
name        = "session-relay"
software    = "nostrc"
version     = "0.1"
description = "Per-user session-scoped local relay"
contact     = ""

# Retention: NOT enforced yet. The store grows until you delete
# ~/.local/share/nostr/session-relay/. The retention_* keys that GNOME
# Settings writes here (retention_enabled, retention_cache_max_mb, ...;
# docs/designs/nostrdb-retention-eviction-policy.md §7.1) are accepted and
# ignored, and org.nostr.SessionRelay1.RetentionSupported reports false,
# because nostrdb has no delete primitive to evict with (nostrc-8rxk
# Phase 1; nostrc-prqu.17).
negentropy_enabled = 0

# ── Upstream federation (apps/relayd/README.md "Upstream federation") ──────
# Events local apps write to relay.sock are queued in a durable outbox
# (outbox.sqlite3 next to the store) and forwarded to YOUR relays only: the
# author's kind-10002 write relays, a gift wrap recipient's kind-10050 inbox
# relays, a NIP-29 group's relay. Never forwarded: events tagged ["-"]
# (NIP-70), kinds 13/14/22242/20000-29999, the kinds below, and events by
# anyone but your local account(s). Status: `nostr-session-relayd --upstream`.
federation = 1

# Local account(s), comma-separated npub or hex. Empty: ask org.nostr.Signer
# (GetPublicKey) the first time an event by an unknown author is queued.
federation_accounts = ""

# Kinds that stay on this machine, e.g. "30078, 31000-31999".
federation_local_only_kinds = ""

# ws:// (no TLS) is only used for loopback hosts unless this is 1.
federation_allow_plaintext_ws = 0

federation_backoff_initial_seconds  = 15
federation_backoff_max_seconds      = 3600
federation_ok_timeout_seconds       = 30
federation_max_age_seconds          = 604800
federation_keep_settled_seconds     = 604800
federation_max_relays_per_event     = 16
federation_max_inflight_per_relay   = 32
federation_idle_disconnect_seconds  = 60
