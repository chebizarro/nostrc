[Desktop Entry]
Type=Application
Name=GNostr
GenericName=Nostr Client
Comment=GTK4 Nostr client for the decentralized social protocol
Exec=gnostr %U
Icon=org.gnostr.gnostr
Terminal=false
Categories=Network;Chat;InstantMessaging;GTK;
Keywords=nostr;social;decentralized;relay;notes;
StartupWMClass=gnostr
# nostr: / web+nostr: are owned by nostr-dispatcher (org.nostr.Dispatcher),
# which resolves the event kind and routes to the registered handler
# (nostrc-2thp / nostrc-1v65). GNostr declares the kinds it renders instead
# of claiming the scheme, so exactly one .desktop file owns nostr:.
# The numbers are the kinds GNostr opens in a dedicated view (profile 0;
# thread 1, 6, 16, 1111; DM inbox 14, 1059; article reader 30023); they
# must match src/util/gnostr-nostr-target.c (tests/test_nostr_target.c).
# `*` marks GNostr as a generic viewer: the dispatcher's fallback for kinds
# no installed app declares and for links whose kind cannot be resolved;
# those open as a single event in the thread view.
# While GNostr runs it also owns the bus name org.gnostr.gnostr (this
# desktop id) and implements org.nostr.Handler1 at /org/gnostr/gnostr, so
# the dispatcher can hand it an event directly. Its GApplication id stays
# org.gnostr.Client.
# See gnome/nostr-dispatcher/README.md for the X-Nostr-Kinds format.
X-Nostr-Kinds=0;1;6;14;16;1059;1111;30023;*;
X-GNOME-UsesNotifications=true
# Search entry point (nostrc-prqu.15): `gnostr --search TERMS` opens GNostr
# (or the running instance) searching for TERMS, and the running app also
# exposes it as the GAction app.search(s). X-Nostr-Search-Arg names the
# option so a search provider can launch the `*` handler with the terms
# (see gnome/nostr-search-provider/README.md).
X-Nostr-Search-Arg=--search
Actions=search;

[Desktop Action search]
Name=Search Nostr
Exec=gnostr --search ""
