[Unit]
Description=GNostr Signer Daemon - Secure Nostr Key Management Service
Documentation=https://github.com/chebizarro/nostrc
After=default.target dbus.service
Wants=dbus.service
# A daemon that loses org.nostr.Signer to another owner exits nonzero
# (NAME_TAKEN); cap restarts so a stale second package cannot flap-loop.
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=dbus
BusName=org.nostr.Signer
ExecStart=/usr/bin/gnostr-signer-daemon
# NIP-46 bunker mode: see gnostr-signer-daemon.service.d/bunker.conf.example
ExecReload=/bin/kill -HUP $MAINPID

# Set endpoint with unix socket by default under XDG_RUNTIME_DIR
Environment=NOSTR_SIGNER_ENDPOINT=unix:%t/gnostr/signer.sock
Environment=G_MESSAGES_DEBUG=

# Restart policy
Restart=on-failure
RestartSec=5s

# Resource limits
LimitNOFILE=4096
LimitCORE=0
# No LimitNPROC=: RLIMIT_NPROC counts every process and thread of the uid,
# not of this service, so on a busy session GLib could not start its worker
# threads and aborted (nostrc-8sya). TasksMax= bounds this unit's cgroup.
TasksMax=32

# Security hardening (user service)
# Basic hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only

# Kernel protection
ProtectKernelTunables=yes
ProtectControlGroups=yes

# nostrc-8sya: not usable in a systemd --user unit. The user manager holds no
# capabilities, so each of these fails the start with status=218/CAPABILITIES
# (verified with systemd-run --user on systemd 255): PrivateDevices=,
# ProtectKernelModules=, ProtectKernelLogs=, ProtectClock= and an empty
# CapabilityBoundingSet=. An empty AmbientCapabilities= is accepted (and is
# the user manager's default anyway).

# Memory protection
MemoryDenyWriteExecute=yes
LockPersonality=yes

# Namespace restrictions
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes

# Capability restrictions
AmbientCapabilities=

# System call filtering
SystemCallArchitectures=native
SystemCallFilter=@system-service @basic-io @network-io @signal @ipc
SystemCallFilter=~@privileged @resources @obsolete @debug @mount @swap @reboot @module @raw-io

# File system restrictions
ReadWritePaths=%t/gnostr %h/.config/gnostr %h/.local/share/gnostr
ProtectProc=invisible
ProcSubset=pid

# Network restrictions (allow only local IPC)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any

# Misc hardening
UMask=0077
ProtectHostname=yes

[Install]
WantedBy=default.target
