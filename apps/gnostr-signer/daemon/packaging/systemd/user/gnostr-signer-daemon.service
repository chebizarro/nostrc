[Unit]
Description=GNostr Signer Daemon - Secure Nostr Key Management Service
Documentation=https://github.com/chebizarro/nostrc
After=default.target dbus.service
Wants=dbus.service
# A daemon that loses org.nostr.Signer to another owner exits nonzero
# (NAME_TAKEN); cap restarts so a stale second package cannot flap-loop.
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=dbus
BusName=org.nostr.Signer
ExecStart=/usr/bin/gnostr-signer-daemon
# NIP-46 bunker mode: see gnostr-signer-daemon.service.d/bunker.conf.example
ExecReload=/bin/kill -HUP $MAINPID

# Set endpoint with unix socket by default under XDG_RUNTIME_DIR
Environment=NOSTR_SIGNER_ENDPOINT=unix:%t/gnostr/signer.sock
Environment=G_MESSAGES_DEBUG=

# Restart policy
Restart=on-failure
RestartSec=5s

# Resource limits
LimitNOFILE=4096
LimitCORE=0
# No LimitNPROC=: RLIMIT_NPROC counts every process and thread of the uid,
# not of this service, so on a busy session GLib could not start its worker
# threads and aborted (nostrc-8sya). TasksMax= bounds this unit's cgroup.
TasksMax=32

# Security hardening (user service)
#
# nip55l 0.4.0 identifies each D-Bus caller from /proc/<pid>/{exe,cgroup,
# root/.flatpak-info} (nostrc-phk4). Every mount-namespacing option puts a
# systemd --user unit into a user namespace, where readlink(/proc/<pid>/exe)
# and /proc/<pid>/root of other processes fail with EACCES; every caller
# would then be unidentified and no approval could ever be answered.
# Verified on systemd 255 with systemd-run --user: PrivateTmp=,
# ProtectSystem=, ProtectHome=, ProtectKernelTunables=,
# ProtectControlGroups=, ProtectHostname= and ReadWritePaths= all hide the
# callers; ProtectProc=invisible, ProcSubset=pid, RestrictNamespaces=,
# MemoryDenyWriteExecute= and the SystemCallFilter lines do not. The
# directives that fail a user unit outright (218/CAPABILITIES) are covered
# in nostrc-8sya: PrivateDevices=, ProtectKernelModules=,
# ProtectKernelLogs=, ProtectClock=, CapabilityBoundingSet=.
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
AmbientCapabilities=
ProtectProc=invisible
ProcSubset=pid

# System call filtering
SystemCallArchitectures=native
SystemCallFilter=@system-service @basic-io @network-io @signal @ipc
SystemCallFilter=~@privileged @resources @obsolete @debug @mount @swap @reboot @module @raw-io

# Network restrictions (allow only local IPC)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any

UMask=0077

[Install]
WantedBy=default.target
