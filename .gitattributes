# Beads exports are generated from the dolt DB; union-merge to avoid spurious
# conflicts on the JSONL cache (bd re-exports authoritative content after merge).
.beads/issues.jsonl merge=union
.beads/interactions.jsonl merge=union

# Unified-diff context includes literal blank lines and space prefixes.
third_party/patches/nostrdb/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
