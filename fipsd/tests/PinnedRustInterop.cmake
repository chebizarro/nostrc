# Optional local oracle discovery. Never build/download here or fall back to an
# older pin. Explicit -D values (including empty) and then env override the cache.
set(_fipsd_pin_file "${CMAKE_CURRENT_LIST_DIR}/../../libfips-core/UPSTREAM.md")
# libfips-core/tests/diff already registers the owning pin as a configure input.
file(STRINGS "${_fipsd_pin_file}" _fipsd_pin_line REGEX "^Pinned commit: `[0-9a-f]+`$")
string(REGEX REPLACE "^Pinned commit: `([0-9a-f]+)`$" "\\1" _fipsd_pin "${_fipsd_pin_line}")
string(LENGTH "${_fipsd_pin}" _fipsd_pin_length)
if(NOT _fipsd_pin_length EQUAL 40)
  message(FATAL_ERROR "Pinned Rust discovery requires one full Pinned commit in UPSTREAM.md")
endif()
string(SUBSTRING "${_fipsd_pin}" 0 10 _fipsd_pin_short)
if(NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
  set(_fipsd_cache_base "$ENV{XDG_CACHE_HOME}")
elseif(NOT "$ENV{HOME}" STREQUAL "")
  set(_fipsd_cache_base "$ENV{HOME}/.cache")
else()
  set(_fipsd_cache_base "")
endif()
set(_fipsd_rust_dir "${_fipsd_cache_base}/nostrc/fips/${_fipsd_pin}/${CMAKE_HOST_SYSTEM_NAME}-${CMAKE_HOST_SYSTEM_PROCESSOR}/release")

function(fipsd_pinned_rust_binary option filename description auto_discover)
  if(DEFINED ${option})
    # Preserve normal variables and existing cache values as well as -D.
    set(${option} "${${option}}" CACHE FILEPATH "${description}")
    return()
  endif()
  if(DEFINED ENV{${option}})
    set(_value "$ENV{${option}}")
  else()
    set(_value "")
    set(_candidate "${_fipsd_rust_dir}/${filename}")
    if(auto_discover AND NOT _fipsd_cache_base STREQUAL "" AND EXISTS "${_candidate}")
      if(NOT filename STREQUAL "examples/native-echo")
        execute_process(COMMAND "${_candidate}" --version RESULT_VARIABLE _rc
          OUTPUT_VARIABLE _version ERROR_VARIABLE _error TIMEOUT 5)
        string(FIND "${_version}" "(rev ${_fipsd_pin_short})" _match)
        if(NOT "${_rc}" STREQUAL "0" OR _match EQUAL -1)
          message(FATAL_ERROR "Cached Rust oracle is not the clean UPSTREAM.md pin: ${_candidate}\n${_version}${_error}")
        endif()
      endif()
      set(_value "${_candidate}")
      message(STATUS "${option}: ${_value} (pinned user cache)")
    endif()
  endif()
  set(${option} "${_value}" CACHE FILEPATH "${description}")
endfunction()

fipsd_pinned_rust_binary(FIPSD_UDP_INTEROP_RUST_BINARY fips "Pinned Rust fips daemon for UDP/multi-node interop" TRUE)
fipsd_pinned_rust_binary(FIPSD_TCP_INTEROP_RUST_BINARY fips "Pinned Rust fips daemon for TCP interop" TRUE)
# Preserve the legacy explicitly selected source-build route for fipsctl.
if(FIPSD_UPSTREAM_CONTROL_DIR)
  set(_fipsd_fipsctl_auto FALSE)
else()
  set(_fipsd_fipsctl_auto TRUE)
endif()
fipsd_pinned_rust_binary(FIPSD_FIPSCTL_EXECUTABLE fipsctl "Pinned Rust fipsctl for control interop" "${_fipsd_fipsctl_auto}")
# The example's stale platform gate excludes macOS, not the native API itself.
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  set(_fipsd_echo_auto TRUE)
else()
  set(_fipsd_echo_auto FALSE)
endif()
fipsd_pinned_rust_binary(FIPSD_UDP_INTEROP_RUST_ECHO examples/native-echo "Optional pinned Rust native echo client" "${_fipsd_echo_auto}")
