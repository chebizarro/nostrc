# fips-ble-agent as built (nostrc-gfi8h.6.3): the embedded Info.plist that
# CoreBluetooth requires of a command-line binary, and the CLI contract.
# Never touches Bluetooth: --version and --help exit before CoreBluetooth.
if(NOT AGENT OR NOT EXISTS "${AGENT}")
  message(FATAL_ERROR "AGENT=${AGENT} is missing")
endif()
execute_process(COMMAND launchctl plist __TEXT,__info_plist "${AGENT}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE plist ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "launchctl plist __TEXT,__info_plist failed (${rc}): ${err}")
endif()
foreach(want "NSBluetoothAlwaysUsageDescription" "com.fips.ble-agent" "${EXPECTED_VERSION}")
  string(FIND "${plist}" "${want}" at)
  if(at LESS 0)
    message(FATAL_ERROR "__TEXT,__info_plist lacks ${want}:\n${plist}")
  endif()
endforeach()
execute_process(COMMAND "${AGENT}" --version RESULT_VARIABLE rc OUTPUT_VARIABLE out)
if(NOT rc EQUAL 0 OR NOT out MATCHES "^fips-ble-agent ${EXPECTED_VERSION}")
  message(FATAL_ERROR "--version: exit ${rc}, output '${out}'")
endif()
execute_process(COMMAND "${AGENT}" --help RESULT_VARIABLE rc OUTPUT_VARIABLE out)
if(NOT rc EQUAL 0 OR NOT out MATCHES "--socket" OR NOT out MATCHES "--daemon-uid")
  message(FATAL_ERROR "--help: exit ${rc}, output '${out}'")
endif()
execute_process(COMMAND "${AGENT}" --no-such-flag RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(NOT rc EQUAL 2)
  message(FATAL_ERROR "an unknown flag exits ${rc}, expected 2")
endif()
