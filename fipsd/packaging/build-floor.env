# The oldest systems the fipsd packages are built for, and so the C library
# floor the binaries carry. Sourced by check-glibc-floor.sh and the container
# builders; one place to change when the floor moves.
#
# Unlike upstream fips, which builds one Linux binary in a pinned image and
# ships it everywhere, nostrc builds a .deb per distribution release (the
# Groundhog release does the same): the Debian build image below is the one
# the fips-packaging workflow builds and install-tests on, and a package from
# it is for that release. The glibc floor is that image's glibc.
FIPSD_DEB_BUILD_IMAGE=ubuntu:24.04
FIPSD_GLIBC_FLOOR=2.39
FIPSD_RPM_BUILD_IMAGE=registry.fedoraproject.org/fedora:42
