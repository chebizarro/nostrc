# Generated from fipsd/packaging/systemd/fipsd.service.in by CMake; the
# binary and config paths follow the install prefix.
[Unit]
Description=FIPS Mesh Network Daemon (fipsd)
Documentation=file://@CMAKE_INSTALL_FULL_DATADIR@/fips/fips.yaml.example
After=network-online.target
Wants=network-online.target

# The config is not a packaged conffile; the package's install scripts seed it
# from the example if absent. Skip the unit (inactive, not failed) rather than
# crash-loop if it is ever missing.
ConditionPathExists=@CMAKE_INSTALL_FULL_SYSCONFDIR@/fips/fips.yaml

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/fipsd --config @CMAKE_INSTALL_FULL_SYSCONFDIR@/fips/fips.yaml
# SIGHUP reloads the logging keys from the config (fipsd/README.md).
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# Back off between automatic restarts: 5s, 7s, 10s, 15s, 21s, then 30s.
# systemd before v254 ignores these two keys and keeps the fixed 5s delay.
RestartSteps=5
RestartMaxDelaySec=30

# Control socket directory (/run/fips/, 0750). The daemon sets it and the
# sockets it creates there to the `fips` group, so group members can use
# fipsctl and the native API without root (fipsd/src/privilege.c).
RuntimeDirectory=fips
RuntimeDirectoryMode=0750

# Log directory (/var/log/fips/) for a `node.log_file` under it; stderr goes
# to the journal when none is configured.
LogsDirectory=fips

# Hardening. The daemon runs as root for the TUN device and raw sockets; an
# unprivileged User=/Group= needs CAP_NET_ADMIN (see fipsd/README.md).
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=no

[Install]
WantedBy=multi-user.target
