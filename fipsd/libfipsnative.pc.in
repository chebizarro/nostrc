prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: libfipsnative
Description: C client for the fipsd native datagram API (plain POSIX; no libgo, no libfips-core)
Version: @fipsnative_VERSION@
Libs: -L${libdir} -lfipsnative
Cflags: -I${includedir}
