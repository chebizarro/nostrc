# Generates fipsd_build_info.h at build time (not configure time) so the git
# revision in `fipsd -V` follows the checked-out commit without a reconfigure.
# The file is rewritten only when its content changes, so dependents do not
# recompile on every build.
#
#   cmake -DSOURCE_DIR=<fipsd dir> -DOUTPUT=<header> -DTARGET_TRIPLE=<triple>
#         -P BuildInfo.cmake
#
# FIPSD_GIT_REV is the 10-character abbreviated HEAD hash, suffixed `-dirty`
# when tracked files under SOURCE_DIR differ from HEAD. It is empty when no
# git executable or repository is available (a tarball build), in which case
# the CLI omits the `(rev ...)` part as upstream documents.

set(rev "")
find_package(Git QUIET)
if(GIT_EXECUTABLE AND IS_DIRECTORY "${SOURCE_DIR}")
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --short=10 HEAD
    RESULT_VARIABLE rc OUTPUT_VARIABLE rev
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(NOT rc EQUAL 0)
    set(rev "")
  else()
    execute_process(
      COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" diff --quiet HEAD -- .
      RESULT_VARIABLE dirty_rc OUTPUT_QUIET ERROR_QUIET)
    if(dirty_rc EQUAL 1)
      set(rev "${rev}-dirty")
    endif()
  endif()
endif()

set(content "/* Generated by fipsd/cmake/BuildInfo.cmake; do not edit. */
#ifndef FIPSD_BUILD_INFO_H
#define FIPSD_BUILD_INFO_H
#define FIPSD_GIT_REV \"${rev}\"
#define FIPSD_TARGET_TRIPLE \"${TARGET_TRIPLE}\"
#endif
")

set(existing "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" existing)
endif()
if(NOT existing STREQUAL content)
  get_filename_component(dir "${OUTPUT}" DIRECTORY)
  file(MAKE_DIRECTORY "${dir}")
  file(WRITE "${OUTPUT}" "${content}")
endif()
