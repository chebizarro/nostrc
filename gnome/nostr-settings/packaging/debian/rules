#!/usr/bin/make -f
# Settings is a desktop app, not the headless root Debian bundle.
include /usr/share/dpkg/architecture.mk
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib/$(DEB_HOST_MULTIARCH) \
		-DBUILD_SHARED_LIBS=OFF -DNOSTR_WITH_GLIB=ON \
		-DENABLE_NOSTR_SETTINGS=ON -DGROTTO_USE_SYSTEM_PANELS=ON \
		-DENABLE_NOSTR_SHARE=OFF -DBUILD_LIBHANAMI=OFF \
		-DBUILD_NOSTR_GOBJECT=OFF -DBUILD_NOSTR_GTK=OFF \
		-DBUILD_LIBMARMOT=OFF -DBUILD_MARMOT_GOBJECT=OFF \
		-DBUILD_APPS=OFF -DBUILD_GROUNDHOG=OFF -DBUILD_RELAYD=OFF \
		-DSIGNET_ENABLE=OFF -DBUILD_TESTING=OFF -DBUILD_TESTING_FRAMEWORK=OFF

override_dh_auto_build:
	dh_auto_build -- nostr-settings nostr-settings-schema

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/nostr-settings cmake --install obj-$(DEB_HOST_GNU_TYPE)/gnome/nostr-settings
	! grep -rq '@[A-Z_]*@' debian/nostr-settings/usr/share/dbus-1 debian/nostr-settings/usr/share/applications

# libnostr-json is private to Settings; no public shlibs or duplicate dbgsym.
override_dh_makeshlibs:
	dh_makeshlibs -Xlibnostr-json
override_dh_strip:
	dh_strip --no-automatic-dbgsym
override_dh_auto_test:
