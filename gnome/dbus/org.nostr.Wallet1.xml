<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.nostr.Wallet1 - desktop Nostr Wallet Connect (NIP-47) agent.

  Owned by nostr-wallet-agent (gnome/nostr-wallet-agent, bead nostrc-yka8)
  on the session bus at object path /org/nostr/Wallet1.

  Applications never see the NWC pairing secret. They call this interface;
  the agent identifies the caller from its D-Bus connection credentials
  (never from a caller-supplied string), applies a per-application daily
  budget, and asks the user through a libadwaita approval dialog whenever a
  request is outside that budget.

  Amounts are millisatoshis (msat) throughout. Methods that take a "u"
  amount are limited to 4294967295 msat (~4.29 M sats) per call.

  Errors (org.nostr.Wallet1.Error.*):
    InvalidArgs     malformed invoice / URI / parameters
    NotPaired       no wallet is paired
    Denied          the user or policy refused the request
    BudgetExceeded  over the caller's daily budget and no UI to ask
    Timeout         the wallet did not answer in time (outcome unknown)
    WalletError     the wallet answered with a NIP-47 error; the message
                    starts with the NIP-47 code, e.g. "[INSUFFICIENT_BALANCE] ..."
    RelayError      no relay accepted the request event
    Unsupported     request not supported (e.g. on-chain, LNURL)
    RateLimited     too many outstanding approval prompts for this caller
    InteractionRequired  a *NonInteractive call would need the user's approval
                    (no read grant for the caller); nothing was shown
    Keyring         the Secret Service refused to store/read the pairing
    Failed          anything else
-->
<node>
  <interface name="org.nostr.Wallet1">

    <!--
      GetInfo:
      @info: always contains "paired" (b). When paired also "wallet_pubkey",
        "client_pubkey", "lud16", "relays" (as), "encryption" ("nip44_v2" or
        "nip04"), "methods" (as, from the wallet's kind-13194 info event) and,
        when the wallet answers get_info, its "alias", "color", "pubkey",
        "network", "block_height", "block_hash".
    -->
    <method name="GetInfo">
      <arg name="info" type="a{sv}" direction="out"/>
    </method>

    <!-- GetBalance: @balance_msat: spendable wallet balance. -->
    <method name="GetBalance">
      <arg name="balance_msat" type="t" direction="out"/>
    </method>

    <!--
      Non-interactive reads, for panels and status indicators that must
      never cause a dialog (GNOME Shell extension, Settings): same results
      as GetInfo / GetBalance, but where the plain method would ask the user
      (the caller has no read grant, or is unidentified) they fail with
      InteractionRequired instead, and nothing is shown. The caller's grant
      is looked up exactly as for the plain method, so a client never has to
      reimplement the agent's caller identification. Unpaired, both behave
      like the plain method (GetInfo: {paired: false}; GetBalance: NotPaired).
    -->
    <method name="GetInfoNonInteractive">
      <arg name="info" type="a{sv}" direction="out"/>
    </method>
    <method name="GetBalanceNonInteractive">
      <arg name="balance_msat" type="t" direction="out"/>
    </method>

    <!--
      MakeInvoice:
      @amount_msat: invoice amount (> 0)
      @description: free-text description ("" for none)
      @expiry: seconds until expiry (0 = wallet default)
    -->
    <method name="MakeInvoice">
      <arg name="amount_msat" type="u" direction="in"/>
      <arg name="description" type="s" direction="in"/>
      <arg name="expiry" type="u" direction="in"/>
      <arg name="bolt11" type="s" direction="out"/>
      <arg name="payment_hash" type="s" direction="out"/>
    </method>

    <!--
      PayInvoice:
      @bolt11: BOLT-11 invoice
      @amount_msat_or_0: amount for an amount-less invoice; must be 0 or
        equal to the encoded amount otherwise
      @preimage: payment preimage (hex)
      @fees_paid_msat: routing fees reported by the wallet (0 if unknown)

      Auto-approved only when the caller is identified and the amount fits
      its remaining daily budget; otherwise the user is asked.
    -->
    <method name="PayInvoice">
      <arg name="bolt11" type="s" direction="in"/>
      <arg name="amount_msat_or_0" type="u" direction="in"/>
      <arg name="preimage" type="s" direction="out"/>
      <arg name="fees_paid_msat" type="t" direction="out"/>
    </method>

    <!--
      Web-origin variants (browser bridge, WebLN): same arguments, results
      and errors as GetInfo / GetBalance / MakeInvoice / PayInvoice, with the
      page's @origin ("https://host[:port]", or http:// on a loopback host,
      in the browser's serialized form) as first argument.

      Only the trusted browser bridge may call these: an unsandboxed caller
      whose /proc/<pid>/exe is <libexecdir>/nostr-signer-webext-host (path
      and inode). Anyone else gets Denied; a malformed origin InvalidArgs.
      The origin then replaces the bridge (whose identity is the browser's)
      as the principal: policy, "Always allow this site", the daily budget,
      the spend ledger and the approval dialog are all per origin, and the
      dialog names the site. Origins are never "trusted" and never attested.
    -->
    <method name="GetInfoFor">
      <arg name="origin" type="s" direction="in"/>
      <arg name="info" type="a{sv}" direction="out"/>
    </method>
    <method name="GetBalanceFor">
      <arg name="origin" type="s" direction="in"/>
      <arg name="balance_msat" type="t" direction="out"/>
    </method>
    <method name="MakeInvoiceFor">
      <arg name="origin" type="s" direction="in"/>
      <arg name="amount_msat" type="u" direction="in"/>
      <arg name="description" type="s" direction="in"/>
      <arg name="expiry" type="u" direction="in"/>
      <arg name="bolt11" type="s" direction="out"/>
      <arg name="payment_hash" type="s" direction="out"/>
    </method>
    <method name="PayInvoiceFor">
      <arg name="origin" type="s" direction="in"/>
      <arg name="bolt11" type="s" direction="in"/>
      <arg name="amount_msat_or_0" type="u" direction="in"/>
      <arg name="preimage" type="s" direction="out"/>
      <arg name="fees_paid_msat" type="t" direction="out"/>
    </method>

    <!--
      LookupInvoice:
      @payment_hash_or_bolt11: a 64-hex payment hash or a BOLT-11 invoice
      @transaction: NIP-47 transaction object (type, state, invoice,
        description, payment_hash, amount, fees_paid, created_at,
        expires_at, settled_at ...). JSON integers map to x, strings to s,
        booleans to b; nested objects (metadata) are JSON-encoded strings.
        The preimage is never returned.
    -->
    <method name="LookupInvoice">
      <arg name="payment_hash_or_bolt11" type="s" direction="in"/>
      <arg name="transaction" type="a{sv}" direction="out"/>
    </method>

    <!--
      ListTransactions:
      @from, @until: unix-time bounds (0 = unbounded)
      @limit: maximum number of results (0 = wallet default)
      @type: "incoming", "outgoing" or "" for both
    -->
    <method name="ListTransactions">
      <arg name="from" type="t" direction="in"/>
      <arg name="until" type="t" direction="in"/>
      <arg name="limit" type="u" direction="in"/>
      <arg name="type" type="s" direction="in"/>
      <arg name="transactions" type="aa{sv}" direction="out"/>
    </method>

    <!--
      Pair: store @nwc_uri (nostr+walletconnect://<wallet-pubkey>?relay=...&secret=...[&lud16=...])
      in the keyring and connect to the wallet. Always confirmed by the
      user. Note that whoever supplies the URI also knows its secret.
    -->
    <method name="Pair">
      <arg name="nwc_uri" type="s" direction="in"/>
    </method>

    <!--
      BeginWalletAuth: connect a wallet by request, with a connection key the
      agent creates (so, unlike Pair(uri), nobody else ever holds its
      secret). Returns at once with @uri, a nostr+walletauth:// link
      (nostr+walletauth://<client-key>?relay=…&name=…&request_methods=…
      &notification_types=…&pubkey=<client-key>&state=<random>) for the
      caller to open in the user's wallet app (or show / copy). No secret
      is in it.
      @options: "relays" (as, 1-5 ws(s):// URLs; default: the
        wallet-auth-relays setting), "name" (s, shown by the wallet;
        default "Nostr Wallet (<host>)").
      When a wallet answers (its kind-13194 info event p-tagged to the key,
      echoing `state` where the wallet supports it), the agent checks the
      new connection with a get_info request and then ALWAYS asks the user
      to confirm, showing the wallet's name and key; only then is it stored
      and made the active pairing. Two different wallets answering one
      request fail it (and new requests are refused for a minute). The
      outcome is reported by WalletAuthFinished.
      One request at a time: a new one from the same application (same app
      id, as the agent identifies callers — see the security notes on
      unverified ids) or the settings app replaces a pending one; other
      callers get RateLimited.
      Needs a display (Denied headless).
    -->
    <method name="BeginWalletAuth">
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="uri" type="s" direction="out"/>
    </method>

    <!-- CancelWalletAuth: abandon the pending request (its application or
         the settings app only; a no-op when none is pending). -->
    <method name="CancelWalletAuth"/>

    <!-- Unpair: forget the pairing (keyring item deleted). User-confirmed. -->
    <method name="Unpair"/>

    <!--
      OpenUri: scheme-handler entry point (the .desktop file's
      `nostr-wallet-agent --open %u` forwards here). @uri is a lightning:,
      bitcoin: (BIP-21) or nostr+walletconnect: link. Returns as soon as the
      link is parsed; the payment/pairing is then always confirmed in a
      dialog that names the calling application as the link's opener, and
      the outcome is shown to the user rather than returned.
    -->
    <method name="OpenUri">
      <arg name="uri" type="s" direction="in"/>
    </method>

    <!--
      GetBudget:
      @app_id: application id, or "" for the caller's own
      @msat_per_day: daily limit (0 = no automatic payments)
      @spent_today_msat: spent (including in-flight) since local midnight
      Other applications' budgets are only visible to trusted settings apps.
    -->
    <method name="GetBudget">
      <arg name="app_id" type="s" direction="in"/>
      <arg name="msat_per_day" type="u" direction="out"/>
      <arg name="spent_today_msat" type="t" direction="out"/>
    </method>

    <!--
      SetBudget:
      @app_id: application id, or "" for the caller's own
      @msat_per_day: new daily limit. Lowering one's own budget is always
        allowed; anything else needs user confirmation (or a sandboxed,
        trusted settings app). A budget never grants read access.
    -->
    <method name="SetBudget">
      <arg name="app_id" type="s" direction="in"/>
      <arg name="msat_per_day" type="u" direction="in"/>
    </method>

    <!--
      "Grant admin" below means the settings app: the installed Nostr
      Settings (an unsandboxed caller whose executable is
      <bindir>/nostr-settings, checked by path and inode — the same rule as
      the browser bridge), or a Flatpak-verified id listed in the
      trusted-apps setting ("trusted"). A grant admin may also read other
      apps' budgets (GetBudget); raising a budget still needs "trusted" or
      the user's confirmation.

      ListApps: every application (or web origin) the agent has a record
      for, keyed by app id, with "limit_msat_per_day" (t),
      "spent_today_msat" (t) and "allow_read" (b). Grant admin only; anyone
      else gets Denied.
    -->
    <method name="ListApps">
      <arg name="apps" type="a{sa{sv}}" direction="out"/>
    </method>

    <!--
      SetReadAccess: grant or revoke @app_id's read access ("can see balance
      and history, and create invoices", the flag the "Always allow this
      app" switch sets). @app_id "" means the caller.
        grant    grant admin: immediately; any other identified app: only
                 after the user agrees in the agent's dialog
        revoke   one's own: always; another app's: grant admin only (no
                 dialog), everyone else Denied
      No-op calls change nothing and emit nothing.
      A read grant is not a spending budget, nor the reverse.
    -->
    <method name="SetReadAccess">
      <arg name="app_id" type="s" direction="in"/>
      <arg name="allow" type="b" direction="in"/>
    </method>

    <!--
      PaymentReceived: a wallet payment_received notification (NIP-47 kind
      23196/23197). Signals reach every session-bus client, so @details is
      minimal: "type", "amount" (x, msat), "fees_paid", "created_at",
      "settled_at", "is_zap" (b) and, for NIP-57 zaps, "zap_request" (s, the
      public kind-9734 event). Descriptions, payment hashes and preimages are
      only available through LookupInvoice/ListTransactions.
    -->
    <signal name="PaymentReceived">
      <arg name="details" type="a{sv}"/>
    </signal>

    <!--
      PaymentSent: emitted after a successful PayInvoice ("type" outgoing,
      "amount", "fees_paid", "app_id") or a wallet payment_sent notification
      (same minimal keys as PaymentReceived).
    -->
    <signal name="PaymentSent">
      <arg name="details" type="a{sv}"/>
    </signal>

    <!--
      AppsChanged: some application's read grant or daily limit changed
      (settings UIs re-list with ListApps). No arguments: who changed what
      is only visible through ListApps.
    -->
    <signal name="AppsChanged"/>

    <!--
      WalletAuthFinished: the BeginWalletAuth request ended: @success TRUE
      once the new wallet is connected; otherwise @message says why
      (declined, timed out, conflicting answers, cancelled, superseded).
      Carries no keys or links.
    -->
    <signal name="WalletAuthFinished">
      <arg name="success" type="b"/>
      <arg name="message" type="s"/>
    </signal>

    <!-- BudgetExceeded: a PayInvoice call did not fit @app_id's budget. -->
    <signal name="BudgetExceeded">
      <arg name="app_id" type="s"/>
      <arg name="requested_msat" type="t"/>
      <arg name="remaining_msat" type="t"/>
    </signal>

    <property name="Paired" type="b" access="read"/>
    <property name="WalletPubkey" type="s" access="read"/>
    <property name="Lud16" type="s" access="read"/>
    <property name="Relays" type="as" access="read"/>
  </interface>
</node>
