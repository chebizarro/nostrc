# /etc/nostr-auth/smb-credentiald.conf — SMB credential authority
# configuration.
#
# ────────────────────────────────────────────────────────────────
# FORWARD-COMPAT NAMING NOTE (plan §4.2 B1 + B4, 2026-09-25):
# The v1 authority is HOSTED IN-PROCESS in nostr-authd and is not a
# separate `nostr-smb-credentiald` daemon.  The `nh_smb_authority_*`
# code paths (`gnome/nostr-homed/src/smb/`) are already isolated from
# the broker at the type / data-flow level, so a v2 rename-and-lift
# split (docs/plans/gnome-integration-and-samba-server-2026-09-25.md
# §4.2 B4) can move that code into a dedicated daemon without a wire
# change.  The name of THIS file is chosen to survive that split
# unchanged — an admin will not need to relearn a config key or move
# a file when v2 lands.
#
# See docs/SAMBA_STANDALONE.md §Future for the reserved unit name.
# ────────────────────────────────────────────────────────────────
#
# File shape: strict `key = value` lines.  Blank lines and lines
# beginning with `#` are ignored.  Unknown keys are silently ignored
# so an older nostr-authd cooperates with a newer sample; a warning
# is emitted in the journal if a value fails to parse.
#
# The file is optional.  Every setting has a compile-time default.
# The environment override `NH_SMB_CREDENTIALD_CONF=<path>` selects
# a different file (used by integration tests).

# ─── Server-authority mediation ────────────────────────────────────
#
# smb_conf
#   Absolute path to the DEDICATED Samba config the authority selects
#   via `smbpasswd -c <path>` / `pdbedit -s <path>` on every write and
#   for the startup reconciliation pass (`pdbedit -L -s <path>`).  This
#   is NOT `/etc/samba/smb.conf`; it points at the standalone Samba
#   config that describes the isolated passdb backend (tdbsam at
#   `/var/lib/nostr-auth/smbpasswd` in the shipped sample) and the
#   Nostr shares.  See `smb.conf.standalone.sample`.
#
#   Default: `/etc/nostr-auth/smb.conf`.
#
#   The environment override `NH_SMB_CONF=<path>` also selects the
#   config file — used by test harnesses that bind-mount a fixture
#   into a container without editing this file.  The env override
#   wins.
#
# smb_conf = /etc/nostr-auth/smb.conf

# ─── Expiry policy ────────────────────────────────────────────────
#
# credential_lifetime_seconds
#   How long a minted SMB credential remains valid before the sweep
#   pass (`nostr-authctl smb-sweep`) revokes it.  Rotation is
#   automatic: a fresh `nh_smb_credential_issue` for the same
#   username retires any active credential.
#
#   Default: 43200 (12 h) — matches the D5 design's short-lived
#   posture.  Longer than 24h is refused (the sweep timer runs
#   hourly by default so anything above the timer cadence times two
#   is a self-inflicted DoS).
#
# credential_lifetime_seconds = 43200
#
# password_min_len
#   Floor on the minted password length.  The code enforces
#   NH_SMB_PASSWORD_MIN_LEN (20) at compile time; this key can raise
#   it (never lower it).  Bounded above by NH_SMB_PASSWORD_MAX_LEN
#   (64) to keep the mint / passdb path within a single write().
#
# password_min_len = 20
