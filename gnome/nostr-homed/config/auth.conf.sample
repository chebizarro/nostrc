# nostr-authd broker configuration (sample).
#
# The stage-1/2 daemon takes the socket path and authority directory as
# command-line arguments (see the shipped systemd unit); this sample documents
# the expected locations. authority.db must live in a root-owned 0700 directory.
authority_dir=/var/lib/nostr-auth
socket_path=/run/nostr-auth/auth.sock

# ---- NIP-46 QR (nostrconnect://) login at the GDM greeter ------------------
# The client-initiated QR flow (design docs/designs/nip46-qr-login-greeter.md
# §4.3) uses a relay to pair the greeter with the user's phone signer. The
# first relay listed is the one embedded in the QR itself; additional relays
# are only used for the client subscription. Cap: 4 relays parsed, first goes
# into the QR.
#
# Compiled-in default is wss://bunker.sharegap.net (design decision D4). A
# per-account override lives in the identity provider record's
# public_config_json; this key is the site-wide fallback.
#nip46_qr_relays=wss://bunker.sharegap.net

# Per-attempt scan window in milliseconds (default 78000, cannot exceed the
# broker's challenge lifetime minus a small setup budget — design §4.1 clamp).
#nip46_qr_wait_ms=78000

# Hint to the PAM module: "auto" | "qr" | "uri". The Phase-0 spike ruled the
# in-dialog half-block QR NO-GO for the graphical greeter, so v1 defaults to
# "uri" there; text consoles (tty/ssh/pamtester) always render the half-block
# QR regardless of this setting.
#nip46_qr_render=uri

# Broker-wide cap on simultaneous QR waits. Each in-flight QR holds a relay
# connection for ~78 s; without this an N-tab greeter is cheap DoS against
# the root daemon (design §8.4). Default 4.
#nip46_qr_max_concurrent=4

# ---- Nostr profile → GDM avatar/name (AccountsService) --------------------
# The broker refreshes each account's kind-0 (user metadata: name,
# display_name, picture) after a successful login and installs it into
# AccountsService via SetIconFile/SetRealName, so the stock GDM tile,
# login dialog, and lock screen render the user's real face instead of
# the generic avatar + "Nostr User" gecos. The picture is downloaded in
# a dropped-privilege child (setuid to profile_image_user), constrained
# to https:// + non-private peers + <=2 MiB + image/*, then re-encoded
# via GdkPixbuf to a bounded PNG. See docs/reviews/nostr-profile-avatar-*.md.
#
# profile_relays — comma-separated wss://... list queried for kind-0.
# Cap: NH_AUTH_CONF_RELAYS_MAX (4). Defaults to
#   wss://relay.damus.io, wss://nos.lol
# when unset.
#profile_relays=wss://relay.damus.io,wss://nos.lol
#
# profile_fetch — "on" (default) enables the seed-time and post-login
# refreshes; "off" disables both, leaving AccountsService untouched.
#profile_fetch=on
#
# profile_image_user — the unprivileged Unix user the image downloader
# drops to before dialling the picture URL. MUST NOT be root. Default
# "nobody"; sites that ship a dedicated user like `nostr-profile` set it
# here.
#profile_image_user=nobody

# ---- Portable home (Phase 2, bead nostrc-h10m) -----------------------------
# Encrypted-home materialisation at login. Requires the broker to be built
# with -DNOSTR_HOMED_ENABLE_PORTHOME_EXPERIMENTAL=ON; without that these keys
# are recognised but no PROVISION_HOME job is ever started (the broker
# responds NOT_SUPPORTED and pam_sm_open_session skips through to the
# ordinary local home path).
#
# Relays queried for the kind-30078 home pointer, comma-separated. First
# non-empty wins: per-account override in the provider record, then the
# user's NIP-65 (fetched by the profile subsystem), then this. No hard-coded
# fallback (design §5.1 D13) — leaving this empty means the account is NOT
# portable-home capable.
#home_relays=

# Blossom servers queried for encrypted chunk and manifest blobs, comma-
# separated. https:// only. Design §5.2 D14 recommends >= 2 configured with
# BUD-04 mirror to a third. Same first-non-empty resolution order as
# home_relays: per-account -> NIP-65 kind-10063 -> this key.
#blossom_servers=

# Per-file byte cap enforced by the provisioner (bytes). 0 or unset ->
# default 2 GiB (design §5.4). Trip = NH_PORTHOME_PROV_BUDGET -> broker
# reports LIMITED_MODE.
#porthome_bandwidth_bytes_per_load=

# Per-file wall-clock cap in seconds. 0 or unset -> default 120 s. Same
# trip semantics as bandwidth cap.
#porthome_load_timeout_sec=

# Per-home total byte cap. 0 or unset -> default 20 GiB (design §5.4).
#porthome_max_home_bytes=

# First-login wrap-key enrollment (design §4.3): when 'on', a fresh
# random 32-byte seed is generated at the broker, handed to the signer
# for nip44_encrypt, and the ciphertext persisted as the account's
# wrapped_home_key so the next login can unwrap it via nip44_decrypt.
# Off by default because it introduces a one-time bunker approval; must
# be explicitly enabled by the operator.
#porthome_enroll_wrap_key=off

# NIP-46 nip44_decrypt/nip44_encrypt wall-clock cap for the wrap-key
# hand-off (bead nostrc-ck6i). 0 or unset -> default 30 s; values above
# 120 are clamped to 120. A remote signer that does not answer within
# this window fails the wrap step and PROVISION_HOME falls back to
# LIMITED_MODE; login itself is unaffected.
#porthome_nip46_decrypt_timeout_sec=30

# Per-provider wrap-key skip cache TTL in seconds (bead nostrc-2mri).
# When a wrap-key hand-off is denied by the signer (or the ciphertext
# fails to decode), the broker persists a "last outcome + timestamp"
# on the provider row and SKIPS the NIP-46 RPC on subsequent logins
# until the TTL expires. That saves a full RPC round-trip and a
# WARNING per login when the bunker has revoked wrap-key perms.
# Transient signer-offline outcomes never latch — only DENIED and
# DECRYPT_FAILED do. A successful re-pairing (`connect` from a fresh
# nostrconnect QR flow) resets the cache immediately. 0 disables the
# cache (retries on every login); values above 86400 are clamped to
# 86400. Default (0 or unset) is 900 s = 15 min.
#porthome_wrap_key_denied_skip_sec=900

# Phase 2.5B fetch-helper sandbox (bead nostrc-ww50). The relay/Blossom
# fetch runs OUT-OF-PROCESS in the `nostr-home-fetch` binary, executed
# under a dedicated system user. The broker (nostr-authd) keeps root
# only for the materialisation step that follows.
#
# porthome_fetch_helper — absolute path to the fetch helper. Default
# is /usr/libexec/nostr-homed/nostr-home-fetch (bead nostrc-9k4g).
#porthome_fetch_helper=/usr/libexec/nostr-homed/nostr-home-fetch
#
# porthome_fetch_user — Unix account to drop into before exec-ing the
# helper. sysusers.d(5) provisions this at boot from
# packaging/sysusers.d/nostr-home-fetch.conf. If missing the sandbox
# falls back to `nobody` at spawn time (the hardening posture is
# preserved either way).
#porthome_fetch_user=nostr-home-fetch
