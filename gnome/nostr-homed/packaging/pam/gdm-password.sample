# /etc/pam.d/gdm-password — GDM graphical-login PAM stack with pam_nostr.so
# stacked above common-auth as a `sufficient` fallback: if the account has an
# enabled nostr provider and the passphrase / bunker approval is accepted, the
# broker completes authentication and GDM proceeds to session setup.  If the
# account is unknown to the broker (`NH_AUTH_RESULT_UNKNOWN_ACCOUNT`), or the
# broker is unreachable, control falls through to the stock Unix stack via
# @include common-auth, so a mis-seeded or stopped broker never bricks GDM.
#
# Copy to /etc/pam.d/gdm-password (mode 0644, owner root:root).  This file is
# a distro override of the Debian/Ubuntu default — diff against the shipped
# gdm-password before installing so any local customisation is preserved.
#
# Prerequisite services:
#   - nostr-authd.service (auth.sock mode 0600 in /run/nostr-auth mode 0711)
#   - /var/lib/nostr-auth/authority.db seeded with the account (nh-seed-authority)
#   - libnss_nostr.so.2 installed + /etc/nsswitch.conf lists `nostr` on passwd/group
#   - /etc/nss_nostr.conf pointing at /var/lib/nostr-auth/nss.db (mode 0644)
#
# See `pamtester nostr-login n_alice authenticate` for the headless proof of
# the same broker path.
#
# `provider=` picks a specific provider without prompting the user:
#   provider=local  — local encrypted vault (passphrase)
#   provider=nip46  — external NIP-46 signer / bunker approval
# Omitting `provider=` lets GDM's greeter show the account's enabled providers.
%PAM-1.0
auth    requisite       pam_nologin.so
auth    required        pam_succeed_if.so user != root quiet_success
auth    [success=done authinfo_unavail=ignore default=ignore] pam_nostr.so socket=/run/nostr-auth/auth.sock
@include common-auth
auth    optional        pam_gnome_keyring.so

account [success=done authinfo_unavail=ignore default=ignore] pam_nostr.so socket=/run/nostr-auth/auth.sock
@include common-account

session [success=ok ignore=ignore module_unknown=ignore default=bad] pam_selinux.so close
session required        pam_loginuid.so
session [success=ok ignore=ignore module_unknown=ignore default=bad] pam_selinux.so open
session optional        pam_keyinit.so force revoke
session required        pam_limits.so
session required        pam_env.so readenv=1
session required        pam_env.so readenv=1 user_readenv=1 envfile=/etc/default/locale
@include common-session
session optional        pam_gnome_keyring.so auto_start
@include common-password
