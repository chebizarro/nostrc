[Unit]
Description=Nostr authentication broker (nostr-authd)
Documentation=https://github.com/chebizarro/nostrc
After=local-fs.target

[Service]
Type=simple
ExecStart=@NH_AUTHD_PATH@ @NH_AUTHD_ARGS@
Restart=on-failure
RestartSec=1
# Runtime dir holds the broker sockets: auth.sock (mode 0600, root-only, the
# privileged AUTH endpoint) and, on SMB-enabled builds, user.sock (mode 0666,
# the own-account USER endpoint whose caller identity is enforced by
# SO_PEERCRED).  The directory is 0711 (traverse-only, not listable) so an
# unprivileged account uid can reach user.sock; it cannot open auth.sock
# because that socket is mode 0600.  authority.db lives in a 0700 state dir.
#
# greeter/ is a child of the runtime dir that holds the pairing-secret-
# bearing NIP-46 QR artifact (current.json + current.png + avatar.png).
# It MUST be group-scoped to nostr-auth-greeter so only gdm and the
# seated user (during unlock-dialog, via pam_group) can read it — the
# manifest embeds the one-time `secret=` pairing token and world-
# readable 0755+0644 lets any local uid burn it. See
# docs/reviews/greeter-artifact-secret-confidentiality-2026-09-22.md
# (beads nostrc-3c7n, references nostrc-zcll.6). The `nostr-auth-greeter`
# group is provisioned by the shipped sysusers.d snippet
# (packaging/sysusers.d/nostr-auth-greeter.conf); the greeter/ subdir is
# (re)created and re-tightened here in an ExecStartPre so the broker
# never has to trust that a stale bind-mount / hand-edit left the
# directory at the correct mode+group.
RuntimeDirectory=nostr-auth
RuntimeDirectoryMode=0711
ExecStartPre=/usr/bin/install -d -m 0750 -o root -g nostr-auth-greeter /run/nostr-auth/greeter
StateDirectory=nostr-auth
StateDirectoryMode=0700
ReadWritePaths=/var/lib/nostr-auth
# hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
# AF_INET and AF_INET6 are required for the NIP-46 QR / bunker flows —
# the broker dials the configured signer relays (design D4: default
# wss://bunker.sharegap.net) via libwebsockets, which opens a TCP/TLS
# socket. Restricting to AF_UNIX only silently prevents the WebSocket
# connect, then breaks event delivery on the persistent client
# subscription (broker sees the REQ go out, then never receives any
# incoming envelope), which manifests as `await_connect: timed out`
# and PAM_AUTH_ERR at the greeter even when the phone signer answered
# correctly. Nostrc-zcll.7 acceptance evidence: see
# docs/reviews/nip46-greeter-acceptance-2026-09-22.md.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
