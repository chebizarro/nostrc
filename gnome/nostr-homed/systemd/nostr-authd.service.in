[Unit]
Description=Nostr authentication broker (nostr-authd)
Documentation=https://github.com/chebizarro/nostrc
After=local-fs.target

[Service]
Type=simple
ExecStart=@NH_AUTHD_PATH@ @NH_AUTHD_ARGS@
Restart=on-failure
RestartSec=1
# Runtime dir holds the broker sockets: auth.sock (mode 0600, root-only, the
# privileged AUTH endpoint) and, on SMB-enabled builds, user.sock (mode 0666,
# the own-account USER endpoint whose caller identity is enforced by
# SO_PEERCRED).  The directory is 0711 (traverse-only, not listable) so an
# unprivileged account uid can reach user.sock; it cannot open auth.sock
# because that socket is mode 0600.  authority.db lives in a 0700 state dir.
RuntimeDirectory=nostr-auth
RuntimeDirectoryMode=0711
StateDirectory=nostr-auth
StateDirectoryMode=0700
ReadWritePaths=/var/lib/nostr-auth
# hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
