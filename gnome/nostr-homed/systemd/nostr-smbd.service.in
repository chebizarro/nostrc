[Unit]
Description=Nostr standalone Samba file-server (nostr-smbd)
Documentation=file://@CMAKE_INSTALL_FULL_DOCDIR@/SAMBA_STANDALONE.md
Documentation=https://www.samba.org/samba/docs/current/man-html/smbd.8.html
#
# Dedicated smbd instance bound to /etc/nostr-auth/smb.conf.  It is
# ISOLATED from the distro's stock samba.service and reads a
# dedicated tdbsam passdb at /var/lib/nostr-auth/smbpasswd populated
# by nostr-authd through the passdb_tdbsam adapter.  See
# docs/SAMBA_STANDALONE.md for the mediation contract.
#
# The share path (default /var/lib/nostr-auth/share-root) is
# materialized by nostr-home-fuse.service via the porthome/FUSE sync
# path (plan §4.2 B2 — v1 uses share-declaration, not a VFS plugin).
# smbd reads it as a regular filesystem: a FUSE mount failure
# manifests as a share-level ENOENT / EIO, not an smbd crash.  Total
# failure isolation between the mount pipeline and the file server.
After=network-online.target nostr-authd.service
Wants=network-online.target nostr-authd.service
# The FUSE mount that materializes the share path.  Wants= (not
# Requires=) so an operator can start nostr-smbd for
# diagnostics without a running FUSE; individual shares mark
# themselves `available = no` until the mount comes back.
Wants=nostr-home-fuse.service
After=nostr-home-fuse.service

[Service]
Type=notify
# -F: foreground (do not daemonize; systemd tracks the main pid).
# --no-process-group: do NOT call setsid() to become a process-group
# leader. Under systemd smbd is already the pgid leader, so setsid()
# returns EPERM and become_daemon() aborts with "Failed to create
# session, error code 1". This flag mirrors Ubuntu's stock
# /lib/systemd/system/smbd.service ExecStart posture. Discovered by
# Wave 4 Oscar acceptance (nostrc-0vuu).
# -s: select the standalone config file.  All three flags are stable
# in every supported Samba release (>= 4.15).
ExecStart=/usr/sbin/smbd -F --no-process-group -s @NH_SMB_CONF_PATH@
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
StartLimitBurst=5
StartLimitIntervalSec=60s
NotifyAccess=main
LimitNOFILE=16384

# ────────────────────────────────────────────────────────────────
# Capabilities — mirror the stock samba.service posture exactly.
# Under-restricting breaks smbd in subtle ways (a Windows client
# gets file-attribute stripping if DAC_OVERRIDE is missing, a bind
# to 445 fails without NET_BIND_SERVICE, per-user SID mapping fails
# without SETUID/SETGID); the plan §4.2 B1 #4 spec calls out this
# exact set.  See:
#   https://www.samba.org/samba/docs/current/man-html/smbd.8.html
# for the runtime capability requirements.
# ────────────────────────────────────────────────────────────────
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_CHOWN
AmbientCapabilities=

# Runtime + log dirs are provisioned by systemd.  RuntimeDirectory=
# maps to /run/nostr-smbd (0755), LogsDirectory= to /var/log/nostr-samba.
RuntimeDirectory=nostr-smbd
RuntimeDirectoryMode=0755
LogsDirectory=nostr-samba
LogsDirectoryMode=0755
# State dir hosts the dedicated tdbsam passdb + the smb.db issuance
# journal shared with nostr-authd, PLUS the FUSE-materialized share
# root traversed by force-user'd smbd children.  Mode 0755 is
# REQUIRED for the force-user account (nostr-smb-share) to traverse
# into share-root/; Samba's own private/state files live in the
# `samba-state` subdir which smbd chmods to 0700 on start.  See
# smb.conf.standalone.sample `state directory` / `private dir`.
# Discovered by Wave 4 Oscar acceptance (nostrc-45b2): Samba's start
# path unconditionally chmods `state directory` -> 0700 which flipped
# the parent to 0700 on every restart and blocked traversal.  Passdb
# blob (0600 from smbpasswd) + journal (0600 from nostr-authd) still
# protect their contents; the parent is only traversable, not
# readable-of-sensitive-contents.
StateDirectory=nostr-auth
StateDirectoryMode=0755

# Hardening — deliberately less aggressive than nostr-authd's set
# because smbd needs raw sockets, TCP 445 / 139 binds, and DAC
# override to serve files on behalf of arbitrary users.  Mirrors
# the stock samba.service posture on Ubuntu 24.04 and Fedora 40.
NoNewPrivileges=no
ProtectSystem=yes
ProtectHome=no
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
# Deliberately do NOT set MemoryDenyWriteExecute — Samba's internal
# ldb helpers use JIT-esque codegen on some paths.

# Read/write access to the FUSE-materialized share tree.  smbd runs
# as root but the share dir is owned by nostr-smb-share (see
# packaging/sysusers.d/nostr-smb-share.conf); smbd force-user's to
# that account inside the share stanza.
ReadWritePaths=/var/lib/nostr-auth /var/log/nostr-samba /run/nostr-smbd /var/lib/nostr-auth/share-root

[Install]
WantedBy=multi-user.target
