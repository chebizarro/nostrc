[Unit]
Description=Portable-home read-only overlay (nostr-home-fuse)
Documentation=https://github.com/chebizarro/nostrc
# The FUSE mount reads snapshot.json written by the syncd; keep them
# ordered so the mount can find a namespace on first login. The mount
# still tolerates a missing snapshot (exits cleanly with code 3).
After=nostr-home-sync.service
Wants=nostr-home-sync.service
# Torn down with the graphical session so the mount does not outlive
# gnome-session as a "Transport endpoint is not connected" directory.
PartOf=graphical-session.target

[Service]
# EXPERIMENTAL. Gated behind NOSTR_HOMED_ENABLE_PORTHOME_FUSE_EXPERIMENTAL
# at build time; the install rule (CMakeLists.txt) only emits this unit
# when both AUTH_INSTALL and PORTHOME_FUSE_EXPERIMENTAL are ON.
# See docs/designs/nostrfs-porthome-overlay.md §5.1 for the shape.
Type=notify
ExecStart=@NH_FUSE_BIN_PATH@
ExecStopPost=-/bin/fusermount3 -u -z %h/Portable
Restart=on-failure
RestartSec=5
# Clean exits: 3 = no/bad snapshot, 4 = no seed, 5 = already mounted.
RestartPreventExitStatus=3 4 5
LimitCORE=0

# ─── Hardening ─────────────────────────────────────────────────────
# Deliberately (almost) unsandboxed (nostrc-ipvk). A user unit cannot
# hold CAP_SYS_ADMIN, so the mount goes through the setuid fusermount3
# helper, and in a systemd --user manager nearly every sandboxing
# directive defeats that helper:
#   * NoNewPrivileges= / RestrictSUIDSGID= -- execve() ignores set-uid;
#   * the seccomp-based ones (SystemCallFilter=, SystemCallArchitectures=,
#     MemoryDenyWriteExecute=, LockPersonality=, RestrictNamespaces=,
#     RestrictAddressFamilies=, RestrictRealtime=, ...) IMPLY
#     NoNewPrivileges=yes when the manager lacks CAP_SYS_ADMIN;
#   * the namespacing ones (ProtectSystem=, ProtectHome=, PrivateTmp=,
#     ProtectKernelTunables=, ProtectControlGroups=, ProtectHostname=,
#     ...) put the service in its own user+mount namespace, where the
#     set-uid bit is meaningless and a mount would not be visible to the
#     session anyway;
#   * CapabilityBoundingSet= cannot be changed by a user manager
#     (218/CAPABILITIES, nostrc-ig4k).
# Probed one directive at a time on systemd 255 (aarch64 lab) with
# `systemd-run --user -p <directive> <tiny fuse fs> -f <dir>`: each of
# the above fails with "fusermount3: mount failed: Operation not
# permitted"; only the directives below leave the mount working. The
# daemon itself is read-only (every mutator returns EROFS) and mounts
# without allow_other, so only this user can reach it. Tighter isolation
# needs a system-level mount helper instead of a user unit.
UMask=0077
KeyringMode=private
DeviceAllow=/dev/fuse rw

[Install]
WantedBy=default.target
