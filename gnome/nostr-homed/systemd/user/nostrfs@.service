[Unit]
Description=NostrFS FUSE mount for user %i
After=network-online.target
# Wants=, not Requires=: a user manager has no network-online.target, and
# Requires= on a missing unit fails the start outright.
Wants=network-online.target
BindsTo=nostr-homectl.service

[Service]
Type=simple
# Default namespace — overridden by per-user config if present.
# Create /etc/nostr-homed/users/<username>.conf with HOMED_NAMESPACE=<ns>
# to give different users different namespaces.
Environment=HOMED_NAMESPACE=personal
Environment=SECRETS_NAMESPACE=personal
Environment=BLOSSOM_BASE_URL=https://blossom.example.org
Environment=RELAYS_DEFAULT=wss://nos.lol,wss://nostr.wine
EnvironmentFile=-/etc/nostr-homed/users/%i.conf
ExecStart=/usr/bin/nostrfs --writeback --namespace=${HOMED_NAMESPACE} /home/%i
Restart=on-failure
RestartSec=2s
# Sandboxing
NoNewPrivileges=true
PrivateTmp=true
# No ProtectClock= / ProtectKernelLogs= / ProtectKernelModules= /
# PrivateDevices= / CapabilityBoundingSet= / AmbientCapabilities=: the
# first five change the capability bounding set and the last raises an
# ambient capability, neither of which an unprivileged systemd --user
# manager can do -- the unit fails every start with 218/CAPABILITIES
# (nostrc-ig4k; probed on systemd 255 with
# `systemd-run --user -p <directive> /bin/true`). Same posture as
# nostr-session-relay.service (nostrc-q9ba) and nostr-notify.service
# (nostrc-8oon).
ProtectHostname=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
DeviceAllow=/dev/fuse rwm
# No CAP_SYS_ADMIN: a user unit cannot grant it (see above); the FUSE
# mount goes through the setuid fusermount3 helper.

[Install]
WantedBy=default.target
