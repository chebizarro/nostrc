[Unit]
Description=NostrFS FUSE mount for user %i
After=network-online.target
# Wants=, not Requires=: a user manager has no network-online.target, and
# Requires= on a missing unit fails the start outright.
Wants=network-online.target
BindsTo=nostr-homectl.service

[Service]
Type=simple
# Default namespace — overridden by per-user config if present.
# Create /etc/nostr-homed/users/<username>.conf with HOMED_NAMESPACE=<ns>
# to give different users different namespaces.
Environment=HOMED_NAMESPACE=personal
Environment=SECRETS_NAMESPACE=personal
Environment=BLOSSOM_BASE_URL=https://blossom.example.org
Environment=RELAYS_DEFAULT=wss://nos.lol,wss://nostr.wine
EnvironmentFile=-/etc/nostr-homed/users/%i.conf
ExecStart=/usr/bin/nostrfs --writeback --namespace=${HOMED_NAMESPACE} /home/%i
Restart=on-failure
RestartSec=2s
# Deliberately unsandboxed (nostrc-ipvk): a user unit cannot hold
# CAP_SYS_ADMIN, so the FUSE mount goes through the setuid fusermount3
# helper, and in a systemd --user manager NoNewPrivileges=,
# RestrictSUIDSGID=, every seccomp-based directive (they imply
# NoNewPrivileges=yes without CAP_SYS_ADMIN) and every namespacing
# directive (ProtectSystem=/ProtectHome=/PrivateTmp=/Protect*=: private
# user+mount namespace, so set-uid is void and the mount would be
# invisible to the session) make mount(2) fail with EPERM. Probed one
# directive at a time on systemd 255; see nostr-home-fuse.service.in
# for the full list. CapabilityBoundingSet=/AmbientCapabilities= are
# out as well (218/CAPABILITIES, nostrc-ig4k).
UMask=0077
KeyringMode=private
DeviceAllow=/dev/fuse rwm

[Install]
WantedBy=default.target
