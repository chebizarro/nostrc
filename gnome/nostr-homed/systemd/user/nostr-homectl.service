[Unit]
Description=Nostr Homed control service (homectl D-Bus)
Documentation=man:systemd(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/nostr-homectl --daemon
Restart=on-failure
RestartSec=2s
# Sandboxing
NoNewPrivileges=true
PrivateTmp=true
# No ProtectClock= / ProtectKernelLogs= / ProtectKernelModules= /
# PrivateDevices=: each shrinks the capability bounding set, which an
# unprivileged systemd --user manager cannot do -- the unit fails every
# start with 218/CAPABILITIES (nostrc-ig4k; probed on systemd 255 with
# `systemd-run --user -p <directive> /bin/true`). A user service holds none
# of those capabilities anyway. Same posture as nostr-session-relay.service
# (nostrc-q9ba) and nostr-notify.service (nostrc-8oon).
ProtectHostname=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=read-only
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
