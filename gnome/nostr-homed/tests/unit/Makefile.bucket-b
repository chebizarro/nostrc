ROOT := ../../../..
CC ?= cc
CFLAGS += -std=c11 -Wall -Wextra -Werror -I../../include -I../../src/auth -I$(ROOT)/libnostr/include -I$(ROOT)/libgo/include $(shell pkg-config --cflags jansson openssl)
LDLIBS := $(shell pkg-config --libs jansson openssl)
CFLAGS += $(SANITIZE)
LDLIBS += $(SANITIZE)

.PHONY: all run clean challenge provider-local
all: test_auth_protocol test_auth_vault test_auth_transaction test_auth_transaction_identity
test_auth_protocol: test_auth_protocol.c ../../src/auth/auth_protocol.c
	$(CC) $(CFLAGS) $^ $(LDLIBS) -o $@
test_auth_vault: test_auth_vault.c ../../src/auth/auth_vault.c $(ROOT)/libnostr/src/secure_buf.c
	$(CC) $(CFLAGS) $^ $(LDLIBS) -o $@
test_auth_transaction: test_auth_transaction.c ../../src/auth/auth_transaction.c
	$(CC) $(CFLAGS) $^ $(LDLIBS) -o $@
test_auth_transaction_identity: ../integration/test_auth_transaction_identity.c ../../src/auth/auth_transaction.c ../../src/auth/auth_transaction_identity.c $(wildcard ../../src/identity/identity_*.c)
	$(CC) $(CFLAGS) $(shell pkg-config --cflags sqlite3) $^ $(LDLIBS) $(shell pkg-config --libs sqlite3) -o $@
run: all
	./test_auth_protocol
	./test_auth_vault
	./test_auth_transaction
	./test_auth_transaction_identity
# Challenge test uses the repository libnostr target and is compiled by D when
# shared test registration lands. This target supports an existing build tree.
challenge:
	@test -n "$(LIBNOSTR_BUILD)" || (echo 'set LIBNOSTR_BUILD to a built libnostr directory' >&2; exit 2)
	$(CC) $(CFLAGS) test_auth_challenge.c ../../src/auth/auth_challenge.c -L$(LIBNOSTR_BUILD) -lnostr -L$(dir $(LIBNOSTR_BUILD))/libgo -lnostrgo $(LDLIBS) $(shell pkg-config --libs libwebsockets) -lsecp256k1 -o test_auth_challenge
provider-local:
	@test -n "$(LIBNOSTR_BUILD)" || (echo 'set LIBNOSTR_BUILD to a built libnostr directory' >&2; exit 2)
	$(CC) $(CFLAGS) ../integration/test_provider_local.c ../../src/auth/auth_challenge.c ../../src/auth/auth_vault.c ../../src/auth/provider_local.c -L$(LIBNOSTR_BUILD) -lnostr -L$(dir $(LIBNOSTR_BUILD))/libgo -lnostrgo $(LDLIBS) $(shell pkg-config --libs libwebsockets) -lsecp256k1 -o test_provider_local
clean:
	rm -f test_auth_protocol test_auth_vault test_auth_transaction test_auth_transaction_identity test_auth_challenge test_provider_local
