using Gtk 4.0;
using Adw 1;
translation-domain "grotto-panels";
template $GrottoRemotePanel: $GrottoPanel {
  title: _("Remote Signing"); tag: "remote-signing";
  child: Adw.ToolbarView {
    [top] Adw.HeaderBar {}
    [top] Adw.Banner feedback { title: _("Signer Unavailable"); }
    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        description: _("Remote signing lets apps on other devices request signatures without sharing your secret key.");
        Adw.SwitchRow enabled { title: _("Enable Remote Signing"); }
        Adw.ActionRow status { title: _("Status"); use-markup: false; subtitle-lines: 0; }
        Adw.ActionRow handoff { title: _("Change in Grotto…"); activatable: true; visible: false; }
      }
      Adw.PreferencesGroup connection_group {
        title: _("Connection Link");
        description: _("Enable remote signing to produce a link that an app can paste or scan to connect.");
        Adw.ActionRow connection_link {
          title: _("Connection Link"); use-markup: false;
          subtitle-lines: 3; subtitle-selectable: true; visible: false;
          [suffix] Button copy_link {
            icon-name: "edit-copy-symbolic"; tooltip-text: _("Copy Connection Link");
            valign: center; sensitive: false; styles ["flat"]
          }
        }
        Adw.ActionRow pairing {
          title: _("Show QR Code"); activatable: true; visible: false;
          [suffix] Image { icon-name: "go-next-symbolic"; }
        }
      }
      Adw.PreferencesGroup relays_group {
        title: _("Relays");
        description: _("Remote apps connect through these relays. Use wss://, or ws:// for a loopback address.");
        ListBox relays_list { selection-mode: none; styles ["boxed-list"] }
        Adw.EntryRow new_relay { title: _("Add Relay URL"); show-apply-button: true; }
      }
      Adw.PreferencesGroup {
        Adw.ExpanderRow {
          title: _("Details");
          Adw.EntryRow methods { title: _("Allowed Methods"); show-apply-button: true; }
          Adw.ActionRow reset {
          title: _("Reset Remote Connections…");
          subtitle: _("Disconnect remote apps and cancel pairing links. Identities and local app permissions are kept."); subtitle-lines: 0;
          activatable: true;
          }
        }
      }
    };
  };
}
