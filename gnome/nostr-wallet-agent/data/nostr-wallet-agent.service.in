[Unit]
Description=Nostr Wallet Connect agent (org.nostr.Wallet1)
Documentation=https://github.com/chebizarro/nostrc/tree/master/gnome/nostr-wallet-agent
# Approval dialogs need the graphical session; without one the agent still
# answers D-Bus but denies anything that needs the user (fails closed).
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.nostr.Wallet1
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/nostr-wallet-agent --gapplication-service
Restart=on-failure
RestartSec=5

# Hardening. The agent reads /proc/<pid>/{cgroup,exe,root/.flatpak-info} of
# its callers (same user), talks to the Secret Service over D-Bus, writes its
# budget ledger under $XDG_STATE_HOME/nostr-wallet and opens outbound
# WebSockets to the pairing's relays.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%S/nostr-wallet
StateDirectory=nostr-wallet
StateDirectoryMode=0700
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
# GTK may JIT shaders under some renderers; keep W^X off for the UI.
# MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
