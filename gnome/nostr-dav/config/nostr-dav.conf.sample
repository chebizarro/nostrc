# nostr-dav configuration
#
# Copy to $XDG_CONFIG_HOME/nostr-dav/nostr-dav.conf (normally
# ~/.config/nostr-dav/nostr-dav.conf). Every key is optional; a missing
# file means defaults. An unrecognized value makes nostr-dav refuse to
# start rather than silently fall back to a less private default.
#
# The listen address (127.0.0.1) and port (7680) are fixed at compile
# time and are intentionally not configurable.

[nostr-dav]

# Where nostr-dav fetches and publishes calendar/contact events:
#
#   session_relay_only       Only the session-local relay
#                            ($XDG_RUNTIME_DIR/nostr/relay.sock). Never
#                            contact the account's home relays. If the
#                            socket is missing, publish and sync are held:
#                            DAV edits stay local (pending) until it
#                            appears (checked every 30 s).
#   session_relay_or_direct  Use the session relay when its socket exists,
#                            otherwise the account's home relays. (default)
#   direct_only              Talk to the account's home relays directly.
#
# NOTE: the session relay does not forward to your home relays yet
# (nostrc-7d96). In the two session-relay modes, events you create stay in
# the local session relay (nothing is lost, but other devices will not see
# them) and inbound sync only sees what that relay already holds. Choose
# direct_only if you need your home relays today. nostr-dav logs which
# relays it uses at start-up.
#
#nostr_dav_upstream_mode=session_relay_or_direct

# Outbox commit policy for DAV writes (plan Track 2 D5 / Q4).
#
#   all      A pending row transitions to `published` only after EVERY
#            relay in its resolved target set has ACK'd. Failure to
#            reach the full set keeps the row pending, with exponential
#            backoff (60 s -> 60 min). This is the NIP-51/65 outbox
#            commit definition and the default.
#   <int>    Numeric override: transition after this many OKs. Only
#            useful when the account's NIP-65 write list is known to
#            be over-broad. Set to `1` for permissive `>=1 OK` behaviour.
#
#nostr_dav_publish_quorum=all

# Account pubkey (hex64) used by the REQ filter for inbound sync and
# stamped by the signer on outbound publishes. When unset, nostr-dav
# still serves DAV reads/writes locally but neither subscribes nor
# publishes.
#account_pubkey=

# Home relays used as the REQ target set for subscribe and as the
# fallback publish target set when NIP-65 discovery is absent.
# Comma-separated `wss://` URLs.
#home_relays=wss://relay.example.com,wss://relay-two.example.com

# Enable the outbound relay-sync + publish stack. Defaults to OFF while
# the production WebSocket backend is a scaffold that reports
# NOT_SUPPORTED on connect; leaving it OFF keeps DAV writes local rather
# than spinning the outbox against a backend that cannot reach a relay.
# The follow-up bead that lands the real WebSocket wiring will flip this
# default to ON.
#enable_publish=false
