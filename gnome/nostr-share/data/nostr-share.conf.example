# nostr-share configuration
#
# Copy to ~/.config/nostr-share/nostr-share.conf (or point
# $NOSTR_SHARE_CONFIG at it). Every key is optional.

[nostr-share]

# Relays used to look up your kind-10002 relay list and kind-10063
# Blossom server list, and the write relays used when you have no
# kind-10002 event. `;` or `,` separated.
#home_relays=wss://relay.example.com;wss://relay-two.example.com

# Blossom servers (https:// only) used when you have no kind-10063 list.
#blossom_servers=https://blossom.example.com

# Where events go. "Forwards" = the session relay
# ($XDG_RUNTIME_DIR/nostr/relay.sock) reports FederationState active or
# waiting-for-account on org.nostr.SessionRelay1, i.e. it delivers what it
# is given to your kind-10002 write relays itself.
#   session_relay_or_direct   (default) only the session relay while it
#                             forwards; success = it confirmed delivery to
#                             an upstream relay. Otherwise your NIP-65
#                             write relays directly.
#   session_relay_only        only the session relay; refuses to publish
#                             when it does not forward (nothing would ever
#                             leave this machine). Never contacts your
#                             relays from this process.
#   session_relay_and_direct  your write relays directly, plus a local copy
#                             in the session relay. Success = a write relay
#                             ACKed.
#   direct_only               never use the session relay.
#upstream_mode=session_relay_or_direct

# Largest file to upload, in MiB.
#max_upload_mib=100

# Kind for plain text (`-t TEXT`, text/plain) when --kind is not given:
#   1      a short note (default)
#   30023  a long-form article (NIP-23; addressable — re-sharing the same
#          title replaces the earlier article)
#default_text_kind=1

# Default for --keep-metadata: allow uploading media whose metadata
# (GPS, camera, timestamps) cannot be stripped — TIFF, WebM/MPEG video,
# MP3/Ogg audio and the like. Supported formats (JPEG/PNG/WebP/GIF,
# HEIC/HEIF/AVIF, MP4/MOV/3GP/M4A) are always stripped either way. The
# dialog still shows the metadata banner.
#keep_metadata=false

# Seconds to wait for relays to answer OK before giving up. Through a
# forwarding session relay it is also how long to wait for its upstream
# confirmation; past that the event stays queued there (exit status 5).
#ok_wait_sec=15

# nostr-dav endpoint for .ics/.vcf hand-off (default: whatever
# `nostr-dav --show-credentials` prints).
#dav_url=http://127.0.0.1:7680/
