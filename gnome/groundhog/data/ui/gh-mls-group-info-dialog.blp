using Gtk 4.0;
using Adw 1;

// Group Info for an encrypted group (charter §7.10 "MLS", §2.2 surface 2,
// §1.4, D7; nostrc-9xf5, qp24.13 part 2), driven by
// gh-mls-group-info-dialog.c over the account's GhMlsService. Everything
// comes from the group's own MLS state; nothing is fetched to fill it.
// Main page: the group (name, "Encrypted group · N members", description),
// what an encrypted group does and doesn't protect (gh-privacy-summary.h),
// how it is read and any change still being sent, the members (Owner and
// Admin badges; Add and Remove for admins only), Rename (admins), the group
// relays, the single-device note, and Leave, whose confirmation says the
// others keep counting the account until an admin removes it. "add": the
// accepted contacts to invite, each with a fresh KeyPackage check.
// "rename": the name and description.
template $GhMlsGroupInfoDialog: Adw.Dialog {
  title: _("Group Info");
  content-width: 460;
  content-height: 720;

  child: Adw.ToastOverlay toasts {
    child: Adw.NavigationView navigation {
      Adw.NavigationPage main_page {
        tag: "main";
        title: _("Group Info");

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Adw.PreferencesPage {
            Adw.PreferencesGroup {
              Box {
                orientation: vertical;
                spacing: 6;
                margin-bottom: 6;

                Adw.Avatar avatar {
                  size: 72;
                  show-initials: true;
                  halign: center;
                  accessible-role: presentation;
                }

                Label title_label {
                  wrap: true;
                  wrap-mode: word_char;
                  justify: center;
                  use-markup: false;

                  styles [
                    "title-2",
                  ]
                }

                Label subtitle_label {
                  wrap: true;
                  justify: center;
                  use-markup: false;

                  styles [
                    "dim-label",
                  ]
                }

                Label about_label {
                  visible: false;
                  wrap: true;
                  wrap-mode: word_char;
                  justify: center;
                  use-markup: false;
                  margin-top: 6;
                }
              }
            }

            // The group picture (W25, nostrc-m6tp), hidden without the
            // window's group files: what the group's picture is and, for an
            // encrypted one, Show Picture -- the only fetch, on request, from
            // the group's media server. A web address is never loaded here
            // (a placeholder: the initials above). Admins of adopted groups
            // change or remove it; a legacy group says it can't have one.
            Adw.PreferencesGroup picture_group {
              visible: false;
              title: _("Picture");

              header-suffix: Button set_picture_button {
                visible: false;
                valign: center;
                action-name: "mls-group.set-picture";
                tooltip-text: _("Choose a Picture for Everyone in the Group");

                child: Adw.ButtonContent {
                  icon-name: "document-open-symbolic";
                  label: _("_Choose…");
                  use-underline: true;
                };

                accessibility {
                  label: _("Choose Group Picture");
                }
              };

              Adw.ActionRow picture_row {
                title: _("Group Picture");
                use-markup: false;
                subtitle-lines: 5;

                [suffix]
                Spinner picture_spinner {
                  visible: false;
                  valign: center;
                }

                [suffix]
                Button show_picture_button {
                  visible: false;
                  label: _("_Show Picture");
                  use-underline: true;
                  valign: center;
                  action-name: "mls-group.show-picture";
                }

                [suffix]
                Button remove_picture_button {
                  visible: false;
                  label: _("_Remove");
                  use-underline: true;
                  valign: center;
                  action-name: "mls-group.remove-picture";
                  tooltip-text: _("Remove the Group’s Picture for Everyone");

                  styles [
                    "destructive-action",
                  ]
                }
              }
            }

            Adw.PreferencesGroup {
              title: _("Privacy");

              Adw.ActionRow privacy_row {
                use-markup: false;

                [prefix]
                Image {
                  icon-name: "channel-secure-symbolic";
                  accessible-role: presentation;
                }
              }

              // Rows: gh_privacy_summary_new() "visible" (from C).
              Adw.ExpanderRow visible_row {
                title: _("What Others Can See");
                use-markup: false;
              }

              // Rows: gh_privacy_summary_new() "unprotected" (from C).
              Adw.ExpanderRow unprotected_row {
                title: _("What Groundhog Can’t Protect");
                use-markup: false;
              }
            }

            Adw.PreferencesGroup {
              title: _("Group");

              Adw.ActionRow messages_row {
                title: _("Messages");
                use-markup: false;
              }

              // A change of this account's not merged yet, or invitations
              // not delivered yet; hidden when neither.
              Adw.ActionRow pending_row {
                visible: false;
                title: _("Still Sending");
                use-markup: false;

                [prefix]
                Spinner pending_spinner {
                  valign: center;
                }
              }

              Adw.ActionRow device_row {
                title: _("On this device only");
                subtitle: _("Messages are kept only on this device; history can’t be restored.");
                use-markup: false;
                subtitle-lines: 3;

                [prefix]
                Image {
                  icon-name: "computer-symbolic";
                  accessible-role: presentation;
                }
              }
            }

            // One $GhMlsMemberRow per member (from C): the owner first, then
            // admins, then members.
            Adw.PreferencesGroup members_group {
              title: _("Members");

              header-suffix: Button add_member_button {
                visible: false;
                valign: center;
                action-name: "mls-group.add-members";
                tooltip-text: _("Add Members");

                child: Adw.ButtonContent {
                  icon-name: "list-add-symbolic";
                  label: _("_Add");
                  use-underline: true;
                };

                accessibility {
                  label: _("Add Members");
                }

                styles [
                  "flat",
                ]
              };
            }

            Adw.PreferencesGroup admin_group {
              visible: false;
              title: _("Manage Group");

              Adw.ActionRow rename_row {
                title: _("Name and Description");
                use-markup: false;
                activatable: true;
                action-name: "mls-group.rename";

                [suffix]
                Image {
                  icon-name: "go-next-symbolic";
                  accessible-role: presentation;
                }
              }
            }

            // nostrc-46k7: media policy (file storage). Visible when the
            // group has a media policy or the admin can set one; admins
            // see a button to update the servers from their own settings.
            Adw.PreferencesGroup media_group {
              visible: false;
              title: _("File Storage");

              Adw.ActionRow media_policy_row {
                use-markup: false;
                subtitle-lines: 4;

                [prefix]
                Image {
                  icon-name: "folder-remote-symbolic";
                  accessible-role: presentation;
                }
              }

              Button update_media_button {
                visible: false;
                label: _("Update from _My Servers");
                use-underline: true;
                halign: center;
                action-name: "mls-group.update-media";

                styles [
                  "pill",
                ]
              }
            }

            // One $GhMlsRelayRow per group relay (from C).
            Adw.PreferencesGroup relays_group {
              title: _("Group Relays");
              description: _("They keep the group’s encrypted messages. They see when the group is active, but not who is in it or what is said.");
            }

            Adw.PreferencesGroup {
              Button leave_button {
                label: _("_Leave Group…");
                use-underline: true;
                halign: center;
                action-name: "mls-group.leave";

                styles [
                  "pill",
                  "destructive-action",
                ]
              }
            }
          };
        };
      }

      Adw.NavigationPage add_page {
        tag: "add";
        title: _("Add Members");

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Adw.PreferencesPage {
            $GhMlsInviteePicker add_picker {}

            Adw.PreferencesGroup {
              Label add_reason {
                wrap: true;
                justify: center;
                margin-bottom: 12;
                use-markup: false;

                styles [
                  "dim-label",
                ]
              }

              Button add_button {
                label: _("_Invite");
                use-underline: true;
                halign: center;
                action-name: "mls-group.save-add";

                styles [
                  "pill",
                  "suggested-action",
                ]
              }
            }
          };
        };
      }

      Adw.NavigationPage rename_page {
        tag: "rename";
        title: _("Name and Description");

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Adw.PreferencesPage {
            Adw.PreferencesGroup {
              description: _("Every member sees the new name and description.");

              Adw.EntryRow name_row {
                title: _("Name");
                use-markup: false;
              }

              Adw.EntryRow description_row {
                title: _("Description (Optional)");
                use-markup: false;
              }
            }

            Adw.PreferencesGroup {
              Button save_button {
                label: _("_Save");
                use-underline: true;
                halign: center;
                action-name: "mls-group.save-rename";

                styles [
                  "pill",
                  "suggested-action",
                ]
              }
            }
          };
        };
      }
    };
  };
}

// Response ids are unique across the file: blueprint-compiler 0.12 treats
// them as object ids.
// What Leave does depends on the group (gh-mls-service.h "Leaving",
// nostrc-2um6): for everyone where it can, else on this device only. The
// body is set when the dialog is shown (gh_mls_leave_copy()).
Adw.AlertDialog leave_dialog {
  heading: _("Leave Group?");
  body: "";
  default-response: "leave-cancel";
  close-response: "leave-cancel";

  responses [
    leave-cancel: _("_Cancel"),
    leave-confirm: _("_Leave") destructive,
  ]
}

// The body names the person (from C).
Adw.AlertDialog verify_dialog {
  heading: _("Verify Identity?");
  default-response: "verify-cancel";
  close-response: "verify-cancel";

  responses [
    verify-cancel: _("_Cancel"),
    verify-confirm: _("_Verify") suggested,
  ]
}

Adw.AlertDialog remove_dialog {
  heading: _("Remove from Group?");
  default-response: "remove-cancel";
  close-response: "remove-cancel";

  responses [
    remove-cancel: _("_Cancel"),
    remove-confirm: _("_Remove") destructive,
  ]
}

// W25 review M1: before a group picture is uploaded, where it goes (every
// server that may take it) and what that server learns (body from C).
Adw.AlertDialog set_picture_dialog {
  heading: _("Set This Picture for Everyone?");
  default-response: "set-picture-cancel";
  close-response: "set-picture-cancel";

  responses [
    set-picture-cancel: _("_Cancel"),
    set-picture-confirm: _("_Upload and Set") suggested,
  ]
}

// W25 review L5: removing the picture changes it for every member.
Adw.AlertDialog remove_picture_dialog {
  heading: _("Remove the Picture for Everyone?");
  body: _("Every member will see the group’s initials instead. To bring the picture back, choose it again.");
  default-response: "remove-picture-cancel";
  close-response: "remove-picture-cancel";

  responses [
    remove-picture-cancel: _("_Cancel"),
    remove-picture-confirm: _("_Remove") destructive,
  ]
}
