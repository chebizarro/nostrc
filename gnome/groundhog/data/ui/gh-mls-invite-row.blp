using Gtk 4.0;
using Adw 1;

// One pending invitation to an encrypted group (charter §7.9 "shown like
// requests", PD-8; nostrc-9xf5), filled by gh-mls-invites-dialog.c: the
// group's name as the inviter's Welcome claims it (plain text, never
// markup), who invited (a contact's cached name, else the short npub with
// "not in your contacts": nothing is looked up) and how many members it
// had, with Decline and Accept. Nothing is joined until Accept.
template $GhMlsInviteRow: Adw.ActionRow {
  use-markup: false;
  title-lines: 1;
  subtitle-lines: 2;

  [prefix]
  Adw.Avatar avatar {
    size: 40;
    show-initials: true;
    accessible-role: presentation;
  }

  [suffix]
  Box {
    spacing: 6;
    valign: center;

    Button decline_button {
      label: _("_Decline");
      use-underline: true;
      action-name: "mls-invites.decline";
    }

    Button accept_button {
      label: _("_Accept");
      use-underline: true;
      action-name: "mls-invites.accept";

      styles [
        "suggested-action",
      ]
    }
  }
}
