using Gtk 4.0;
using Adw 1;

// Content navigation page (charter §7.3, §7.4): the header, whose title
// follows the selected conversation, over "No Conversation Selected" or the
// conversation. The conversation page is the conversation view's slot
// (GhConversationView, gh-conversation-view.blp, set from C by
// gh-conversation-list.c, which knows the conversation model) above the
// composer (gh-composer.blp, charter G13; gh-send-ui.c drives it). The
// composer sits in a plain box rather than a toolbar bottom bar, so a
// wrapped "why you can't send" reason gets the height of every line on
// libadwaita 1.5 too. The page's breakpoints (charter §7.12, UX-2) make the
// composer compact below 480sp and cap it at 3 lines below 360sp; the
// minimum size leaves the 360x294 window usable (UX-1). The conversation
// menu (charter §7.4 conversation_menu, nostrc-qp24.86) shows with a
// private conversation; gh-conversation-menu.c owns its actions and shows it.
template $GhContentPage: Adw.NavigationPage {
  title: _("Messages");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {
        title: _("Messages");
      };

      [end]
      MenuButton menu_button {
        visible: false;
        icon-name: "view-more-symbolic";
        tooltip-text: _("Conversation Menu");
        menu-model: conversation_menu;

        accessibility {
          label: _("Conversation Menu");
        }
      }

      // Conversation Info (charter §7.4, G19): shown with a conversation;
      // win.conversation-info comes from gh-conversation-info-dialog.c.
      [end]
      Button info_button {
        visible: false;
        icon-name: "help-about-symbolic";
        tooltip-text: _("Conversation Info");
        action-name: "win.conversation-info";

        accessibility {
          label: _("Conversation Info");
        }
      }
    }

    content: Stack content_stack {
      StackPage {
        name: "none";

        child: Adw.StatusPage none_page {
          icon-name: "mail-read-symbolic";
          title: _("No Conversation Selected");
          description: _("Choose a conversation to read its messages.");
          hexpand: true;
          vexpand: true;

          styles [
            "groundhog-shell-status",
          ]
        };
      }

      StackPage {
        name: "conversation";

        child: Adw.BreakpointBin conversation_bin {
          width-request: 300;
          height-request: 200;

          child: Box {
            orientation: vertical;

            Adw.Bin conversation_slot {
              vexpand: true;
            }

            $GhComposer composer {}
          };

          // Only the last matching breakpoint applies, so both at once is
          // its own, last.
          Adw.Breakpoint {
            condition ("max-width: 480sp")

            setters {
              composer.compact: true;
            }
          }

          Adw.Breakpoint {
            condition ("max-height: 360sp")

            setters {
              composer.max-lines: 3;
            }
          }

          Adw.Breakpoint {
            condition ("max-width: 480sp and max-height: 360sp")

            setters {
              composer.compact: true;
              composer.max-lines: 3;
            }
          }
        };
      }
    };
  };
}

// The shown conversation's menu (gh-conversation-menu.c): each item acts on
// the conversation the page shows. Of Pin and Unpin only the one that
// applies shows.
menu conversation_menu {
  section {
    item {
      label: _("Conversation _Info");
      action: "win.conversation-info";
    }

    // Rename (nostrc-0srb): shown for groups; enabled for admins.
    item {
      label: _("_Rename Group…");
      action: "win.rename-shown-group";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Pin");
      action: "win.pin-shown-conversation";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Un_pin");
      action: "win.unpin-shown-conversation";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("_Mute…");
      action: "win.mute-shown-conversation";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Disappearing Messages…");
      action: "win.disappearing-shown-conversation";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("_Delete Conversation…");
      action: "win.delete-shown-conversation";
      hidden-when: "action-disabled";
    }
  }
}
