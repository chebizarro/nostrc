using Gtk 4.0;
using Adw 1;

// Content navigation page (charter §7.3, §7.4): the header, whose title
// follows the selected conversation, over "No Conversation Selected" or the
// conversation. The conversation page has two slots filled from C: the
// conversation view (GhConversationView, gh-conversation-view.blp), which
// gh-conversation-list.c sets because it knows the conversation model, and
// the composer (charter G13). Until the composer lands, the composer slot
// holds the line saying why sending is unavailable (kept current by
// gh-account-ui.c); it is a plain box rather than a toolbar bottom bar, so a
// wrapped reason gets the height of every line on libadwaita 1.5 too.
template $GhContentPage: Adw.NavigationPage {
  title: _("Messages");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {
        title: _("Messages");
      };
    }

    content: Stack content_stack {
      StackPage {
        name: "none";

        child: Adw.StatusPage none_page {
          icon-name: "mail-read-symbolic";
          title: _("No Conversation Selected");
          description: _("Choose a conversation to read its messages.");
          hexpand: true;
          vexpand: true;

          styles [
            "groundhog-shell-status",
          ]
        };
      }

      StackPage {
        name: "conversation";

        child: Box {
          orientation: vertical;

          Adw.Bin conversation_slot {
            vexpand: true;
          }

          // The composer (charter G13) replaces the reason line.
          Adw.Bin composer_slot {
            child: Label read_only_reason {
              visible: false;
              wrap: true;
              wrap-mode: word_char;
              justify: center;

              styles [
                "dim-label",
                "groundhog-read-only-reason",
              ]
            };
          }
        };
      }
    };
  };
}
