using Gtk 4.0;
using Adw 1;

// New Group (charter §7.9; item G20b, qp24.13 part 2), driven by
// gh-new-group-dialog.c. "type": the chooser, stating the difference up
// front (§2.2 surface 3); it is the first page only when the encrypted page
// (gh-mls-new-group-page.blp, tag "encrypted") was added, else the dialog
// starts at "form": encrypted groups are never a disabled placeholder.
// "form": the relay the group lives on,
// its name and about, "Only Members Can Read" (private) and "Join by Invite
// Only" (closed), with what a relay group means before anything is sent.
// Nothing contacts the network until Create. "status": the relay's answer
// (gh_group_create_copy(): waiting for the signer, creating, created and
// waiting for its details until the relay's own 39000 arrives, or not
// created with the relay's reason: most relays don't let people create
// groups). Relay text is plain text.
template $GhNewGroupDialog: Adw.Dialog {
  title: _("New Group");
  content-width: 440;
  content-height: 640;

  child: Adw.NavigationView navigation {
    Adw.NavigationPage type_page {
      tag: "type";
      title: _("New Group");

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {}

        content: Adw.PreferencesPage {
          Adw.PreferencesGroup {
            Adw.ActionRow encrypted_choice {
              title: _("Encrypted Group");
              subtitle: _("Only members can read messages. Everyone needs an app that supports Marmot encrypted groups.");
              use-markup: false;
              activatable: true;
              action-name: "new-group.choose-encrypted";

              [prefix]
              Image {
                icon-name: "channel-secure-symbolic";
                accessible-role: presentation;
              }

              [suffix]
              Image {
                icon-name: "go-next-symbolic";
                accessible-role: presentation;
              }
            }

            Adw.ActionRow relay_choice {
              title: _("Relay Group");
              subtitle: _("Hosted on a relay you choose. The relay’s operators can read messages.");
              use-markup: false;
              activatable: true;
              action-name: "new-group.choose-relay";

              [prefix]
              Image {
                icon-name: "network-workgroup-symbolic";
                accessible-role: presentation;
              }

              [suffix]
              Image {
                icon-name: "go-next-symbolic";
                accessible-role: presentation;
              }
            }
          }
        };
      };
    }

    Adw.NavigationPage form_page {
      tag: "form";
      title: _("New Relay Group");

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {}

        content: Adw.PreferencesPage {
          Adw.PreferencesGroup {
            description: _("Hosted on a relay you choose. Not every relay lets people create groups.");

            Adw.EntryRow relay_row {
              title: _("Relay");
              use-markup: false;
            }
          }

          Adw.PreferencesGroup {
            Adw.EntryRow name_row {
              title: _("Name");
              use-markup: false;
            }

            Adw.EntryRow about_row {
              title: _("About (Optional)");
              use-markup: false;
            }
          }

          Adw.PreferencesGroup {
            Adw.SwitchRow private_switch {
              title: _("Only Members Can Read");
              subtitle: _("Enforced by the relay. Its operators can still read everything.");
            }

            Adw.SwitchRow closed_switch {
              title: _("Join by Invite Only");
              subtitle: _("Join requests without an invite code are refused");
            }
          }

          Adw.PreferencesGroup {
            Label error_label {
              visible: false;
              wrap: true;
              xalign: 0;
              use-markup: false;

              styles [
                "error",
              ]
            }
          }

          Adw.PreferencesGroup {
            title: _("Before You Create It");

            Adw.ActionRow {
              title: _("Not end-to-end encrypted");
              subtitle: _("The relay’s operators can read every message in the group and see who wrote it.");
              use-markup: false;

              [prefix]
              Image {
                icon-name: "dialog-warning-symbolic";
                accessible-role: presentation;
              }
            }

            // The C code says what the relay learns in the current network
            // mode (gh_group_contact_copy); this is the direct-connection text.
            Adw.ActionRow contact_row {
              title: _("Creating contacts the relay");
              subtitle: _("It learns your public key and your IP address, and makes you the group’s admin. Nothing is sent until you choose Create.");
              use-markup: false;

              [prefix]
              Image {
                icon-name: "network-server-symbolic";
                accessible-role: presentation;
              }
            }
          }

          Adw.PreferencesGroup {
            Button create_button {
              label: _("_Create Group");
              use-underline: true;
              halign: center;
              action-name: "new-group.create";

              styles [
                "pill",
                "suggested-action",
              ]
            }
          }
        };
      };
    }

    Adw.NavigationPage status_page {
      tag: "status";
      title: _("New Relay Group");

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {}

        content: ScrolledWindow {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            maximum-size: 400;
            margin-top: 24;
            margin-bottom: 24;
            margin-start: 12;
            margin-end: 12;

            child: Box {
              orientation: vertical;
              spacing: 12;
              valign: center;

              Image status_icon {
                pixel-size: 64;
                halign: center;
                accessible-role: presentation;

                styles [
                  "dim-label",
                ]
              }

              Spinner spinner {
                visible: false;
                halign: center;
                width-request: 32;
                height-request: 32;
              }

              Label status_title {
                wrap: true;
                justify: center;
                use-markup: false;

                styles [
                  "title-2",
                ]
              }

              Label status_description {
                wrap: true;
                wrap-mode: word_char;
                justify: center;
                use-markup: false;
              }

              Button open_button {
                visible: false;
                label: _("_Open Group");
                use-underline: true;
                halign: center;
                margin-top: 12;
                action-name: "new-group.open";

                styles [
                  "pill",
                  "suggested-action",
                ]
              }

              Button back_button {
                visible: false;
                label: _("_Change and Try Again");
                use-underline: true;
                halign: center;
                action-name: "new-group.back";

                styles [
                  "pill",
                ]
              }
            };
          };
        };
      };
    }
  };
}
