using Gtk 4.0;
using Adw 1;

// Pending invitations to encrypted groups (charter §7.9, PD-8, PT-8;
// nostrc-9xf5, qp24.13 part 2), driven by gh-mls-invites-page.c over
// the account's GhMlsService: one $GhMlsInviteRow per invitation, oldest
// first, following "invite-received". Like a message request, nothing is
// joined, fetched or looked up until the user accepts: Accept joins the
// group (its conversation is listed and read), Decline forgets the
// invitation. An invitation that arrived but could not be opened (made
// for a key this device does not have: relogin-signer-groups) is listed
// under refused_group, with Dismiss only: nothing here can open it.
// A sidebar panel pushed over the conversation list (gh_window_push_panel()):
// the header's back button and Escape return to it.
template $GhMlsInvitesPage: Adw.NavigationPage {
  tag: "group-invitations";
  title: _("Group Invitations");

  // Its toasts are the window's (the nearest Adw.ToastOverlay above it).
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Adw.PreferencesPage {
      // This device (relogin-signer-groups, mls-groups-bunker): an
      // encrypted group's keys stay on the device that joined it, so
      // groups joined in another app or on another device never appear
      // here. Said always, with whether this device's own invitation key
      // (KeyPackage) is published, so an empty list is not a mystery.
      Adw.PreferencesGroup device_group {
        title: _("This Device");
        description: _("Encrypted groups you joined in another app or on another device can’t be opened here: their keys stay on that device. To use a group here, ask one of its members to add you again; the new invitation is made for this device and appears below.");

        Adw.ActionRow key_row {
          title: _("Invitation Key");
          subtitle-selectable: true;

          [prefix]
          Image {
            icon-name: "channel-secure-symbolic";
            accessible-role: presentation;
          }
        }

        // Old invitation keys (nostrc-ab9kn): the account's other
        // KeyPackages on its relays (another device, another app, an
        // earlier install here), listed in a confirmation before one NIP-09
        // deletion request asks the relays to drop them. The subtitle says
        // what the last look found.
        Adw.ActionRow old_keys_row {
          title: _("Old Invitation Keys");
          subtitle: _("Keys your account published from other devices, apps or earlier installs. People may still invite you with them.");

          [prefix]
          Image {
            icon-name: "dialog-password-symbolic";
            accessible-role: presentation;
          }

          [suffix]
          Button old_keys_button {
            label: _("_Review…");
            use-underline: true;
            valign: center;
            action-name: "mls-invites.review-keys";
          }
        }
      }

      // Rows from C; a placeholder row while there are none.
      Adw.PreferencesGroup invites_group {
        title: _("Invitations");
        description: _("Nothing is joined until you accept. For someone you haven’t accepted as a contact, only their public key is shown and nothing is looked up about them.");

        Adw.ActionRow empty_row {
          title: _("No invitations waiting");
          subtitle: _("When someone invites you to an encrypted group, the invitation waits here until you accept or decline it.");
        }
      }

      // Rows from C; hidden while empty.
      Adw.PreferencesGroup refused_group {
        title: _("Could Not Be Opened");
        description: _("These invitations were made for a key this device doesn’t have, for example one from another device or from before this account’s messages were forgotten here. Ask the sender to invite you again.");
        visible: false;
      }
    };
  };
}
