using Gtk 4.0;
using Adw 1;

// Sidebar navigation page (charter §7.4, §7.5): header with search, new
// message and the main menu; the search bar; the one status banner (from
// GhStatus); and the stack that shows the conversation list or its empty,
// no-results and error states. Account-state pages (gh-account-ui.blp) or
// the standalone onboarding page are added to the stack from C. The list's
// model and row factory are bound from C (gh-conversation-list.c); nothing
// here fabricates conversations.
template $GhSidebarPage: Adw.NavigationPage {
  title: _("Conversations");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar header {
      // Only in Message Requests mode (show-requests).
      [start]
      Button back_button {
        visible: false;
        icon-name: "go-previous-symbolic";
        tooltip-text: _("Back to Conversations");
        action-name: "sidebar.show-requests";
        action-target: "false";

        accessibility {
          label: _("Back to Conversations");
        }
      }

      [start]
      ToggleButton search_button {
        icon-name: "system-search-symbolic";
        tooltip-text: _("Search Conversations");

        accessibility {
          label: _("Search Conversations");
        }
      }

      title-widget: Adw.WindowTitle window_title {
        title: "Groundhog";
      };

      [end]
      MenuButton primary_button {
        primary: true;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
        menu-model: primary_menu;

        accessibility {
          label: _("Main Menu");
        }
      }

      // win.new-message stays disabled until starting a conversation exists
      // (charter G18); the tooltip and description say so in place.
      [end]
      Button new_button {
        icon-name: "list-add-symbolic";
        action-name: "win.new-message";
        tooltip-text: _("New Message — not available in this version yet");

        accessibility {
          label: _("New Message");
          description: _("Not available in this version yet");
        }
      }
    }

    [top]
    SearchBar search_bar {
      search-mode-enabled: bind search_button.active bidirectional;

      child: SearchEntry search_entry {
        placeholder-text: _("Search conversations");
        hexpand: true;

        accessibility {
          label: _("Search conversations");
        }
      };
    }

    // Title, button and visibility follow the window's GhStatus.
    [top]
    Adw.Banner status_banner {
      revealed: false;
      use-markup: false;
    }

    // The region whose visible child changes with account and list state;
    // named so it is announced apart from the list it contains.
    content: Stack stack {
      accessibility {
        label: _("Conversation list status");
      }

      StackPage {
        name: "conversations";

        child: Box {
          orientation: vertical;

          // Shown when message requests exist (charter §7.5, PD-8): they
          // are listed apart and never mixed into the conversations.
          Button requests_button {
            visible: false;
            action-name: "sidebar.show-requests";
            action-target: "true";

            styles [
              "flat",
              "groundhog-requests-button",
            ]

            child: Box {
              spacing: 12;

              Image {
                icon-name: "mail-unread-symbolic";
                accessible-role: presentation;
              }

              Label {
                label: _("Message Requests");
                xalign: 0;
                hexpand: true;
                ellipsize: end;
              }

              Label requests_count {
                styles [
                  "dim-label",
                  "numeric",
                ]
              }

              Image {
                icon-name: "go-next-symbolic";
                accessible-role: presentation;
              }
            };
          }

          ScrolledWindow {
            vexpand: true;
            hscrollbar-policy: never;

            child: ListView list {
              styles [
                "navigation-sidebar",
              ]

              accessibility {
                label: _("Conversations");
              }
            };
          }
        };
      }

      StackPage {
        name: "empty";

        child: Adw.StatusPage empty_page {
          icon-name: "mail-unread-symbolic";
          title: _("No Conversations");
          description: _("Private messages people send you will appear here. Starting a new conversation isn't available in this version yet.");
          hexpand: true;
          vexpand: true;

          styles [
            "groundhog-shell-status",
          ]
        };
      }

      StackPage {
        name: "no-results";

        child: Adw.StatusPage no_results_page {
          icon-name: "system-search-symbolic";
          title: _("No Results");
          description: _("No conversation matches your search.");
          hexpand: true;
          vexpand: true;

          styles [
            "groundhog-shell-status",
          ]
        };
      }

      // The description is replaced with the receive path's own
      // explanation when it has one.
      StackPage {
        name: "error";

        child: Adw.StatusPage error_page {
          icon-name: "dialog-warning-symbolic";
          title: _("Conversations Unavailable");
          description: _("Groundhog can't receive messages on this device right now.");
          hexpand: true;
          vexpand: true;

          styles [
            "groundhog-shell-status",
          ]
        };
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }
  }

  section {
    item {
      label: _("_Quit");
      action: "app.quit";
    }
  }
}
