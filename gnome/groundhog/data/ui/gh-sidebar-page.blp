using Gtk 4.0;
using Adw 1;

// Sidebar navigation page (charter §7.4, §7.5): header with search, new
// message and the main menu; the search bar; the one status banner (from
// GhStatus); and the stack that shows the conversation list or its empty,
// no-results and error states. Account-state pages (gh-account-ui.blp) or
// the onboarding_unavailable page below are added to the stack from C. The list's
// model and row factory are bound from C (gh-conversation-list.c); nothing
// here fabricates conversations.
template $GhSidebarPage: Adw.NavigationPage {
  title: _("Conversations");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar header {
      // Only in Message Requests mode (show-requests).
      [start]
      Button back_button {
        visible: false;
        icon-name: "go-previous-symbolic";
        tooltip-text: _("Back to Conversations");
        action-name: "sidebar.show-requests";
        action-target: "false";

        accessibility {
          label: _("Back to Conversations");
        }
      }

      [start]
      ToggleButton search_button {
        icon-name: "system-search-symbolic";
        tooltip-text: _("Search Conversations");

        accessibility {
          label: _("Search Conversations");
        }
      }

      title-widget: Adw.WindowTitle window_title {
        title: "Groundhog";
      };

      [end]
      MenuButton primary_button {
        primary: true;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
        menu-model: primary_menu;

        accessibility {
          label: _("Main Menu");
        }
      }

      // win.new-message opens New Message (charter §7.9, G18).
      [end]
      Button new_button {
        icon-name: "list-add-symbolic";
        action-name: "win.new-message";
        tooltip-text: _("New Message");

        accessibility {
          label: _("New Message");
        }
      }
    }

    [top]
    SearchBar search_bar {
      search-mode-enabled: bind search_button.active bidirectional;

      child: SearchEntry search_entry {
        placeholder-text: _("Search titles or npubs");
        tooltip-text: _("Search conversation titles, request subjects and participant npubs on this device. Message text is not searched.");
        hexpand: true;

        accessibility {
          label: _("Search conversations");
        }
      };
    }

    // Title, button and visibility follow the window's GhStatus.
    [top]
    Adw.Banner status_banner {
      revealed: false;
      use-markup: false;
    }

    // The region whose visible child changes with account and list state;
    // named so it is announced apart from the list it contains.
    content: Stack stack {
      accessibility {
        label: _("Conversation list status");
      }

      StackPage {
        name: "conversations";

        child: Box {
          orientation: vertical;

          // Shown when message requests exist (charter §7.5, PD-8): they
          // are listed apart and never mixed into the conversations.
          Button requests_button {
            visible: false;
            action-name: "sidebar.show-requests";
            action-target: "true";

            styles [
              "flat",
              "groundhog-requests-button",
            ]

            child: Box {
              spacing: 12;

              Image {
                icon-name: "mail-unread-symbolic";
                accessible-role: presentation;
              }

              Label {
                label: _("Message Requests");
                xalign: 0;
                hexpand: true;
                ellipsize: end;
              }

              Label requests_count {
                styles [
                  "dim-label",
                  "numeric",
                ]
              }

              Image {
                icon-name: "go-next-symbolic";
                accessible-role: presentation;
              }
            };
          }

          // Shown when encrypted-group invitations wait (qp24.13 part 2):
          // like requests, nothing is joined until one is accepted there.
          Button invitations_button {
            visible: false;
            action-name: "win.group-invitations";

            styles [
              "flat",
              "groundhog-requests-button",
            ]

            child: Box {
              spacing: 12;

              Image {
                icon-name: "channel-secure-symbolic";
                accessible-role: presentation;
              }

              Label {
                label: _("Group Invitations");
                xalign: 0;
                hexpand: true;
                ellipsize: end;
              }

              Label invitations_count {
                styles [
                  "dim-label",
                  "numeric",
                ]
              }

              Image {
                icon-name: "go-next-symbolic";
                accessible-role: presentation;
              }
            };
          }

          ScrolledWindow {
            vexpand: true;
            hscrollbar-policy: never;

            child: ListView list {
              show-separators: true;
              styles [
                "navigation-sidebar",
              ]

              accessibility {
                label: _("Conversations");
              }
            };
          }
        };
      }

      StackPage {
        name: "empty";

        // #9 (charter §7.15): the way to start one is right here.
        child: Adw.StatusPage empty_page {
          icon-name: "mail-unread-symbolic";
          title: _("No Conversations");
          description: _("Start a private conversation. Messages people send you will appear here too.");
          hexpand: true;
          vexpand: true;

          styles [
            "groundhog-shell-status",
          ]

          child: Button empty_new_button {
            label: _("_New Message");
            use-underline: true;
            halign: center;
            action-name: "win.new-message";

            styles [
              "pill",
              "suggested-action",
            ]
          };
        };
      }

      StackPage {
        name: "no-results";

        child: Adw.StatusPage no_results_page {
          icon-name: "system-search-symbolic";
          title: _("No Results");
          description: _("No title, request subject or participant npub matches. Try another search or press Escape to clear it.");
          hexpand: true;
          vexpand: true;

          styles [
            "groundhog-shell-status",
          ]
        };
      }

      // The description is replaced with the receive path's own
      // explanation when it has one.
      StackPage {
        name: "error";

        child: Adw.StatusPage error_page {
          icon-name: "dialog-warning-symbolic";
          title: _("Conversations Unavailable");
          description: _("Groundhog can't receive messages on this device right now.");
          hexpand: true;
          vexpand: true;

          styles [
            "groundhog-shell-status",
          ]
        };
      }
    };
  };
}

menu primary_menu {
  // NIP-29 relay groups (G20b, gh-group-ui.c); absent without them.
  section {
    item {
      label: _("_Join Group…");
      action: "win.join-group";
      hidden-when: "action-missing";
    }

    item {
      label: _("New _Group…");
      action: "win.new-group";
      hidden-when: "action-missing";
    }

    item {
      label: _("_Add Contact…");
      action: "win.add-contact";
      hidden-when: "action-missing";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("_Report an Issue…");
      action: "app.report-issue";
      hidden-when: "action-missing";
    }

    item {
      label: _("_About Groundhog");
      action: "app.about";
    }
  }

  section {
    item {
      label: _("_Quit");
      action: "app.quit";
    }
  }
}

// Added to the stack as "onboarding" only by builds without account support
// (GROUNDHOG_HAVE_ACCOUNTS=0), where the onboarding flow
// (gh-onboarding-view.blp) cannot run; see gh_sidebar_page_show_onboarding().
Adw.StatusPage onboarding_unavailable {
  icon-name: "mail-unread-symbolic";
  title: _("Welcome to Groundhog");
  description: _("Account support is not included in this build.");
  hexpand: true;
  vexpand: true;

  styles [
    "groundhog-shell-status",
  ]
}
