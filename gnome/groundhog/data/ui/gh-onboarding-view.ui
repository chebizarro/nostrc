                                    <child type="prefix">
                                      <object class="GtkImage">
                                        <property name="icon-name">channel-secure-symbolic</property>
                                        <property name="accessible-role">43</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBox" id="discovery_group">
                                <property name="visible">false</property>
                                <property name="selection-mode">0</property>
                                <style>
                                  <class name="boxed-list"/>
                                </style>
                                <child>
                                  <object class="AdwSwitchRow" id="discovery_switch">
                                    <property name="active">true</property>
                                    <property name="title" translatable="yes">Also Use Them to Find People</property>
                                    <property name="subtitle" translatable="yes">Groundhog needs a relay to find your settings and to look up the people you write to. The relays that keep your list will see whom you look up. You can change this later.</property>
                                    <property name="title-lines">0</property>
                                    <property name="subtitle-lines">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="publish_button">
                                <property name="label" translatable="yes">_Publish</property>
                                <property name="use-underline">true</property>
                                <property name="halign">3</property>
                                <property name="action-name">onboarding.publish</property>
                                <style>
                                  <class name="pill"/>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="AdwNavigationPage" id="publish_page">
            <property name="tag">publish</property>
            <property name="title" translatable="yes">Publishing</property>
            <property name="can-pop">false</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar"></object>
                </child>
                <property name="content">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">2</property>
                    <property name="child">
                      <object class="GtkViewport">
                        <property name="vscroll-policy">1</property>
                        <property name="child">
                          <object class="AdwClamp">
                            <property name="maximum-size">560</property>
                            <property name="tightening-threshold">400</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">1</property>
                                <property name="spacing">18</property>
                                <property name="margin-top">24</property>
                                <property name="margin-bottom">24</property>
                                <property name="margin-start">12</property>
                                <property name="margin-end">12</property>
                                <child>
                                  <object class="GtkImage" id="publish_icon">
                                    <property name="icon-name">emblem-synchronizing-symbolic</property>
                                    <property name="pixel-size">64</property>
                                    <property name="accessible-role">43</property>
                                    <style>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="publish_title">
                                    <property name="wrap">true</property>
                                    <property name="justify">2</property>
                                    <style>
                                      <class name="title-2"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="publish_description">
                                    <property name="wrap">true</property>
                                    <property name="justify">2</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkListBox" id="result_list">
                                    <property name="selection-mode">0</property>
                                    <style>
                                      <class name="boxed-list"/>
                                    </style>
                                    <accessibility>
                                      <property name="label" translatable="yes">What each relay did</property>
                                    </accessibility>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">1</property>
                                    <property name="spacing">6</property>
                                    <property name="halign">3</property>
                                    <child>
                                      <object class="GtkButton" id="publish_continue">
                                        <property name="visible">false</property>
                                        <property name="label" translatable="yes">_Continue</property>
                                        <property name="use-underline">true</property>
                                        <property name="action-name">onboarding.publish-continue</property>
                                        <style>
                                          <class name="pill"/>
                                          <class name="suggested-action"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="publish_retry">
                                        <property name="visible">false</property>
                                        <property name="label" translatable="yes">_Try Again</property>
                                        <property name="use-underline">true</property>
                                        <property name="action-name">onboarding.retry</property>
                                        <style>
                                          <class name="pill"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="publish_later">
                                        <property name="visible">false</property>
                                        <property name="label" translatable="yes">Set Up _Later</property>
                                        <property name="use-underline">true</property>
                                        <property name="action-name">onboarding.later</property>
                                        <style>
                                          <class name="flat"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="AdwNavigationPage" id="done_page">
            <property name="tag">done</property>
            <property name="title" translatable="yes">All Set</property>
            <property name="can-pop">false</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <property name="show-title">false</property>
                  </object>
                </child>
                <property name="content">
                  <object class="AdwStatusPage" id="done_status">
                    <property name="icon-name">emblem-ok-symbolic</property>
                    <property name="title" translatable="yes">You're All Set</property>
                    <style>
                      <class name="compact"/>
                    </style>
                    <property name="child">
                      <object class="GtkButton" id="done_button">
                        <property name="label" translatable="yes">_Start Using Groundhog</property>
                        <property name="use-underline">true</property>
                        <property name="halign">3</property>
                        <property name="action-name">onboarding.finish</property>
                        <style>
                          <class name="pill"/>
                          <class name="suggested-action"/>
                        </style>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>