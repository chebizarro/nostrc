using Gtk 4.0;

// One message of the interim read-only list in gh-content-page.blp, until
// the conversation view (charter G12) replaces it with bubbles. The closures
// are registered by gh-conversation-list.c. The body is plain text: markup
// is never interpreted (charter PT-3).
template ListItem {
  activatable: false;
  accessible-label: bind $gh_message_item_accessible_label(template.item) as <string>;

  child: Box {
    orientation: vertical;
    spacing: 3;
    margin-top: 6;
    margin-bottom: 6;
    margin-start: 12;
    margin-end: 12;

    Label {
      label: bind $gh_message_item_heading(template.item) as <string>;
      xalign: 0;
      ellipsize: end;

      styles [
        "caption-heading",
        "dim-label",
      ]
    }

    Label {
      label: bind template.item as <$GhMessage>.body;
      use-markup: false;
      xalign: 0;
      wrap: true;
      wrap-mode: word_char;
    }
  };
}
