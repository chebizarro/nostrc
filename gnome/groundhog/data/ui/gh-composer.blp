using Gtk 4.0;

// The composer under a conversation (charter §7.4, §7.7, G13), driven by
// gh-composer.c: the "edit" page is the multiline entry with its
// "Message" placeholder (GtkTextView has none at GTK 4.14), the emoji
// button and the Send button; "disabled" says why nothing can be sent right
// now, with an optional action. An inline error above the entry says when a
// text is too long to send privately or could not be queued. It sits in a
// plain box under the message list (gh-content-page.blp), not in a toolbar
// bottom bar, so a wrapped reason gets the height of every line on
// libadwaita 1.5 too.
template $GhComposer: Widget {
  layout-manager: BinLayout {};

  styles [
    "groundhog-composer",
  ]

  Stack composer_stack {
    hhomogeneous: false;
    vhomogeneous: false;

    StackPage {
      name: "edit";

      child: Box {
        orientation: vertical;
        spacing: 4;

        Label error_label {
          visible: false;
          wrap: true;
          wrap-mode: word_char;
          xalign: 0;

          styles [
            "caption",
            "error",
            "groundhog-composer-error",
          ]
        }

        Box edit_row {
          spacing: 6;

          // The conversation's disappearing-messages timer (charter §3.7,
          // G07), shown before sending while it is on; the text and the
          // accessible label are set from C. It opens Conversation Info
          // (win.conversation-info), where the timer is changed.
          Box timer_slot {
            visible: false;
            valign: end;

            Button timer_button {
              action-name: "win.conversation-info";

              child: Box {
                spacing: 4;

                Image {
                  icon-name: "alarm-symbolic";
                  accessible-role: presentation;
                }

                Label timer_label {
                  accessible-role: presentation;

                  styles [
                    "caption",
                    "numeric",
                  ]
                }
              };

              styles [
                "flat",
                "groundhog-composer-timer",
              ]
            }
          }

          Overlay {
            hexpand: true;

            child: ScrolledWindow scroller {
              hscrollbar-policy: never;
              propagate-natural-height: true;

              styles [
                "groundhog-composer-entry",
              ]

              child: TextView text_view {
                wrap-mode: word_char;
                accepts-tab: false;
                top-margin: 7;
                bottom-margin: 7;
                left-margin: 12;
                right-margin: 12;

                accessibility {
                  label: _("Message");
                }

                styles [
                  "groundhog-composer-text",
                ]
              };
            };

            [overlay]
            Label placeholder {
              label: _("Message");
              xalign: 0;
              halign: start;
              valign: start;
              margin-start: 13;
              margin-top: 8;
              can-target: false;
              accessible-role: presentation;

              styles [
                "dim-label",
              ]
            }
          }

          MenuButton emoji_button {
            valign: end;
            icon-name: "face-smile-symbolic";
            tooltip-text: _("Insert Emoji");

            accessibility {
              label: _("Insert Emoji");
            }

            // gh-composer.c makes the EmojiChooser when first opened.

            styles [
              "flat",
              "circular",
            ]
          }

          // Attach, voice and poll sit with emoji and Send on the right of
          // the entry, all actions on one side (W33, owner; the HIG keeps a
          // composer's actions together).
          // NIP-88 poll creation (W26): shown while in an encrypted group
          // ("can-create-poll"); opens the Create Poll dialog.
          Button poll_button {
            visible: false;
            valign: end;
            icon-name: "view-list-bullet-symbolic";
            tooltip-text: _("Create Poll");
            action-name: "composer.create-poll";
            focus-on-click: false;

            accessibility {
              label: _("Create Poll");
              description: _("Create a poll in this encrypted group.");
            }

            styles [
              "flat",
              "circular",
            ]
          }

          // Attachments (charter G22): shown while the owner can send a
          // file here ("can-attach"); it opens the file chooser. Dropping a
          // file or pasting an image does the same.
          Button attach_button {
            visible: false;
            valign: end;
            icon-name: "mail-attachment-symbolic";
            tooltip-text: _("Attach File");
            action-name: "composer.attach";
            focus-on-click: false;

            accessibility {
              label: _("Attach File");
              description: _("Choose a file to send encrypted. You can also drop a file here or paste an image.");
            }

            styles [
              "flat",
              "circular",
            ]
          }


          // Voice recording (W27 voice, nostrc-o1kl): shown while the
          // owner can record a voice message here ("can-record-voice");
          // emits "record-voice-requested" for the owner's recorder.
          Button voice_button {
            visible: false;
            valign: end;
            icon-name: "microphone-sensitivity-high-symbolic";
            tooltip-text: _("Record Voice Message");
            action-name: "composer.record-voice";
            focus-on-click: false;

            accessibility {
              label: _("Record Voice Message");
              description: _("Record a voice message to send encrypted.");
            }

            styles [
              "flat",
              "circular",
            ]
          }

          Button send_button {
            valign: end;
            icon-name: "send-symbolic";
            tooltip-text: _("Send");
            action-name: "composer.send";
            focus-on-click: false;

            accessibility {
              label: _("Send");
            }

            styles [
              "circular",
              "suggested-action",
              "groundhog-send-button",
            ]
          }
        }
      };
    }

    // W27 voice recording (nostrc-4h64): visible while a voice message is
    // being recorded. Shows a level meter, elapsed timer, cancel and stop
    // buttons. Escape cancels; the stop button sends the recording.
    StackPage {
      name: "recording";

      child: Box {
        spacing: 6;

        styles [
          "groundhog-composer-recording",
        ]

        Image recording_icon {
          icon-name: "microphone-sensitivity-high-symbolic";
          pixel-size: 16;
          valign: center;

          styles [
            "error",
          ]
        }

        Label recording_label {
          label: _("Recording…");
          hexpand: true;
          xalign: 0;
          valign: center;

          styles [
            "caption",
          ]
        }

        Label recording_time {
          label: "0:00";
          valign: center;

          styles [
            "caption",
            "numeric",
          ]
        }

        LevelBar recording_level {
          min-value: 0;
          max-value: 1;
          value: 0;
          valign: center;
          hexpand: false;

          styles [
            "groundhog-recording-level",
          ]
        }

        Button cancel_recording_button {
          valign: center;
          label: _("_Cancel");
          use-underline: true;
          action-name: "composer.cancel-recording";

          accessibility {
            label: _("Cancel Recording");
          }

          styles [
            "flat",
          ]
        }

        Button stop_recording_button {
          valign: center;
          icon-name: "media-playback-stop-symbolic";
          tooltip-text: _("Send Voice Message");
          action-name: "composer.stop-recording";

          accessibility {
            label: _("Stop and send voice message");
          }

          styles [
            "circular",
            "suggested-action",
          ]
        }
      };
    }

    StackPage {
      name: "disabled";

      child: Box {
        spacing: 12;
        halign: center;

        styles [
          "groundhog-composer-disabled",
        ]

        Label disabled_reason {
          wrap: true;
          wrap-mode: word_char;
          justify: center;
          hexpand: true;

          styles [
            "dim-label",
          ]
        }

        Button disabled_button {
          visible: false;
          valign: center;
          use-underline: true;
        }
      };
    }
  }
}
