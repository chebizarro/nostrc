using Gtk 4.0;
using Adw 1;

// One conversation in the sidebar list (charter §7.4, §7.5), bound to a
// GhConversation by gh-conversation-row.c, which also composes the list
// item's accessible label. The avatar only ever shows initials: no picture
// is loaded (charter PD-2), and a request never triggers a profile fetch.
// Its context menu (right click, long press, Shift+F10 or Menu; charter
// §7.4, §7.13; nostrc-qp24.74, qp24.86) is context_popover. A pinned
// conversation shows pinned_icon (its accessible text is the row's).
template $GhConversationRow: Widget {
  layout-manager: BoxLayout {
    spacing: 12;
  };

  styles [
    "groundhog-conversation-row",
  ]

  Adw.Avatar avatar {
    size: 40;
    show-initials: true;
    valign: center;
    accessible-role: presentation;
  }

  Box {
    orientation: vertical;
    valign: center;
    hexpand: true;
    spacing: 2;

    Box {
      spacing: 6;

      // Charter §7.5 kind glyph: a relay group (NIP-29) is marked, and says
      // it is not end-to-end encrypted (tooltip and label set from C, from
      // gh_privacy_summary_kind()).
      Image kind_icon {
        icon-name: "network-workgroup-symbolic";
        visible: false;
        valign: center;

        styles [
          "dim-label",
        ]
      }

      Label title_label {
        xalign: 0;
        hexpand: true;
        ellipsize: end;
        single-line-mode: true;

        styles [
          "groundhog-conversation-title",
        ]
      }

      Image pinned_icon {
        icon-name: "view-pin-symbolic";
        visible: false;
        valign: center;
        tooltip-text: _("Pinned");
        accessible-role: presentation;

        styles [
          "dim-label",
        ]
      }

      Label time_label {
        valign: baseline;

        styles [
          "caption",
          "numeric",
          "dim-label",
        ]
      }
    }

    Box {
      spacing: 6;

      // The newest message's first line when previews are shown (see
      // GhSidebarPage show-previews), after a request's subject, which is
      // only ever secondary text here (charter §7.9); else empty. Keeps its
      // line so rows stay one height.
      Label preview_label {
        xalign: 0;
        hexpand: true;
        ellipsize: end;
        single-line-mode: true;

        styles [
          "dim-label",
        ]
      }

      Label request_label {
        label: _("Request");
        visible: false;
        valign: center;

        styles [
          "caption",
          "groundhog-request-tag",
        ]
      }

      Label unread_badge {
        visible: false;
        valign: center;

        styles [
          "groundhog-unread-badge",
          "numeric",
        ]
      }
    }
  }

  // Not laid out by the box layout (a popover is its own surface).
  PopoverMenu context_popover {
    menu-model: context_menu;
    has-arrow: false;
    halign: start;
  }
}

// Row actions (gh-conversation-row.c) forward to the window's
// win.pin-conversation, win.unpin-conversation, win.mark-conversation-read,
// win.mark-conversation-unread, win.mute-conversation,
// win.show-conversation-info and win.delete-conversation with this row's
// room (gh-conversation-menu.c). Each pair shows the one that applies;
// a message request has no Pin, Mark or Mute (it is never notified).
menu context_menu {
  section {
    item {
      label: _("_Pin");
      action: "row.pin";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Un_pin");
      action: "row.unpin";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Mark as _Read");
      action: "row.mark-read";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Mark as _Unread");
      action: "row.mark-unread";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("_Mute…");
      action: "row.mute";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Conversation _Info");
      action: "row.info";
    }
  }

  section {
    item {
      label: _("_Delete…");
      action: "row.delete";
    }
  }
}
