using Gtk 4.0;

// One item of the conversation's message list (gh-conversation-view.blp,
// charter §7.4): a GhTimelineRow bound to its GhTimelineItem (a message's
// GhMessageRow, or a local event such as a timer change, nostrc-qp24.83),
// whose composed text is the item's accessible label. A file of its own,
// loaded by the list's factory from the resource, so no Blueprint output
// nests inside another (blueprint-compiler 0.12 and newer write nested
// templates differently).
template ListItem {
  activatable: false;
  selectable: false;
  accessible-label: bind template.child as <$GhTimelineRow>.summary;

  child: $GhTimelineRow {
    item: bind template.item;
  };
}
