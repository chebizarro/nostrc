                <property name="xalign">0</property>
                <property name="margin-top">12</property>
                <style>
                  <class name="error"/>
                  <class name="caption"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="proxy_note">
                <property name="label" translatable="yes">Groundhog doesn't use proxy settings yet: it connects to relays directly, so relays and your network can see your IP address.</property>
                <property name="wrap">true</property>
                <property name="xalign">0</property>
                <property name="margin-top">12</property>
                <style>
                  <class name="dim-label"/>
                  <class name="caption"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="tor_unavailable_note">
                <property name="label" translatable="yes">Tor isn't available in this build, so Groundhog won't connect until you choose another network setting.</property>
                <property name="visible">false</property>
                <property name="wrap">true</property>
                <property name="xalign">0</property>
                <property name="margin-top">12</property>
                <style>
                  <class name="warning"/>
                  <class name="caption"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="tor_note">
                <property name="label" translatable="yes">Tor hides your IP address from relays and from the servers Groundhog asks to check an address, and hides which relays you use from your network. Links you open go to your web browser, which doesn't use Groundhog's Tor connection. It doesn't hide your account: relays still see what your account publishes and asks for, and they see your account when you sign in to your own inbox. Your network can see that you use Tor. If Tor can't be reached, Groundhog doesn't connect at all.</property>
                <property name="visible">false</property>
                <property name="wrap">true</property>
                <property name="xalign">0</property>
                <property name="margin-top">12</property>
                <style>
                  <class name="dim-label"/>
                  <class name="caption"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Discovery Relays</property>
            <property name="description" translatable="yes">Groundhog asks these relays for your own relay lists. None are set by default, so Groundhog contacts no relay until you add one. They can see your IP address and which accounts you look up.</property>
