        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Account</property>
            <child>
              <object class="AdwActionRow" id="no_account_row">
                <property name="title" translatable="yes">No Account Selected</property>
                <property name="subtitle" translatable="yes">Choose an account from the main menu</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow" id="account_row">
                <property name="visible">false</property>
                <property name="use-markup">false</property>
