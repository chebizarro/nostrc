                <property name="subtitle" translatable="yes">Groundhog keeps running after its window is closed; Quit stops it. Turning this on here also starts Groundhog when you log in.</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup" id="delete_group">
            <property name="title" translatable="yes">This Device</property>
            <property name="description" translatable="yes">Groundhog keeps your messages on this device only. Private messages can be downloaded again from your relays with your key; encrypted group history can't.</property>
            <property name="visible">false</property>
            <child>
              <object class="AdwActionRow" id="delete_all_row">
                <property name="title" translatable="yes">Delete All Messages on This Device</property>
                <property name="subtitle" translatable="yes">Also signs out of this account here</property>
                <property name="activatable-widget">delete_all_button</property>
                <child type="suffix">
                  <object class="GtkButton" id="delete_all_button">
                    <property name="label" translatable="yes">Delete…</property>
                    <property name="valign">3</property>
                    <property name="action-name">prefs.delete-all</property>
                    <style>
                      <class name="destructive-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
