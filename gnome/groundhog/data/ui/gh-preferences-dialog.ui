            </child>
            <child>
              <object class="AdwSwitchRow" id="message_previews_row">
                <property name="title" translatable="yes">Show Message Previews in List</property>
                <property name="subtitle" translatable="yes">The latest message appears under each conversation</property>
              </object>
            </child>
          </object>
        </child>
