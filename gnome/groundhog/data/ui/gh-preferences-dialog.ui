                <accessibility>
                  <property name="description" translatable="yes">The host and port of Tor's SOCKS proxy, such as 127.0.0.1:9050. Tor Browser uses 127.0.0.1:9150.</property>
                </accessibility>
              </object>
            </child>
            <child>
              <object class="AdwActionRow" id="tor_status_row">
                <property name="title" translatable="yes">Tor Status</property>
                <property name="visible">false</property>
                <property name="subtitle-selectable">true</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="tor_address_error">
