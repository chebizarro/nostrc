  </template>
  <object class="AdwAlertDialog" id="clear_attachments_dialog">
    <property name="heading" translatable="yes">Clear Downloaded Files?</property>
    <property name="body" translatable="yes">Groundhog deletes its decrypted copies of the files you downloaded or sent from this device. The messages stay. Downloading a file again needs the server that holds it, which may have deleted it.</property>
    <property name="default-response">keep</property>
    <property name="close-response">keep</property>
    <responses>
      <response id="keep" translatable="yes">_Cancel</response>
      <response id="clear" translatable="yes" appearance="destructive">_Clear</response>
    </responses>
  </object>
  <object class="AdwAlertDialog" id="delete_all_dialog">
    <property name="heading" translatable="yes">Delete All Messages on This Device?</property>
    <property name="body" translatable="yes">Every message, draft and conversation of this account is deleted from this device, and Groundhog signs out of the account here. Your key stays in Nostr Signer, and Gnostr isn't affected.

Copies stay on relays and on other people's devices. Private messages can be downloaded again from your relays with your key; encrypted group history can't.</property>
    <property name="default-response">cancel</property>
    <property name="close-response">cancel</property>
    <responses>
      <response id="cancel" translatable="yes">_Cancel</response>
      <response id="delete" translatable="yes" appearance="destructive">_Delete and Sign Out</response>
    </responses>
  </object>
</interface>