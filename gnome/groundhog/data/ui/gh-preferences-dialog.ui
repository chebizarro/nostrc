                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Your private key stays in Nostr Signer. Remote signers (NIP-46) aren't supported yet: choosing one makes Groundhog read-only.</property>
