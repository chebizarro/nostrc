        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Attachment Servers</property>
            <property name="description" translatable="yes">Encrypted attachments are stored on these servers. None are set by default, and sending attachments isn't available in this version yet. A server can see your IP address, when you upload or download, and the size of each file.</property>
            <child>
              <object class="GtkBox">
