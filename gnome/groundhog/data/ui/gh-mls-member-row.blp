using Gtk 4.0;
using Adw 1;

// One member of an encrypted group in Group Info (charter §7.10; nostrc-9xf5),
// filled by gh-mls-group-info-dialog.c: the name Groundhog has cached for
// them or their short npub (plain text, never markup), an Owner or Admin
// badge from the group's own admin list, an "Identity not verified" badge
// for a member whose app can't prove their account and whom Groundhog
// couldn't confirm either (nostrc-6ukh; the explanation is the subtitle;
// informative, not an alarm: older apps are like this), Verify for such a
// member (asks relays, confirmed first: W24 review H1), and, only for an
// admin and never for oneself, Remove from Group (confirmed first).
template $GhMlsMemberRow: Adw.ActionRow {
  use-markup: false;
  title-lines: 1;
  subtitle-lines: 1;

  [prefix]
  Adw.Avatar avatar {
    size: 32;
    show-initials: true;
    accessible-role: presentation;
  }

  [suffix]
  Label identity_badge {
    visible: false;
    valign: center;

    styles [
      "caption",
      "dim-label",
      "groundhog-identity-badge",
    ]
  }

  [suffix]
  Button verify_button {
    visible: false;
    valign: center;
    label: _("_Verify");
    use-underline: true;
    tooltip-text: _("Ask relays for a key this person published");
    action-name: "member.verify";

    styles [
      "flat",
    ]
  }

  [suffix]
  Label role_badge {
    visible: false;
    valign: center;

    styles [
      "caption",
      "groundhog-role-badge",
    ]
  }

  [suffix]
  MenuButton remove_button {
    visible: false;
    valign: center;
    icon-name: "view-more-symbolic";
    tooltip-text: _("Member Actions");
    menu-model: member_menu;

    accessibility {
      label: _("Member Actions");
    }

    styles [
      "flat",
    ]
  }
}

menu member_menu {
  section {
    item {
      label: _("_Hide Account…");
      action: "member.hide-account";
      hidden-when: "action-disabled";
    }
    item {
      label: _("_Report Account…");
      action: "member.report-account";
      hidden-when: "action-disabled";
    }
    item {
      label: _("_Remove from Group…");
      action: "member.remove";
      hidden-when: "action-disabled";
    }
  }
}
