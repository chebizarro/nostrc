using Gtk 4.0;
using Adw 1;

// Added to the sidebar stack as "onboarding" only by builds without account
// support (GROUNDHOG_HAVE_ACCOUNTS=0); see gh_sidebar_page_show_onboarding().
Adw.StatusPage onboarding {
  icon-name: "mail-unread-symbolic";
  title: _("Welcome to Groundhog");
  description: _("Account support is not included in this build.");
  hexpand: true;
  vexpand: true;

  styles [
    "groundhog-shell-status",
  ]
}
