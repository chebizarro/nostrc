using Gtk 4.0;
using Adw 1;

// Account-state pages and the account menu, attached to the sidebar by
// gh_account_ui_attach() in builds with account support. Each page's stack
// name and its explicit focus target (the id of the one control that
// receives keyboard/screen-reader focus when the page becomes visible, or
// none) are assigned in gh-account-ui.c next to the state that selects it.
Adw.StatusPage account_discovering {
  icon-name: "content-loading-symbolic";
  title: _("Looking for Accounts");
  description: _("Reading public identity names from the Nostr signer's store. Private keys are never read.");

  styles [
    "groundhog-shell-status",
  ]
}

Adw.StatusPage account_store_unavailable {
  icon-name: "dialog-warning-symbolic";
  title: _("Account Store Unavailable");
  description: _("Groundhog could not read the signer's identity list. Unlock the keyring or start the Nostr signer, then try again.");

  styles [
    "groundhog-shell-status",
  ]

  child: Button account_store_unavailable_retry {
    label: _("_Try Again");
    use-underline: true;
    halign: center;
    action-name: "account.refresh";

    styles [
      "pill",
    ]
  };
}

Adw.StatusPage account_none {
  icon-name: "avatar-default-symbolic";
  title: _("No Nostr Identities");
  description: _("Add or import a key with the Nostr signer, then refresh. Groundhog never stores or reads private keys.");

  styles [
    "groundhog-shell-status",
  ]

  child: Button account_none_refresh {
    label: _("_Refresh");
    use-underline: true;
    halign: center;
    action-name: "account.refresh";

    styles [
      "pill",
    ]
  };
}

Adw.StatusPage account_unselected {
  icon-name: "avatar-default-symbolic";
  title: _("Choose an Account");
  description: _("Pick an identity to use here. This choice is Groundhog's own and does not change Gnostr. You can switch later from the main menu.");

  styles [
    "groundhog-shell-status",
  ]

  // Focus target: the same menu as the main menu's Account entry.
  child: MenuButton account_choose_button {
    label: _("_Choose Account…");
    use-underline: true;
    halign: center;
    menu-model: account_menu;

    styles [
      "pill",
      "suggested-action",
    ]
  };
}

Adw.StatusPage account_missing {
  icon-name: "dialog-warning-symbolic";
  title: _("Account Unavailable");
  description: _("The selected identity is no longer in the signer's store. Choose another account or refresh.");

  styles [
    "groundhog-shell-status",
  ]

  child: Button account_missing_refresh {
    label: _("_Refresh");
    use-underline: true;
    halign: center;
    action-name: "account.refresh";

    styles [
      "pill",
    ]
  };
}

// The first section of the sidebar's main menu (gh-account-ui.c): the
// account switcher lives there rather than in its own header button, so the
// sidebar header keeps room for its title down to the 280 px sidebar and the
// 360 px window (nostrc-qp24.70).
menu account_section {
  submenu account_menu {
    label: _("_Account");

    // Filled from the signer's identity list by gh-account-ui.c.
    section identities {}

    section {
      item {
        label: _("No Account (Read-Only)");
        action: "account.select";
        target: "";
      }

      item {
        label: _("Add Remote Signer…");
        action: "account.add-remote";
      }

      item {
        label: _("Remove Remote Signer…");
        action: "account.remove-remote";
      }

      item {
        label: _("_Refresh Accounts");
        action: "account.refresh";
      }
    }
  }
}
