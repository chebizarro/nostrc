using Gtk 4.0;
using Adw 1;

// One message of a conversation (charter §7.4, §7.6), bound by
// gh-message-row.c: the sender's name (first message of a run in a
// multi-party room), the bubble, the link preview area and the meta line.
// The body is safe escaped Markdown from gh-link-policy.c: custom link labels
// cannot conceal a destination; only visible raw addresses are links.
// Nothing is loaded from the web until "Show Preview" is chosen (charter
// §2.1, D13). gh-message-row.c aligns the parts (end for your own messages),
// sets the run classes and composes the accessible text.
template $GhMessageRow: Widget {
  layout-manager: BoxLayout {
    orientation: vertical;
    spacing: 2;
  };

  styles [
    "groundhog-message-row",
  ]

  // xalign 0 is the start edge: GTK mirrors it for RTL, and
  // gh-message-row.c gives the sender, body and reference labels the
  // direction of their own text (gh-bidi.h, nostrc-gofet.10).
  Label sender_label {
    visible: false;
    xalign: 0;
    ellipsize: middle;
    halign: start;

    styles [
      "caption-heading",
      "groundhog-message-sender",
    ]
  }

  // Reply headers are inserted here only for replies (nostrc-zjkv).
  // W33: the sender's round avatar beside the bubble, on its side, shown at
  // the end of a run (space kept on the other rows so bubbles line up).
  Box bubble_line {
    spacing: 6;

    Adw.Avatar avatar {
      size: 32;
      valign: end;
      show-initials: true;
    }

    Box bubble {
      orientation: vertical;
      spacing: 6;

      styles [
        "message-bubble",
      ]

      Label body_label {
        use-markup: true;
        selectable: true;
        wrap: true;
        wrap-mode: word_char;
        xalign: 0;
        max-width-chars: 60;

        styles [
          "groundhog-message-body",
        ]
      }

      Button copy_button {
        icon-name: "edit-copy-symbolic";
        halign: end;
        action-name: "conversation.copy-message";
        tooltip-text: _("Copy message. The clipboard may be visible to other applications.");
        styles ["flat", "groundhog-copy-button"]
      }

      // A NIP-88 poll (kind 1068): the card shows the question, option
      // buttons with tallies, vote count, remaining time, closed state.
      // The card widget is a GhPollCard, set by gh-message-row.c when the
      // message is a poll and a GhMlsPoll is available.
      Box poll_slot {
        visible: false;
        orientation: vertical;
        spacing: 6;
      }

      // W27 voice messages (nostrc-h4mk): when a file message carries an
      // audio MIME type, this slot shows a GhVoiceBubble instead of the
      // attachment card. The voice bubble is added by gh-message-row.c when
      // it detects an audio attachment; it stays here across recycling.
      Box voice_slot {
        visible: false;
        orientation: vertical;
        spacing: 6;
      }

      // A kind-15 file message's card (charter G22), in place of the body:
      // nothing is fetched until its Download button. An encrypted group
      // message (W25) shows its caption above and one card per file; the
      // further cards are added after this one by gh-message-row.c, and the
      // note says when a file reference couldn't be read.
      Box attachment_slot {
        visible: false;
        orientation: vertical;
        spacing: 6;

        // Attachment cards and rejection note are added only for file messages.
      }
    }
  }

  // Parsed NIP-21/NIP-18 reference, never fetched while the row binds.
  Box reference_box {
    visible: false;
    orientation: vertical;
    spacing: 4;
    styles ["card", "groundhog-reference"]

    // The shared NIP-18/NIP-21 card (nostr-gtk): local lookup only; its
    // Find on Relays asks for consent before any relay is contacted.
    $GnNostrReferenceCard reference_card {
      hexpand: true;
    }

    Button reference_copy_button {
      icon-name: "edit-copy-symbolic";
      tooltip-text: _("Copy Nostr address");
      halign: start;
      action-name: "conversation.open-link";
      action-target: "''";
      styles ["flat"]
    }

    Button share_reference_button {
      label: _("Share in Chat");
      halign: start;
      action-name: "conversation.share-reference";
      action-target: "''";
      styles ["flat"]
    }

    Box public_actions {
      spacing: 6;
      visible: false;
      Button repost_reference_button {
        label: _("Repost");
        action-name: "conversation.repost-reference";

        accessibility {
          description: _("Opens a preview before anything is published publicly");
        }

        action-target: "''";
        styles ["flat"]
      }
      Button quote_reference_button {
        label: _("Quote…");
        action-name: "conversation.quote-reference";

        accessibility {
          description: _("Opens a preview before anything is published publicly");
        }

        action-target: "''";
        styles ["flat"]
      }
    }
  }

  // Remote-image controls and content are inserted only when needed.
  Box web_box {
    orientation: vertical;
    spacing: 6;
  }

  Box preview_box {
    visible: false;
    orientation: vertical;
    spacing: 2;
    styles ["groundhog-link-preview"]
  }

  // The meta line, one order mirrored by side (nostrc-l1kn6.5), set by
  // gh-message-row.c: the status sits at the bubble's edge, then any
  // reaction chips, then React outermost. Incoming:
  // [time][Try Again][chips…][React]; own: [React][chips…][Try Again]
  // [time][receipt], so the receipt ends where the bubble does.
  Box meta_box {
    spacing: 4;

    styles [
      "groundhog-message-meta",
    ]

    // When it was written (and when it disappears) and, for your own
    // messages, whether it arrived. Read in the same order on both sides.
    Box status_box {
      spacing: 4;
      valign: center;

      Image timer_icon {
        visible: false;
        icon-name: "alarm-symbolic";
        pixel-size: 12;
        valign: center;

        styles [
          "dim-label",
        ]
      }

      // NIP-04 warning is added only on legacy messages.
      Label time_label {
        valign: center;

        styles [
          "caption",
          "numeric",
          "dim-label",
        ]
      }

      $GhDeliveryIndicator delivery {
        valign: center;
      }
    }

    Button retry_button {
      visible: false;
      label: _("_Try Again");
      use-underline: true;
      valign: center;
      action-name: "conversation.retry-message";
      tooltip-text: _("Send this message again");

      styles [
        "flat",
        "groundhog-retry-button",
      ]
    }

    // Reaction chips are added only when a summary has reactions.
    Button react_button {
      icon-name: "face-smile-symbolic";
      valign: center;
      action-name: "conversation.add-reaction";
      tooltip-text: _("React");

      accessibility {
        label: _("Add Reaction");
      }


      styles [
        "flat",
        "groundhog-react-button",
      ]
    }
  }
}
