using Gtk 4.0;

// The separator above the first message of each local calendar day of a
// conversation (charter §7.4): "Today", "Yesterday", a weekday within the
// last week, or the localized date (GhTimelineItem:day-label). A header
// factory of its own because blueprint-compiler 0.12 cannot nest a
// ListHeader template in gh-conversation-view.blp; gh-conversation-view.c
// loads it from the resource.
template ListHeader {
  child: Label {
    label: bind template.item as <$GhTimelineItem>.day-label;
    halign: center;
    margin-top: 12;
    margin-bottom: 4;

    styles [
      "caption-heading",
      "dim-label",
      "groundhog-day-separator",
    ]
  };
}
