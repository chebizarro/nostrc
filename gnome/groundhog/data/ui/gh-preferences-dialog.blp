using Gtk 4.0;
using Adw 1;

// Preferences (privacy charter §7.11, G17), opened by app.preferences (Ctrl+,).
// Every row is bound to one org.nostr.Groundhog key in gh-preferences-dialog.c,
// which lists the key behind each row id; the defaults are the schema's
// privacy-preserving ones (G01), and the copy says who learns what (§2.2, P9).
// No fake support (W13b review B2): C leaves a row unbound, insensitive and
// "Not available in this version yet" while the build lacks its feature
// (gh-preferences-dialog.h), sets the notification rows' sensitivity, and
// removes the Tor choice and keeps the Tor address row hidden until G09's
// transport exists. The relay and server rows, the account row's text, the
// Disappearing Messages description and the deletion result are filled in
// from C.
template $GhPreferencesDialog: Adw.PreferencesDialog {
  Adw.PreferencesPage privacy_page {
    name: "privacy";
    title: _("Privacy");
    icon-name: "preferences-system-privacy-symbolic";

    Adw.PreferencesGroup {
      title: _("Notifications");

      Adw.SwitchRow notifications_row {
        title: _("Notifications");
        subtitle: _("Tell me when new messages arrive");
      }

      // Explanations go in the footer: a subtitle would squeeze the value.
      // Sensitive only while notifications are on (set from C).
      Adw.ComboRow notification_privacy_row {
        title: _("Notification Content");

        model: StringList {
          strings [
            _("Hidden"),
            _("Sender Name"),
            _("Sender and Message"),
          ]
        };
      }

      Adw.SwitchRow sound_row {
        title: _("Sound");
      }

      Label notifications_note {
        label: _("Hidden notifications only say how many messages are new, not who sent them. Message requests are always hidden. On the lock screen, GNOME shows message details only if you allow it in Settings → Notifications.");
        wrap: true;
        xalign: 0;
        margin-top: 12;

        styles [
          "dim-label",
          "caption",
        ]
      }
    }

    Adw.PreferencesGroup {
      title: _("Web Content");
      description: _("Nothing is loaded from the web unless you ask for it.");

      Adw.SwitchRow remote_images_row {
        title: _("Load Images in Messages");
        subtitle: _("Without asking each time");
      }

      Adw.SwitchRow link_previews_row {
        title: _("Link Previews");
        subtitle: _("Without asking each time");
      }

      Adw.SwitchRow profile_pictures_row {
        title: _("Load Profile Pictures");
      }

      // Hidden while nothing here can load; without Tor its text drops the
      // Tor clause (set from C).
      Label web_note {
        label: _("Loading anything from the web shows your IP address to that website unless you use Tor.");
        wrap: true;
        xalign: 0;
        margin-top: 12;

        styles [
          "dim-label",
          "caption",
        ]
      }
    }

    Adw.PreferencesGroup {
      title: _("Conversations");

      Adw.SwitchRow filter_unknown_senders_row {
        title: _("Filter Unknown Senders");
        subtitle: _("Messages from people you haven't accepted go to Message Requests, without notifications or profile lookups");
      }

      Adw.SwitchRow verified_mls_groups_row {
        title: _("Only join groups where every member's app proves their account");
        subtitle: _("Refuses people whose app can't prove their account, like older White Noise or Amethyst, even if Groundhog verified them another way. If an admin adds one to a group you're in, you can't read its new messages.");
      }

      Adw.SwitchRow message_previews_row {
        title: _("Show Message Previews in List");
        subtitle: _("The latest message appears under each conversation");
      }
    }

    // Shown when the account's encrypted store can list its blocks
    // (gh_blocked_page_attach(), nostrc-qp24.72).
    Adw.PreferencesGroup blocked_group {
      visible: false;

      Adw.ActionRow blocked_row {
        title: _("Blocked Conversations");
        subtitle: _("Blocked on this device only");
        activatable: true;

        [suffix]
        Image {
          icon-name: "go-next-symbolic";
          accessible-role: presentation;
        }
      }
    }
  }

  Adw.PreferencesPage messages_page {
    name: "messages";
    title: _("Messages");
    icon-name: "mail-unread-symbolic";

    Adw.PreferencesGroup {
      title: _("Sending");

      Adw.SwitchRow enter_sends_row {
        title: _("Send with Enter");
        subtitle: _("When off, Ctrl+Enter sends and Enter starts a new line");
      }
    }

    // Its description says what this build does (set from C).
    Adw.PreferencesGroup disappearing_group {
      title: _("Disappearing Messages");

      Adw.ComboRow disappearing_row {
        title: _("Default Timer");
        subtitle: _("Only for new conversations you start. Ones others start begin without it, and existing conversations keep their own timer.");

        model: StringList {
          strings [
            _("Off"),
            _("1 Day"),
            _("1 Week"),
            _("4 Weeks"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("History");

      Adw.ComboRow retention_row {
        title: _("Keep Messages");
        subtitle: _("Messages received longer ago are deleted from this device only; relays may still hold encrypted copies");

        model: StringList {
          strings [
            _("Forever"),
            _("1 Year"),
            _("30 Days"),
          ]
        };
      }
    }

    // Attachments (charter §6, §7.11, G22): the Blossom servers in the order
    // they are tried, each with Move Up, Move Down and Remove (and, where the
    // account consented to upload as itself, Revoke), the largest file, and
    // the decrypted copies kept on this device with Clear. The description
    // (what a server learns, for this build) and the rows' text are set from
    // C; without the feature the list is shown and not editable.
    Adw.PreferencesGroup attachments_group {
      title: _("Attachments");

      Box {
        orientation: vertical;
        spacing: 12;

        ListBox blossom_list {
          selection-mode: none;

          styles [
            "boxed-list",
          ]

          accessibility {
            label: _("Attachment servers");
          }

          [placeholder]
          Label {
            label: _("No attachment servers");
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;

            styles [
              "dim-label",
            ]
          }
        }

        ListBox {
          selection-mode: none;

          styles [
            "boxed-list",
          ]

          Adw.EntryRow blossom_entry {
            title: _("Add Server");
            show-apply-button: true;
            input-purpose: url;
          }
        }

        Label blossom_error {
          visible: false;
          wrap: true;
          xalign: 0;

          styles [
            "error",
            "caption",
          ]
        }

        // Shown with gh_preferences_dialog_set_attachments().
        ListBox attachment_info_list {
          visible: false;
          selection-mode: none;

          styles [
            "boxed-list",
          ]

          Adw.ActionRow attachment_limit_row {
            title: _("Largest File");
            subtitle-selectable: true;
          }

          Adw.ActionRow attachment_cache_row {
            title: _("Downloaded Files");

            [suffix]
            Button attachment_clear_button {
              label: _("_Clear…");
              use-underline: true;
              valign: center;
              action-name: "prefs.clear-attachments";

              accessibility {
                description: _("Deletes the decrypted copies of downloaded and sent files from this device");
              }
            }
          }
        }
      }
    }
  }

  Adw.PreferencesPage network_page {
    name: "network";
    title: _("Network");
    icon-name: "network-workgroup-symbolic";

    Adw.PreferencesGroup {
      title: _("Connection");

      Adw.ComboRow network_mode_row {
        title: _("Connection");

        // The last item is removed from C in a build without G09.
        model: StringList {
          strings [
            _("System Settings"),
            _("No Proxy"),
            _("Tor"),
          ]
        };
      }

      Adw.EntryRow tor_address_row {
        title: _("Tor Proxy Address");
        visible: false;
        show-apply-button: true;

        accessibility {
          description: _("The host and port of Tor's SOCKS proxy, such as 127.0.0.1:9050. Tor Browser uses 127.0.0.1:9150.");
        }
      }

      // G09: whether a SOCKS proxy answers at the Tor address; set from C.
      Adw.ActionRow tor_status_row {
        title: _("Tor Status");
        visible: false;
        subtitle-selectable: true;
      }

      Label tor_address_error {
        visible: false;
        wrap: true;
        xalign: 0;
        margin-top: 12;

        styles [
          "error",
          "caption",
        ]
      }

      // Outside Tor mode, who sees your IP address; the C code sets the copy for
      // the chosen mode (charter §0.3, §4.1, §4.2). This text is the one of a
      // build without G09, where relay connections ignore every proxy setting.
      Label proxy_note {
        label: _("Groundhog doesn't use proxy settings yet: it connects to relays directly, so relays and your network can see your IP address.");
        wrap: true;
        xalign: 0;
        margin-top: 12;

        styles [
          "dim-label",
          "caption",
        ]
      }

      // A build without G09 whose stored mode is Tor (or one it doesn't know):
      // it connects to nothing until another mode is chosen (charter P5).
      // Shown from C instead of proxy_note.
      Label tor_unavailable_note {
        label: _("Tor isn't available in this build, so Groundhog won't connect until you choose another network setting.");
        visible: false;
        wrap: true;
        xalign: 0;
        margin-top: 12;

        styles [
          "warning",
          "caption",
        ]
      }

      // Tor mode: what Tor changes and what it doesn't (charter §2.2, surface 5).
      Label tor_note {
        label: _("Tor hides your IP address from relays and from the servers Groundhog asks to check an address, and hides which relays you use from your network. Links you open go to your web browser, which doesn't use Groundhog's Tor connection. It doesn't hide your account: relays still see what your account publishes and asks for, and they see your account when you sign in to your own inbox. Your network can see that you use Tor. If Tor can't be reached, Groundhog doesn't connect at all.");
        visible: false;
        wrap: true;
        xalign: 0;
        margin-top: 12;

        styles [
          "dim-label",
          "caption",
        ]
      }
    }

    Adw.PreferencesGroup {
      title: _("Discovery Relays");
      description: _("Groundhog asks these relays for your own relay lists. None are set by default, so Groundhog contacts no relay until you add one. They can see your IP address and which accounts you look up.");

      Box {
        orientation: vertical;
        spacing: 12;

        ListBox discovery_list {
          selection-mode: none;

          styles [
            "boxed-list",
          ]

          accessibility {
            label: _("Discovery relays");
          }

          [placeholder]
          Label {
            label: _("No discovery relays");
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;

            styles [
              "dim-label",
            ]
          }
        }

        ListBox {
          selection-mode: none;

          styles [
            "boxed-list",
          ]

          Adw.EntryRow discovery_entry {
            title: _("Add Relay");
            show-apply-button: true;
            input-purpose: url;
          }
        }

        Label discovery_error {
          visible: false;
          wrap: true;
          xalign: 0;

          styles [
            "error",
            "caption",
          ]
        }
      }
    }

    // Whether people can invite the account to encrypted groups: its
    // KeyPackage state (nostrc-f8a5, nostrc-0bdg); shown with the
    // ENCRYPTED_GROUPS feature once the state is known
    // (gh_preferences_dialog_set_key_package_state()).
    Adw.PreferencesGroup key_package_group {
      visible: false;
      title: _("Encrypted Groups");

      Adw.ActionRow key_package_row {
        title: _("Invitations");
        subtitle-lines: 0;

        [suffix]
        Button key_package_setup {
          visible: false;
          label: _("_Set Up");
          use-underline: true;
          valign: center;
          action-name: "prefs.setup-relays";
        }
      }
    }
  }

  Adw.PreferencesPage account_page {
    name: "account";
    title: _("Account");
    icon-name: "avatar-default-symbolic";

    Adw.PreferencesGroup {
      title: _("Account");

      Adw.ActionRow no_account_row {
        title: _("No Account Selected");
        subtitle: _("Choose an account from the main menu");
      }

      // Title (name or short npub) and subtitle (npub) are set from C.
      Adw.ActionRow account_row {
        visible: false;
        use-markup: false;
        subtitle-selectable: true;

        [prefix]
        Adw.Avatar account_avatar {
          size: 32;
          show-initials: true;
        }
      }

      Adw.ComboRow signer_row {
        title: _("Signer");

        model: StringList {
          strings [
            _("Automatic"),
            _("Nostr Signer"),
            _("Nostr Signer (NIP-55L)"),
            _("Remote Signer (NIP-46)"),
          ]
        };
      }

      Label {
        label: _("Your private key stays in Nostr Signer. Remote signers (NIP-46) aren't supported yet: choosing one makes Groundhog read-only.");
        wrap: true;
        xalign: 0;
        margin-top: 12;

        styles [
          "dim-label",
          "caption",
        ]
      }
    }

    Adw.PreferencesGroup {
      title: _("Background");

      // Turning it on here is the confirmed choice that also writes the
      // autostart entry (G15, P9).
      Adw.SwitchRow run_in_background_row {
        title: _("Receive Messages When Closed");
        subtitle: _("Groundhog keeps running after its window is closed; Quit stops it. Turning this on here also starts Groundhog when you log in.");
      }
    }

    // Shown only with an active account and the encrypted store (charter §3.8).
    Adw.PreferencesGroup delete_group {
      title: _("This Device");
      description: _("Groundhog keeps your messages on this device only. Private messages can be downloaded again from your relays with your key; encrypted group history can't.");
      visible: false;

      Adw.ActionRow delete_all_row {
        title: _("Delete All Messages on This Device");
        subtitle: _("Also signs out of this account here");
        activatable-widget: delete_all_button;

        [suffix]
        Button delete_all_button {
          label: _("Delete…");
          valign: center;
          action-name: "prefs.delete-all";

          styles [
            "destructive-action",
          ]
        }
      }
    }
  }
}

// Confirmation for prefs.clear-attachments (G22): the encrypted cache of
// decrypted files, emptied. Response ids are file-wide object ids for
// blueprint-compiler 0.12, so they differ from delete_all_dialog's.
Adw.AlertDialog clear_attachments_dialog {
  heading: _("Clear Downloaded Files?");
  body: _("Groundhog deletes its decrypted copies of the files you downloaded or sent from this device. The messages stay. Downloading a file again needs the server that holds it, which may have deleted it.");
  default-response: "keep";
  close-response: "keep";

  responses [
    keep: _("_Cancel"),
    clear: _("_Clear") destructive,
  ]
}

// Confirmation for prefs.delete-all: the account store's forget (ST-8).
Adw.AlertDialog delete_all_dialog {
  heading: _("Delete All Messages on This Device?");
  body: _("Every message, draft and conversation of this account is deleted from this device, and Groundhog signs out of the account here. Your key stays in Nostr Signer, and Gnostr isn't affected.\n\nCopies stay on relays and on other people's devices. Private messages can be downloaded again from your relays with your key; encrypted group history can't.");
  default-response: "cancel";
  close-response: "cancel";

  responses [
    cancel: _("_Cancel"),
    delete: _("_Delete and Sign Out") destructive,
  ]
}
