# Checks that every Groundhog packaging file names VERSION (CMake's
# GROUNDHOG_VERSION_FULL, e.g. 0.12.0-alpha8), so About, --version, the
# release tag and the packages cannot drift apart.
#   cmake -DVERSION=<version> -DROOT=<repo root> -P CheckPackagingVersion.cmake
if (NOT VERSION OR NOT ROOT)
  message(FATAL_ERROR "usage: cmake -DVERSION=... -DROOT=... -P CheckPackagingVersion.cmake")
endif()
string(REPLACE "-" "~" DEB_VERSION "${VERSION}")
string(REGEX REPLACE "^([0-9.]+)-(.+)$" "\\2" PRERELEASE "${VERSION}")
if (PRERELEASE STREQUAL VERSION)
  set(PRERELEASE "")
endif()
set(failed FALSE)
function(expect file regex what)
  file(READ "${ROOT}/${file}" content)
  if (NOT content MATCHES "${regex}")
    message(SEND_ERROR "${file}: ${what} does not name ${VERSION}")
    set(failed TRUE PARENT_SCOPE)
  endif()
endfunction()
expect(flake.nix "desktopVersion = \"${VERSION}\";" "desktopVersion")
expect(packaging/archlinux/groundhog/PKGBUILD "\n_version=${VERSION}\n" "_version")
expect(packaging/rpm/groundhog.spec "\n%global upstream_version ${VERSION}\n" "upstream_version")
if (PRERELEASE)
  expect(packaging/rpm/groundhog.spec "\nRelease: +0\\.[0-9]+\\.${PRERELEASE}%\\{\\?dist\\}\n" "Release")
endif()
expect(packaging/debian-desktop/changelog "^groundhog \\(${DEB_VERSION}-[0-9]+\\) " "first changelog entry")
if (failed)
  message(FATAL_ERROR "packaging files disagree with GROUNDHOG_VERSION_FULL=${VERSION}")
endif()
message(STATUS "packaging files name ${VERSION}")
