# Shared by the application and the focused, device-free packaging tests.
option(GROUNDHOG_ENABLE_CALLS "Enable GStreamer WebRTC call capabilities when available" ON)
set(_gh_calls_root "${CMAKE_CURRENT_LIST_DIR}/..")
find_package(PkgConfig REQUIRED)
pkg_check_modules(GH_CALL_GLIB REQUIRED IMPORTED_TARGET glib-2.0)
add_library(groundhog-call-capabilities STATIC
  "${_gh_calls_root}/src/media/gh-call-capabilities.c")
target_include_directories(groundhog-call-capabilities PUBLIC "${_gh_calls_root}/src/media")
target_link_libraries(groundhog-call-capabilities PUBLIC PkgConfig::GH_CALL_GLIB)
target_compile_options(groundhog-call-capabilities PRIVATE -Wall -Wextra -Werror)
set(GROUNDHOG_CALLS_AVAILABLE FALSE)
if(GROUNDHOG_ENABLE_CALLS)
  pkg_check_modules(GH_CALL_GST QUIET IMPORTED_TARGET
    gstreamer-webrtc-1.0>=1.20 gstreamer-sdp-1.0>=1.20 nice)
  if(GH_CALL_GST_FOUND)
    set(GROUNDHOG_CALLS_AVAILABLE TRUE)
    target_compile_definitions(groundhog-call-capabilities PUBLIC GROUNDHOG_HAVE_CALLS=1)
    target_link_libraries(groundhog-call-capabilities PUBLIC PkgConfig::GH_CALL_GST)
  endif()
endif()
message(STATUS "Groundhog calls: ${GROUNDHOG_CALLS_AVAILABLE} (option=${GROUNDHOG_ENABLE_CALLS}; requires GStreamer WebRTC/SDP >= 1.20 and libnice; runtime plugins checked separately)")
if(TARGET groundhog)
  target_link_libraries(groundhog PRIVATE groundhog-call-capabilities)
endif()
if(BUILD_TESTING)
  add_executable(test-groundhog-call-capabilities
    "${_gh_calls_root}/tests/media/test_call_capabilities.c")
  target_link_libraries(test-groundhog-call-capabilities PRIVATE groundhog-call-capabilities)
  target_compile_options(test-groundhog-call-capabilities PRIVATE -Wall -Wextra -Werror)
  add_test(NAME groundhog-call-capabilities COMMAND test-groundhog-call-capabilities)
  set_tests_properties(groundhog-call-capabilities PROPERTIES TIMEOUT 30)
  if(GROUNDHOG_CALLS_AVAILABLE)
    add_executable(test-groundhog-call-loopback
      "${_gh_calls_root}/tests/media/test_call_loopback.c")
    target_link_libraries(test-groundhog-call-loopback PRIVATE groundhog-call-capabilities)
    target_compile_definitions(test-groundhog-call-loopback PRIVATE GST_USE_UNSTABLE_API)
    target_compile_options(test-groundhog-call-loopback PRIVATE -Wall -Wextra -Werror)
    add_test(NAME groundhog-call-loopback COMMAND test-groundhog-call-loopback)
    set_tests_properties(groundhog-call-loopback PROPERTIES TIMEOUT 45)
  endif()
endif()
