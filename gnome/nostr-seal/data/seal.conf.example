# nostr-seal defaults — copy to ~/.config/nostr/seal.conf
# (or point $NOSTR_SEAL_CONFIG at it). Every key is optional. The Files page
# of Nostr Settings (org.nostr.Settings) edits this file.

[seal]

# Recipients used by `nostr-seal encrypt FILE` when the command line names
# no --to, --to-self or --passphrase. npub1… or 64-hex, `;` separated.
# The CLI prints that it is using them. A malformed entry is an error.
#default_recipients=npub1alice…;npub1bob…

# Also seal for your signer's active identity in that case (like --to-self).
#include_self=true

# scrypt cost (log2 N) for --passphrase when --work-factor is not given.
# 16 (default, ~64 MiB) … 20 (~1 GiB, very slow to open).
#work_factor=16

# Where `nostr-seal encrypt --publish` / `nostr-seal publish` sends the
# kind-1063 event: direct_only (default: your NIP-65 write relays),
# session_relay_or_direct or session_relay_only. The session relay does not
# forward to other relays yet, so the session modes would keep the event
# on this machine. Discovery relays and the Blossom fallback come from
# ~/.config/nostr-share/nostr-share.conf (home_relays, blossom_servers).
#upstream_mode=direct_only
