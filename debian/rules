#!/usr/bin/make -f
# debian/rules for nostrc phase 1 + phase 5 (portable-home) packaging.
# Phase 1: headless nostr-login stack (D-14) — libnostr (GLib-free ABI),
# NSS/PAM/authd/homectl/SMB/domain, no GTK/GObject/apps/marmot/roaming.
# Phase 5 (bead nostrc-h10m.2): additive portable-home stack —
# libhanami0 + nostr-home-sync (nostr-home-syncd + user unit + fetch
# helper + sysusers snippet) + nostr-home-fuse (FUSE overlay + user
# unit + ignore.d snippet). Gated behind NOSTR_HOMED_ENABLE_PORTHOME_*
# — the headless closure is UNCHANGED (dep-purity check in P5).

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# Phase 5 (bead nostrc-h10m.3 → nostrc-cvqe) — every -Werror finding
# that fires under the debian hardening set (D_FORTIFY_SOURCE=3 + -O3
# + LTO) is now fixed upstream: auth_porthome*.c (h10m.3) plus the
# porthome-common + provisioner + syncd anchors (cvqe):
#   * unused-result:
#     - src/porthome/nh_porthome_provision.c   (fchownat + syslog)
#     - src/porthome-common/nh_porthome_status.c (write w/ EINTR loop)
#     - src/porthome-common/nostr-home-status.c  (system rc → CLI exit)
#     - src/porthome-syncd/nh_syncd_reconcile.c  (asprintf checked)
#   * stringop-truncation:
#     - src/porthome-syncd/nh_syncd_state.c      (snprintf)
# The corresponding -Wno-error=unused-result and
# -Wno-error=stringop-truncation overrides have been dropped.
# -Wno-error=unused-variable remains because it still fires
# elsewhere in the tree under LTO.
# The -include of debian/porthome-featuretest.h remains: it force-
# includes <limits.h> and <time.h> and defines _GNU_SOURCE (with an
# #ifndef guard) for translation units in libgo and elsewhere that
# still assume the older glibc defaults.
export DEB_CFLAGS_MAINT_APPEND = -Wno-error=unused-variable -include $(CURDIR)/debian/porthome-featuretest.h

DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

%:
	# --with installsysusers: dh_installsysusers is a separate
	# sequence in debhelper 13; enable it explicitly so it picks
	# up /usr/lib/sysusers.d/nostr-home-fetch.conf and generates
	# the systemd-sysusers scriptlet.
	dh $@ --buildsystem=cmake+ninja --with installsysusers

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib/$(DEB_HOST_MULTIARCH) \
		-DBUILD_SHARED_LIBS=ON \
		-DNOSTR_WITH_GLIB=OFF \
		-DBUILD_APPS=OFF \
		-DBUILD_NOSTR_GOBJECT=OFF \
		-DBUILD_NOSTR_GTK=OFF \
		-DBUILD_LIBHANAMI=ON \
		-DBUILD_LIBMARMOT=OFF \
		-DBUILD_MARMOT_GOBJECT=OFF \
		-DBUILD_RELAYD=ON \
		-DENABLE_NOSTR_DAV=ON \
		-DSIGNET_ENABLE=OFF \
		-DWITH_NOSTRDB=OFF \
		-DLIBNOSTR_WITH_NOSTRDB=OFF \
		-DWITH_NIP77_NOSTRDB=OFF \
		-DBUILD_TESTING=OFF \
		-DBUILD_TESTING_FRAMEWORK=OFF \
		-DENABLE_NIP57=OFF \
		-DENABLE_NIP5F=OFF \
		-DENABLE_NIP55L_STANDALONE_ACTIVATION=OFF \
		-DENABLE_NOSTR_HOMED=ON \
		-DNOSTR_HOMED_ENABLE_AUTH_CORE=ON \
		-DNOSTR_HOMED_ENABLE_IDENTITY_CORE=ON \
		-DNOSTR_HOMED_ENABLE_NSS=ON \
		-DNOSTR_HOMED_ENABLE_AUTH_RUNTIME=ON \
		-DNOSTR_HOMED_ENABLE_PAM=ON \
		-DNOSTR_HOMED_ENABLE_SMB=ON \
		-DNOSTR_HOMED_ENABLE_CTL=ON \
		-DNOSTR_HOMED_ENABLE_DOMAIN_CONFIG=ON \
		-DNOSTR_HOMED_ENABLE_AUTH_INSTALL=ON \
		-DNOSTR_HOMED_ENABLE_SESSION_RELAY_UNITS=ON \
		-DNOSTR_HOMED_BUILD_TESTS=OFF \
		-DNOSTR_HOMED_ENABLE_PORTHOME_EXPERIMENTAL=ON \
		-DNOSTR_HOMED_ENABLE_SYNCD_EXPERIMENTAL=ON \
		-DNOSTR_HOMED_ENABLE_PORTHOME_FUSE_EXPERIMENTAL=ON

override_dh_auto_install:
	dh_auto_install
	# Ship /etc/nostr-auth/auth.conf as a real conffile (CMake only stages
	# the sample under /usr/share/nostr-homed/). Copy the sample verbatim
	# into /etc/nostr-auth/ so dh_installdeb picks it up as a conffile.
	install -d debian/tmp/etc/nostr-auth
	install -m 0644 debian/tmp/usr/share/nostr-homed/auth.conf.sample \
		debian/tmp/etc/nostr-auth/auth.conf
	# Wave 4 / #22a (packaging plan §5.2): the samba-server subpackage
	# owns the standalone smb.conf pair as real conffiles. CMake stages
	# the `.sample` copies under /usr/share/nostr-homed/; rename them
	# into /etc/nostr-auth/ so nostr-authd can drive `smbpasswd -c` /
	# `pdbedit -s` against the operator's live copy and dh_installdeb
	# marks them as conffiles.  The server-identity example lives
	# alongside them under servers.d/ (drop-in dir — nostr-authd loads
	# it at start).  Sample originals stay under /usr/share/nostr-homed
	# for provenance; not-installed is silent — dh_missing sees both.
	if [ -f debian/tmp/usr/share/nostr-homed/smb.conf.standalone.sample ]; then \
		install -m 0644 debian/tmp/usr/share/nostr-homed/smb.conf.standalone.sample \
			debian/tmp/etc/nostr-auth/smb.conf; \
	fi
	if [ -f debian/tmp/usr/share/nostr-homed/smb-credentiald.conf.sample ]; then \
		install -m 0644 debian/tmp/usr/share/nostr-homed/smb-credentiald.conf.sample \
			debian/tmp/etc/nostr-auth/smb-credentiald.conf; \
	fi
	install -d debian/tmp/etc/nostr-auth/servers.d
	if [ -f debian/tmp/usr/share/doc/nostrc/examples/servers.d/example.conf ]; then \
		install -m 0644 debian/tmp/usr/share/doc/nostrc/examples/servers.d/example.conf \
			debian/tmp/etc/nostr-auth/servers.d/example.conf; \
	fi
	# nostr-homed's PROJECT_NAME is `nostr_homed` (underscore), so CMake's
	# CMAKE_INSTALL_DOCDIR lands docs under /usr/share/doc/nostr_homed —
	# not a valid Debian doc dir name. Rename to the owning package's dir.
	# GNUInstallDirs was first included in the root nostrc project, so
	# CMAKE_INSTALL_DOCDIR resolves to share/doc/nostrc for every
	# subproject including nostr-homed. Move nostr-homed's shipped PAM
	# examples into the owning binary package's doc dir.
	# pam-auth-update parses /usr/share/pam-configs/<name> as a strict
	# Debian control-format file and does not tolerate `#`-comment lines.
	# The shipped source file starts with a 40+ line rationale header — copy
	# it into libpam-nostr's doc dir for provenance and strip the header from
	# the installed profile so the postinst pam-auth-update run is silent.
	if [ -f debian/tmp/usr/share/pam-configs/nostr ]; then \
		mkdir -p debian/tmp/usr/share/doc/libpam-nostr; \
		cp debian/tmp/usr/share/pam-configs/nostr \
			debian/tmp/usr/share/doc/libpam-nostr/nostr.pam-configs.annotated; \
		sed -i '/^Name:/,$$!d' debian/tmp/usr/share/pam-configs/nostr; \
	fi
	if [ -d debian/tmp/usr/share/doc/nostrc/examples/pam ]; then \
		mkdir -p debian/tmp/usr/share/doc/libpam-nostr/examples; \
		cp -a debian/tmp/usr/share/doc/nostrc/examples/pam \
			debian/tmp/usr/share/doc/libpam-nostr/examples/; \
		rm -rf debian/tmp/usr/share/doc/nostrc/examples/pam; \
		rmdir --ignore-fail-on-non-empty debian/tmp/usr/share/doc/nostrc/examples debian/tmp/usr/share/doc/nostrc 2>/dev/null || true; \
	fi

override_dh_shlibdeps:
	# nostr-homed-seed is installed via install(PROGRAMS $<TARGET_FILE:...>
	# RENAME ...) which copies the build-tree binary verbatim, preserving
	# the build-tree RUNPATH set by CMake. Strip it before shlibdeps so
	# lintian's custom-library-search-path ERROR does not fire.
	if [ -x debian/nostr-homectl/usr/sbin/nostr-homed-seed ]; then \
		chrpath -d debian/nostr-homectl/usr/sbin/nostr-homed-seed || true; \
	fi
	dh_shlibdeps -a

override_dh_makeshlibs:
	# pam_nostr.so and libnss_nostr.so.2 are loadable modules, not public
	# shared libraries — they must NOT be listed in shlibs (P5 of the
	# packaging plan). dh_shlibdeps still runs against them for their own
	# dependencies.
	dh_makeshlibs -Xpam_nostr -Xlibnss_nostr

override_dh_installsystemd:
	# Do not auto-start or enable nostr-authd: an unseeded broker has no
	# accounts, so admins must seed with nostr-homed-seed first.
	dh_installsystemd --no-start --no-enable --name=nostr-authd
	# Wave 4 / #22a: dedicated Samba subpackage. The operator seeds
	# passdb + configures shares BEFORE the smbd instance is safe to
	# run — auto-enabling ships a Samba on TCP 445/139 the operator
	# never asked for. Ship the unit, do not start or enable it.
	dh_installsystemd --no-start --no-enable --name=nostr-smbd

override_dh_installsystemduser:
	# Portable-home user units (nostr-home-sync, nostr-home-fuse) and
	# the Wave-4 user units (nostr-session-relay.{service,socket},
	# nostr-notify.service, nostr-dav.service, nostr-dav-dirs.service)
	# are opt-in per session — the session relay socket contract is
	# 0600 + $XDG_RUNTIME_DIR ownership, and the notifier / DAV bridge
	# need signer + relay presence before they do useful work. Users
	# run `systemctl --user enable --now nostr-session-relay.socket`
	# etc. after provisioning their portable identity. This matches
	# the base nostr-authd posture above.
	dh_installsystemduser --no-enable

override_dh_auto_test:
	# Tests disabled at configure (BUILD_TESTING=OFF), so dh_auto_test
	# is otherwise a no-op. Piggy-back the Wave-4 dep-purity gate here
	# so `dpkg-buildpackage -b` fails loudly if the auth broker or PAM
	# module accidentally gain a link edge to hanami/porthome/nip55l
	# client/FUSE surfaces (plan §5.1 #21a; script at
	# scripts/check-authd-dep-purity.sh). Runs against the BUILD-TREE
	# binaries — the installed-artifact re-run is #22c and lives on
	# the lab (see docs/reviews/wave4-packaging-smoke-*.md).
	@AUTHD=$$(find obj-* -type f -name nostr-authd -perm -111 2>/dev/null | head -n1); \
	PAM=$$(find obj-* -type f -name pam_nostr.so 2>/dev/null | head -n1); \
	if [ -z "$$AUTHD" ] || [ ! -x "$$AUTHD" ]; then \
	echo "dep-purity: nostr-authd binary not found under obj-*; skipping"; \
	exit 0; \
	fi; \
	echo "dep-purity: checking $$AUTHD $$PAM"; \
	$(CURDIR)/scripts/check-authd-dep-purity.sh $$AUTHD $$PAM || exit $$?
