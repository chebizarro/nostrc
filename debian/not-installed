# Phase 1 (nostrc-rb0e.3 / D9): the following files build as part of the
# monorepo but are intentionally NOT packaged in this phase. They will be
# picked up by later phase packages (GObject / GTK / desktop / apps).
usr/bin/gnostr-neg
usr/bin/nostr-signer-cli
usr/bin/nostr-signer-daemon
usr/share/dbus-1/services/org.nostr.Signer.service

# NIP libraries are aggregated (D-6): the plan calls for folding them
# into libnostr1 or a single libnostr-nips0 package, not per-NIP debs.
# Phase 1 does not ship them. Use ${DEB_HOST_MULTIARCH} wildcards so
# the list is arch-agnostic (see debhelper #961104).
usr/include/nip40.h
usr/lib/libnip04.a
usr/lib/libnip05.so
usr/lib/libnip25.so
usr/lib/libnostr_nip77.a
usr/lib/*/libnip19.so
usr/lib/*/libnostr_nip55l_core.so
usr/lib/*/libnostr_nip55l_glib.so

# nostrc-t58t: upstream now gates the test_relay_eose install rule on
# BUILD_TESTING (tools/CMakeLists.txt), and the porthome-common CLI is
# now claimed by nostr-home-sync.install. Both prior orphans removed.

# Phase 1 does not ship a libnostr-homed-dev package; nostr-homed.pc is
# multiarch-specific and would be a lintian ERROR in an arch:foreign
# daemon package. Defer to the future -dev package.
usr/lib/*/pkgconfig/nostr-homed.pc

# Phase 5 (bead nostrc-h10m.2): libhanami0 ships the runtime shared
# library only. No libhanami-dev this phase — the portable-home stack
# has no third-party consumers yet and no downstream API stability is
# promised. Drop the -devel bits (unversioned .so symlink + pkg-config
# + headers) so dh_missing does not warn.
usr/lib/*/libhanami.so
usr/lib/*/pkgconfig/hanami.pc
usr/include/hanami/*

# Wave 4 packaging (#22a): BUILD_RELAYD=ON is now on so
# nostr-session-relayd (the per-user session daemon) ships in
# nostrc-session-relay.deb.  The sibling `nostrc-relayd` system
# daemon (network relay) still needs its own future
# `nostr-relayd` debian package (per docs/designs/packaging-plan-
# debian-fedora.md §2.3 "Headless — servers & tools"); until that
# package lands, deliberately drop the artifact set.  Filed as a
# follow-up bead so we don't lose track.
usr/sbin/nostrc-relayd
usr/lib/systemd/system/nostr-relayd.service
usr/share/nostrc/relay.toml.example

# Wave 3 leftovers: the sweep timer + service, close-session user
# teardown unit, browse helper + autostart entry, and the admin
# CLI nostr-authctl are all part of the SMB auth flow but not yet
# packaged into `nostr-homed-smb`.  Track as a follow-up bead — for
# Wave 4 packaging (#22a) they ride under not-installed so the
# build ships the four NEW packages without a scope creep into
# nostr-homed-smb.  Users who need these paths can install from
# the source tarball with `dh_auto_install` locally.
usr/sbin/nostr-authctl
usr/lib/systemd/system/nostr-smb-sweep.service
usr/lib/systemd/system/nostr-smb-sweep.timer
usr/lib/systemd/user/nostr-smb-teardown.service
usr/bin/nostr-smb-browse
etc/xdg/autostart/nostr-smb-browse.desktop
usr/share/nostr-homed/nsswitch.conf.snippet.sample
usr/share/doc/nostrc/examples/servers.d/example.conf.batch-client
