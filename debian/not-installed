# Phase 1 (nostrc-rb0e.3 / D9): the following files build as part of the
# monorepo but are intentionally NOT packaged in this phase. They will be
# picked up by later phase packages (GObject / GTK / desktop / apps).
usr/bin/gnostr-neg
usr/bin/nostr-signer-cli
usr/bin/nostr-signer-daemon
usr/share/dbus-1/services/org.nostr.Signer.service

# NIP libraries are aggregated (D-6): the plan calls for folding them
# into libnostr1 or a single libnostr-nips0 package, not per-NIP debs.
# Phase 1 does not ship them. Use ${DEB_HOST_MULTIARCH} wildcards so
# the list is arch-agnostic (see debhelper #961104).
usr/include/nip40.h
usr/lib/libnip04.a
usr/lib/libnip05.so
usr/lib/libnip25.so
usr/lib/libnostr_nip77.a
usr/lib/*/libnip19.so
usr/lib/*/libnostr_nip55l_core.so
usr/lib/*/libnostr_nip55l_glib.so

# Test binary that installs via a stray CMake rule (build-tree leak).
# Broader glob catches every build dir (nostrc-build, nostrc-porthome-pkg,
# nostrc-h10m-pkg, ...). Upstream fix tracked in nostrc-t58t.
tmp/nostrc-build/nostrc-0.3.0/obj-*-linux-gnu/tools/test_relay_eose
tmp/nostrc-*/obj-*-linux-gnu/tools/test_relay_eose

# Orphan (nostrc-t58t): the porthome-common status CLI is built by CMake
# but not yet claimed by any .install file — the natural home is
# nostr-home-sync.install (semantic sibling of nostr-home-syncd). Owner
# is Worker B / porthome-common; suppress until they land the package
# assignment so the deb build succeeds.
usr/bin/nostr-home-status

# Phase 1 does not ship a libnostr-homed-dev package; nostr-homed.pc is
# multiarch-specific and would be a lintian ERROR in an arch:foreign
# daemon package. Defer to the future -dev package.
usr/lib/*/pkgconfig/nostr-homed.pc

# Phase 5 (bead nostrc-h10m.2): libhanami0 ships the runtime shared
# library only. No libhanami-dev this phase — the portable-home stack
# has no third-party consumers yet and no downstream API stability is
# promised. Drop the -devel bits (unversioned .so symlink + pkg-config
# + headers) so dh_missing does not warn.
usr/lib/*/libhanami.so
usr/lib/*/pkgconfig/hanami.pc
usr/include/hanami/*
