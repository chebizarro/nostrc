# nostrc phase 1: internal PPA-style build (D-13). Tarball is generated by
# dpkg-source with the excludes below; the archive-NEW upload will switch to
# 3.0 (quilt) later.
tar-ignore = ".git"
tar-ignore = ".github"
tar-ignore = "_build"
tar-ignore = "build"
tar-ignore = ".repoprompt-worktrees"
tar-ignore = "debian/.debhelper"
