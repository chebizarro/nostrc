          "after": "        run: |\n          python3 -m pip install --break-system-packages 'cmake==3.31.6'\n          # The pip entrypoint is a Python launcher; CMake records its real binary.\n          # Select that same binary for configure/build rather than weakening identity checks.\n          python3 -c 'import cmake; print(cmake.CMAKE_BIN_DIR)' >> \"$GITHUB_PATH\"\n"
        }
