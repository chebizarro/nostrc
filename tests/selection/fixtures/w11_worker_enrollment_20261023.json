  "source_edits": {
    ".github/workflows/dependency-worker.yml": [
      {
        "after": "          case \"$PROFILE\" in\n            core.linux|grotto.linux|groundhog.linux)\n              # The outer gate owns private services and post-namespace-exit\n              # sealing. Unsupported runner kernels retain refusal, not green.\n              set +e\n              bash scripts/test-gate.sh --head \"$REQUESTED_SHA\" \\\n                --plan \"$RUNNER_TEMP/dependency/plan.json\" --profile \"$PROFILE\" \\\n                --native-custody pidns --evidence-dir \"$RUNNER_TEMP/dependency/evidence\" \\\n                2>&1 | tee \"$RUNNER_TEMP/dependency/receipts/$PROFILE/worker.log\"\n              gate_status=${PIPESTATUS[0]}\n              set -e\n              GATE_STATUS=\"$gate_status\" python3 - <<'PY'\n          import json, os, shutil, sys\n          from pathlib import Path\n          sys.path.insert(0, 'scripts')\n          from test_selection_services import verify_native_public_receipt\n          base = Path(os.environ['RUNNER_TEMP']) / 'dependency'\n          matches = []\n          for path in (base / 'evidence').glob('*/0/lane-*/native-receipt.json'):\n              raw = json.loads(path.read_text())\n              if (raw.get('plan_id') == os.environ['PLAN_ID'] and raw.get('profile') == os.environ['PROFILE']\n                      and raw.get('source_identity') == dict(kind='committed', sha=os.environ['REQUESTED_SHA'])):\n                  verify_native_public_receipt(raw)\n                  matches.append(path)\n          if len(matches) > 1 or (not matches and os.environ['GATE_STATUS'] == '0'):\n              raise SystemExit('missing/ambiguous exact-plan retained native receipt')\n          if matches:\n              shutil.copyfile(matches[0], base / 'receipts' / os.environ['PROFILE'] / 'receipt.json')\n          PY\n              exit \"$gate_status\"\n              ;;\n          esac\n          parallel_args=(--parallel 2)\n",
        "before": "          parallel_args=(--parallel 2)\n"
      }
    ]
  },
