cmake_minimum_required(VERSION 3.22)
# Verify both a fresh configure and a reconfigure with existing cache entries.
if(NOT TEST_BINARY_DIR)
  message(FATAL_ERROR "Pass -DTEST_BINARY_DIR=<task-owned temporary directory>")
endif()
file(MAKE_DIRECTORY "${TEST_BINARY_DIR}/src")
get_filename_component(_helper "${CMAKE_CURRENT_LIST_DIR}/../../cmake/VersionHelpers.cmake" ABSOLUTE)
file(WRITE "${TEST_BINARY_DIR}/src/library.c" "int exported(void) { return 0; }\n")
file(WRITE "${TEST_BINARY_DIR}/src/CMakeLists.txt" "
cmake_minimum_required(VERSION 3.22)
project(component C)
include(\"${_helper}\")
set(ENABLE_COMPONENT_VERSIONING ON)
add_library(component SHARED library.c)
declare_component_version(component 0 1 2)
apply_versioning(component)
get_target_property(v component VERSION)
get_target_property(s component SOVERSION)
if(NOT v STREQUAL \"0.1.2\" OR NOT s STREQUAL \"0\")
  message(FATAL_ERROR \"Version lost: VERSION=\${v}, SOVERSION=\${s}\")
endif()
")
foreach(_pass RANGE 1 2)
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TEST_BINARY_DIR}/src"
    -B "${TEST_BINARY_DIR}/build" RESULT_VARIABLE _result)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Version scope regression on configure ${_pass}")
  endif()
endforeach()
file(REMOVE_RECURSE "${TEST_BINARY_DIR}")
