prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: nip78
Description: NIP-78 unsigned application data event codec
Version: @PROJECT_VERSION@
Requires: nostr
Libs: -L${libdir} -lnostr_nip78_core
Cflags: -I${includedir}
