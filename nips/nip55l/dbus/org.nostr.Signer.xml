<node>
  <interface name="org.nostr.Signer">
    <!-- Access control (nip55l 0.4.0). Every method below except StoreKey,
         ClearKey, ApproveRequest and GetApprovalInfo is approval-gated:
         GetPublicKey, GetRelays, SignEvent, NIP04*, NIP44* (incl. B64),
         NIP44DeriveConversationKey and DecryptZapEvent, plus their *ForApp
         variants. The caller is identified from its bus connection
         (Flatpak app id, systemd app scope + executable, or executable) -
         never from an argument. A remembered decision is keyed on
         (that principal, the npub the identity selector resolves to,
         request kind); without one the call is parked and
         ApprovalRequested(app_id = principal, identity = npub, kind,
         preview, request_id) is emitted. Kinds: event,
         nip44_conversation_key, get_public_key, get_relays, nip04_encrypt,
         nip04_decrypt, nip44_encrypt, nip44_decrypt, zap_decrypt.
         An app_id argument is a web-origin sub-principal only when the
         caller is the installed browser bridge (nostr-signer-webext-host);
         from anyone else it is an unverified label. Errors common to gated
         calls: Error.ApprovalDenied (denied, timed out, or no approval agent
         running), Error.RateLimited, Error.NoKeyConfigured. A connection that
         called EnableTypedApprovalErrors gets Error.ApprovalTimedOut and
         Error.NoApprovalAgent for the last two cases, and
         Error.IdentityChanged for the identity check below, instead (0.5.0).
         Identity binding: an npub or 64-hex selector names exactly that
         stored identity or fails with Error.NoKeyConfigured before any
         prompt; it never falls back to another key. An approved request
         runs only if its selector still resolves to the npub the user
         approved (the one in ApprovalRequested); if the active account
         switched meanwhile it fails, not signs with the new key. NIP-04/NIP-44 replies
         carry no pubkey, so a caller relies on this service guarantee for
         them; SignEvent replies can be checked against their pubkey. -->
    <!-- EnableTypedApprovalErrors (nip55l 0.5.0, additive, ungated): opt the
         calling bus connection in to typed approval errors for as long as it
         stays connected. Afterwards its gated calls fail with
         Error.ApprovalTimedOut when a parked request expires unanswered and
         with Error.NoApprovalAgent when a prompt is needed but no approval
         UI is on the bus, and with Error.IdentityChanged when it was
         approved but its selector no longer resolves to the approved npub;
         Error.ApprovalDenied then means only a denial (by the user, by a
         remembered decision, or because the caller disconnected).
         Without the opt-in all of these stay Error.ApprovalDenied, so
         pre-0.5.0 clients are unaffected. Messages are informational and not
         part of the contract. Opting in affects only the caller's own
         replies; a pre-0.5.0 service answers with UnknownMethod. Method
         calls on one connection are handled in order, so a client may send
         this, unawaited, right before a gated call. -->
    <method name="EnableTypedApprovalErrors" />
    <method name="GetPublicKey">
      <arg type="s" direction="out" name="npub" />
    </method>
    <!-- *ForApp variants (0.4.0, additive): the same call with an app_id,
         which lets the browser bridge ask on behalf of one web origin. -->
    <method name="GetPublicKeyForApp">
      <arg type="s" direction="in" name="app_id" />
      <arg type="s" direction="out" name="npub" />
    </method>
    <!-- SignEvent (nip55l 0.2.0): signs an unsigned event and returns the
         COMPLETE signed event JSON - id, pubkey, created_at, kind, tags,
         content and sig. pubkey is always the signing key's; a zero or
         missing created_at is filled with the current time. Before 0.2.0
         this method returned only the 128-hex Schnorr signature; callers
         must parse signed_event rather than treat it as a signature.
         Errors: Error.InvalidInput (not an event), Error.ApprovalDenied,
         Error.RateLimited, Error.NoKeyConfigured, Error.Internal. -->
    <method name="SignEvent">
      <arg type="s" direction="in" name="eventJson" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="in" name="app_id" />
      <arg type="s" direction="out" name="signed_event" />
    </method>
    <method name="NIP04Encrypt">
      <arg type="s" direction="in" name="plaintext" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="out" name="encryptedText" />
    </method>
    <method name="NIP04EncryptForApp">
      <arg type="s" direction="in" name="plaintext" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="in" name="app_id" />
      <arg type="s" direction="out" name="encryptedText" />
    </method>
    <method name="NIP04Decrypt">
      <arg type="s" direction="in" name="encryptedText" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="out" name="plaintext" />
    </method>
    <method name="NIP04DecryptForApp">
      <arg type="s" direction="in" name="encryptedText" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="in" name="app_id" />
      <arg type="s" direction="out" name="plaintext" />
    </method>
    <method name="NIP44Encrypt">
      <arg type="s" direction="in" name="plaintext" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="out" name="encryptedText" />
    </method>
    <method name="NIP44EncryptForApp">
      <arg type="s" direction="in" name="plaintext" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="in" name="app_id" />
      <arg type="s" direction="out" name="encryptedText" />
    </method>
    <method name="NIP44Decrypt">
      <arg type="s" direction="in" name="encryptedText" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="out" name="plaintext" />
    </method>
    <method name="NIP44DecryptForApp">
      <arg type="s" direction="in" name="encryptedText" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="in" name="app_id" />
      <arg type="s" direction="out" name="plaintext" />
    </method>
    <!-- Binary-safe NIP-44: the plaintext side travels as standard base64.
         D-Bus strings must be valid UTF-8, so a raw binary plaintext cannot
         ride NIP44Encrypt/NIP44Decrypt at all. The ciphertext is an ordinary
         NIP-44 v2 payload either way. Distinct method names, not a flag, so a
         signer without the capability errors instead of encrypting base64
         text as if it were the plaintext. -->
    <method name="NIP44EncryptB64">
      <arg type="s" direction="in" name="plaintextB64" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="out" name="encryptedText" />
    </method>
    <method name="NIP44EncryptB64ForApp">
      <arg type="s" direction="in" name="plaintextB64" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="in" name="app_id" />
      <arg type="s" direction="out" name="encryptedText" />
    </method>
    <method name="NIP44DecryptB64">
      <arg type="s" direction="in" name="encryptedText" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="out" name="plaintextB64" />
    </method>
    <method name="NIP44DecryptB64ForApp">
      <arg type="s" direction="in" name="encryptedText" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="in" name="app_id" />
      <arg type="s" direction="out" name="plaintextB64" />
    </method>
    <!-- NIP44DeriveConversationKey (nip55l 0.3.0): the NIP-44 v2
         conversation key between `identity` and peerPubKey (64-hex x-only),
         i.e. HKDF-extract(SHA256, ECDH shared-x, salt "nip44-v2"), as 64
         lowercase hex. The secret key never leaves the signer, but the
         returned key opens every NIP-44 payload exchanged with that peer, so
         the call goes through the same approval flow as SignEvent (kind
         "nip44_conversation_key", preview = the peer). nostr-seal (nostrc-da9c) derives
         with a per-file ephemeral peer, so the key it obtains opens one
         file's key stanza and nothing else.
         Errors: Error.InvalidInput (peer not a curve point / not 64-hex),
         Error.ApprovalDenied, Error.RateLimited, Error.NoKeyConfigured,
         Error.Internal. -->
    <method name="NIP44DeriveConversationKey">
      <arg type="s" direction="in" name="peerPubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="in" name="app_id" />
      <arg type="s" direction="out" name="conversationKey" />
    </method>
    <method name="DecryptZapEvent">
      <arg type="s" direction="in" name="eventJson" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="out" name="decryptedEvent" />
    </method>
    <method name="DecryptZapEventForApp">
      <arg type="s" direction="in" name="eventJson" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="in" name="app_id" />
      <arg type="s" direction="out" name="decryptedEvent" />
    </method>
    <!-- GetRelays: JSON array of the user's explicitly configured relay
         URLs, from $XDG_CONFIG_HOME/nostr/relays.conf, else the relays set
         in grotto. Never fetched from the network. Returns
         Error.NotFound when nothing is configured - callers fall back to
         their own relay set - and Error.InvalidConfig for a malformed
         relays.conf. -->
    <method name="GetRelays">
      <arg type="s" direction="out" name="relaysJson" />
    </method>
    <method name="GetRelaysForApp">
      <arg type="s" direction="in" name="app_id" />
      <arg type="s" direction="out" name="relaysJson" />
    </method>
    <!-- StoreKey / ClearKey / CreateProfile (nip55l 0.7.0): the signer's own
         UI may store, remove and create keys. It is identified as for
         ApproveRequest (executable path and inode, or Flatpak id); a caller
         the bus cannot attest is refused. Anyone else gets
         Error.PermissionDenied unless the daemon runs with
         NOSTR_SIGNER_ALLOW_KEY_MUTATIONS=1 (tests, scripts). -->
    <method name="StoreKey">
      <arg type="s" direction="in" name="key" />
      <arg type="s" direction="in" name="identity" />
      <arg type="b" direction="out" name="ok" />
      <arg type="s" direction="out" name="npub" />
    </method>
    <method name="ClearKey">
      <arg type="s" direction="in" name="identity" />
      <arg type="b" direction="out" name="ok" />
    </method>
    <!-- ApproveRequest / GetApprovalInfo: only the installed approval UI
         (grotto, by executable path and inode, or its Flatpak) may
         call these; anyone else gets Error.PermissionDenied. remember=true
         stores the decision for (principal, identity, kind), for
         ttl_seconds or forever (0); it is ignored for an unidentified
         caller. A decision covers every queued call that joined the
         request. Unanswered requests expire after 300 s. -->
    <method name="ApproveRequest">
      <arg type="s" direction="in" name="request_id" />
      <arg type="b" direction="in" name="decision" />
      <arg type="b" direction="in" name="remember" />
      <arg type="t" direction="in" name="ttl_seconds" />
      <arg type="b" direction="out" name="ok" />
    </method>
    <!-- GetApprovalInfo (0.4.0): details of a pending request as a{sv}:
         request_id, kind, principal, principal_kind (flatpak | snap |
         systemd-scope | executable | website | unidentified), app_id, exe,
         via (web origins: the bridge's principal), claimed_app_id (the
         caller's unverified app_id argument), identity, preview (s);
         attested, rememberable (b); calls (u). -->
    <method name="GetApprovalInfo">
      <arg type="s" direction="in" name="request_id" />
      <arg type="a{sv}" direction="out" name="info" />
    </method>
    <!-- ListPendingRequests (0.7.0, additive, approval UI only): every
         request still awaiting an answer, as (app_id, identity, kind,
         preview, request_id), the arguments of ApprovalRequested. The UI
         calls it when it starts: the daemon starts the UI itself
         (org.freedesktop.DBus.StartServiceByName on the approval UI's bus
         name) when a request needs an answer and no UI is on the bus, and
         requests made before the UI subscribed would otherwise be missed.
         If the UI cannot be started, those requests fail with
         Error.NoApprovalAgent. -->
    <method name="ListPendingRequests">
      <arg type="a(sssss)" direction="out" name="requests" />
    </method>
    <!-- ListGrants / RevokeGrant (additive; nostrc-yjky): the remembered
         decisions in $XDG_CONFIG_HOME/gnostr/signer-grants.ini, which the
         signer owns, for the approval UI's permissions page. Approval UI only,
         like ApproveRequest (else Error.PermissionDenied). A grant is
         (kind, principal, identity, allow, expires_at): identity is an npub
         or "*" (any identity), expires_at unix seconds or 0 = never; expired
         entries are listed too so they can be cleaned up. Built-in defaults
         for first-party services are not grants and are not listed.
         RevokeGrant removes one entry; returns whether it existed. -->
    <method name="ListGrants">
      <arg type="a(sssbt)" direction="out" name="grants" />
    </method>
    <method name="RevokeGrant">
      <arg type="s" direction="in" name="kind" />
      <arg type="s" direction="in" name="principal" />
      <arg type="s" direction="in" name="identity" />
      <arg type="b" direction="out" name="removed" />
    </method>
    <signal name="ApprovalRequested">
      <arg type="s" name="app_id" />
      <arg type="s" name="identity" />
      <arg type="s" name="kind" />
      <arg type="s" name="preview" />
      <arg type="s" name="request_id" />
    </signal>
    <signal name="ApprovalCompleted">
      <arg type="s" name="request_id" />
      <arg type="b" name="decision" />
    </signal>
    <!-- CreateProfile (nip55l 0.6.0, additive, approval UI only): generates a
         new random Nostr keypair, stores the secret key in the backend
         (libsecret or Keychain), and returns the npub. Requires
         NOSTR_SIGNER_ALLOW_KEY_MUTATIONS; without it, Error.PermissionDenied.
         display_name is stored as the key's label; passphrase, recovery_hint
         and label are reserved for future use (pass "" for each).
         use_hardware_key is reserved (pass FALSE). -->
    <method name="CreateProfile">
      <arg type="s" direction="in" name="display_name" />
      <arg type="s" direction="in" name="passphrase" />
      <arg type="s" direction="in" name="recovery_hint" />
      <arg type="s" direction="in" name="label" />
      <arg type="b" direction="in" name="use_hardware_key" />
      <arg type="b" direction="out" name="ok" />
      <arg type="s" direction="out" name="npub" />
    </method>
    <!-- ListIdentities (nip55l 0.6.0, additive): returns all stored identity
         npubs as a string array. On macOS these come from Keychain; on Linux
         from libsecret. No approval gating. -->
    <method name="ListIdentities">
      <arg type="as" direction="out" name="npubs" />
    </method>
  </interface>
</node>

