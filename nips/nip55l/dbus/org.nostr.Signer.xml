<node>
  <interface name="org.nostr.Signer">
    <method name="GetPublicKey">
      <arg type="s" direction="out" name="npub" />
    </method>
    <!-- SignEvent (nip55l 0.2.0): signs an unsigned event and returns the
         COMPLETE signed event JSON - id, pubkey, created_at, kind, tags,
         content and sig. pubkey is always the signing key's; a zero or
         missing created_at is filled with the current time. Before 0.2.0
         this method returned only the 128-hex Schnorr signature; callers
         must parse signed_event rather than treat it as a signature.
         Errors: Error.InvalidInput (not an event), Error.ApprovalDenied,
         Error.RateLimited, Error.NoKeyConfigured, Error.Internal. -->
    <method name="SignEvent">
      <arg type="s" direction="in" name="eventJson" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="in" name="app_id" />
      <arg type="s" direction="out" name="signed_event" />
    </method>
    <method name="NIP04Encrypt">
      <arg type="s" direction="in" name="plaintext" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="out" name="encryptedText" />
    </method>
    <method name="NIP04Decrypt">
      <arg type="s" direction="in" name="encryptedText" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="out" name="plaintext" />
    </method>
    <method name="NIP44Encrypt">
      <arg type="s" direction="in" name="plaintext" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="out" name="encryptedText" />
    </method>
    <method name="NIP44Decrypt">
      <arg type="s" direction="in" name="encryptedText" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="out" name="plaintext" />
    </method>
    <!-- Binary-safe NIP-44: the plaintext side travels as standard base64.
         D-Bus strings must be valid UTF-8, so a raw binary plaintext cannot
         ride NIP44Encrypt/NIP44Decrypt at all. The ciphertext is an ordinary
         NIP-44 v2 payload either way. Distinct method names, not a flag, so a
         signer without the capability errors instead of encrypting base64
         text as if it were the plaintext. -->
    <method name="NIP44EncryptB64">
      <arg type="s" direction="in" name="plaintextB64" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="out" name="encryptedText" />
    </method>
    <method name="NIP44DecryptB64">
      <arg type="s" direction="in" name="encryptedText" />
      <arg type="s" direction="in" name="pubKey" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="out" name="plaintextB64" />
    </method>
    <method name="DecryptZapEvent">
      <arg type="s" direction="in" name="eventJson" />
      <arg type="s" direction="in" name="identity" />
      <arg type="s" direction="out" name="decryptedEvent" />
    </method>
    <!-- GetRelays: JSON array of the user's explicitly configured relay
         URLs, from $XDG_CONFIG_HOME/nostr/relays.conf, else the relays set
         in gnostr-signer. Never fetched from the network. Returns
         Error.NotFound when nothing is configured - callers fall back to
         their own relay set - and Error.InvalidConfig for a malformed
         relays.conf. -->
    <method name="GetRelays">
      <arg type="s" direction="out" name="relaysJson" />
    </method>
    <method name="StoreKey">
      <arg type="s" direction="in" name="key" />
      <arg type="s" direction="in" name="identity" />
      <arg type="b" direction="out" name="ok" />
      <arg type="s" direction="out" name="npub" />
    </method>
    <method name="ClearKey">
      <arg type="s" direction="in" name="identity" />
      <arg type="b" direction="out" name="ok" />
    </method>
    <method name="ApproveRequest">
      <arg type="s" direction="in" name="request_id" />
      <arg type="b" direction="in" name="decision" />
      <arg type="b" direction="in" name="remember" />
      <arg type="t" direction="in" name="ttl_seconds" />
      <arg type="b" direction="out" name="ok" />
    </method>
    <signal name="ApprovalRequested">
      <arg type="s" name="app_id" />
      <arg type="s" name="identity" />
      <arg type="s" name="kind" />
      <arg type="s" name="preview" />
      <arg type="s" name="request_id" />
    </signal>
    <signal name="ApprovalCompleted">
      <arg type="s" name="request_id" />
      <arg type="b" name="decision" />
    </signal>
  </interface>
</node>

