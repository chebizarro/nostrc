prefix=${pcfiledir}/@NIP44_PC_PREFIX_RELATIVE@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: nostr-nip44
Description: Nostr NIP-44 v2 encryption core (libnostr bundle)
Version: @NOSTR_VERSION@
Requires.private: nostr, openssl, libsecp256k1
Libs: -L${libdir} -lnostr_nip44_core
Cflags: -I${includedir}
