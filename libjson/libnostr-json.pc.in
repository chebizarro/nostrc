prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@/nostr

Name: libnostr-json
Description: Nostr JSON interop layer (jansson wrappers for libnostr; formerly nostr_json)
Version: @NOSTR_JSON_VERSION@
Requires.private: nostr >= 2.5.2
Libs: -L${libdir} -lnostr-json @NOSTR_JSON_PC_LIBS@
Cflags: -I${includedir} @NOSTR_JSON_PC_CFLAGS@
