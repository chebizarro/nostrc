prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@/nostr

Name: libnostr-json
Description: Nostr JSON interop layer (jansson wrappers for libnostr; formerly nostr_json)
Version: @NOSTR_JSON_VERSION@
Requires: jansson
Libs: -L${libdir} -lnostr-json
Cflags: -I${includedir}
