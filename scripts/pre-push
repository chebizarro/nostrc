#!/usr/bin/env bash
# Validate pushed commits in temporary worktrees, never in the caller's checkout.
#
# For each pushed ref: the candidate's static checks (the Linux image's package
# list, and no call argument modifying a variable another argument uses: x86_64
# GCC evaluates arguments right to left), then the macOS (host)
# build and full CTest run (a test that fails is rerun once, alone, announced
# and counted, as in the Linux stage: scripts/linux-gate-smoke.sh), and in parallel the Linux stage
# (scripts/linux-gate.sh: a GCC build of every default target plus Groundhog in
# an Ubuntu 24.04 container, and a smoke CTest subset) on its own checkout of
# the same commit, and the sanitizer stage (scripts/linux-gate.sh --sanitizers:
# groundhog-ci.yml's groundhog-sanitizers job, ASAN+UBSAN+LSan, read from the
# candidate's workflow) on that checkout too, when the pushed range touches
# what that job tests (scripts/sanitizer-gate-ci.py affected). All three run at
# once (the sanitizer tests themselves after the macOS build); any failure
# blocks the push.
#
# The Linux stages need Docker. Without it the push is blocked; on a machine
# that cannot run Docker, set NOSTRC_SKIP_LINUX_GATE=1 to validate on the host
# only (announced on every push). NOSTRC_SKIP_SANITIZER_GATE=1 skips the
# sanitizer stage alone (announced too). NOSTRC_GATE_AMD64=1 runs the Linux
# stage as linux/amd64 under emulation (slow); the sanitizer stage stays native.
set -euo pipefail
# Bash reads a script while running it: parse all of it first, so a checkout
# that rewrites this file mid-run cannot splice two versions together.
{

repo_root="$(git rev-parse --show-toplevel)"
tmp="$(mktemp -d)"
checkout=""
linux_src=""
linux_pid=""
sanitizer_pid=""
remove_worktree() {
    git -C "$repo_root" worktree remove --force "$1" || true
}
cleanup() {
    for pid in "$linux_pid" "$sanitizer_pid"; do
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
        fi
    done
    if [ -n "$checkout" ]; then remove_worktree "$checkout"; fi
    if [ -n "$linux_src" ]; then remove_worktree "$linux_src"; fi
    rm -rf "$tmp"
}
trap cleanup EXIT

# Collect a background stage's result (linux or sanitizer) and block the push
# if it failed. With "if-done", only when it has already finished (a Linux-only
# break then fails the push before the macOS test run, not after it).
finish_stage() {
    local stage="$1" pid_var="${1}_pid" log_var="${1}_log" status=0 pid
    pid="${!pid_var}"
    [ -n "$pid" ] || return 0
    if [ "${2:-}" = if-done ] && kill -0 "$pid" 2>/dev/null; then
        return 0
    fi
    wait "$pid" || status=$?
    printf -v "$pid_var" '%s' ""
    cat "${!log_var}"
    if [ "$status" -ne 0 ]; then
        if [ "$stage" = linux ]; then
            echo "Linux build failed for $local_ref ($local_oid) - push blocked" >&2
        else
            echo "Sanitizer gate failed for $local_ref ($local_oid): a sanitizer report, a test failure, or a test missing from the set - push blocked" >&2
            echo "(NOSTRC_SKIP_SANITIZER_GATE=1 skips this stage; fix the report instead: a leak or UB found here fails groundhog-sanitizers on master.)" >&2
        fi
        exit 1
    fi
}
finish_stages() {
    finish_stage linux "$@"
    finish_stage sanitizer "$@"
}

# A detached worktree of $2 at $1, with the submodules the build needs.
add_checkout() {
    git -c core.hooksPath=/dev/null -C "$repo_root" worktree add --detach "$1" "$2"
    for submodule in third_party/nsync third_party/nostrdb; do
        if git -C "$1" ls-files --stage -- "$submodule" | grep -q "^160000 "; then
            git -c core.hooksPath=/dev/null -C "$1" submodule update --init "$submodule"
        fi
    done
}

# 1: run the Linux stage; 0: skipped by NOSTRC_SKIP_LINUX_GATE; "": not decided
# yet (a push that only deletes refs needs no Docker).
linux_gate=""
linux_gate_enabled() {
    if [ -z "$linux_gate" ]; then
        if [ "${NOSTRC_SKIP_LINUX_GATE:-0}" = 1 ]; then
            linux_gate=0
            echo "!! Pre-push: Linux build SKIPPED (NOSTRC_SKIP_LINUX_GATE=1)." >&2
            echo "!! These commits are validated on this host only; glibc/GCC-only breaks can still reach master." >&2
        elif ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
            echo "Pre-push: the Linux build needs Docker, which is not available (not installed, or the daemon is not running)." >&2
            echo "Start Docker and push again. On a machine without Docker, set NOSTRC_SKIP_LINUX_GATE=1 to validate on this host only - push blocked" >&2
            exit 1
        else
            linux_gate=1
        fi
    fi
    [ "$linux_gate" = 1 ]
}

# Whether the sanitizer stage runs for the range $1..$2 (an empty $1: base
# unknown). Prints why it runs or is skipped; the banner of a skip by
# NOSTRC_SKIP_SANITIZER_GATE is loud because it lets a leak reach master.
sanitizer_gate_wanted() {
    local why status=0
    if [ "${NOSTRC_SKIP_SANITIZER_GATE:-0}" = 1 ]; then
        echo "!! ================================================================" >&2
        echo "!! Pre-push: SANITIZER STAGE SKIPPED (NOSTRC_SKIP_SANITIZER_GATE=1)." >&2
        echo "!! $local_ref ($local_oid) is NOT checked under ASAN/UBSAN/LSan;" >&2
        echo "!! a leak or UB it adds turns groundhog-sanitizers red on master." >&2
        echo "!! ================================================================" >&2
        return 1
    fi
    if [ "$linux_gate" != 1 ]; then
        echo "!! Pre-push: sanitizer stage SKIPPED too: it runs in the Linux container (NOSTRC_SKIP_LINUX_GATE=1)." >&2
        return 1
    fi
    if [ -z "$1" ]; then
        echo "Pre-push: sanitizer stage runs: no known base for $local_ref, so the whole commit counts"
        return 0
    fi
    # Fail closed: a range git cannot compute (a force push over a remote tip
    # never fetched) runs the stage rather than reading as "no files".
    local changed
    if ! changed="$(git -C "$repo_root" diff --name-only --no-renames "$1" "$2" 2>"$tmp/diff.err")"; then
        echo "Pre-push: sanitizer stage runs: git cannot list what $local_ref changes since $1 ($(head -1 "$tmp/diff.err")), so the whole commit counts"
        return 0
    fi
    why="$(printf '%s\n' "$changed" | python3 "$repo_root/scripts/sanitizer-gate-ci.py" affected)" || status=$?
    case "$status" in
        0) echo "Pre-push: sanitizer stage runs: $why"; return 0 ;;
        1) echo "Pre-push: sanitizer stage skipped for $local_ref: $why"; return 1 ;;
        *) echo "Pre-push: cannot tell which files $local_ref changes - push blocked" >&2; exit 1 ;;
    esac
}

zero_oid=0000000000000000000000000000000000000000
# The macOS stage's rerun history, shared by all worktrees (the Linux stage's
# is in its Docker volume). --path-format needs git 2.31; an older git echoes
# the unknown option back, so anything but an absolute path falls back to
# resolving the (possibly relative) common dir from the checkout (W25 review N6).
git_common_dir="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
case "$git_common_dir" in
    /*$'\n'*|'') git_common_dir="" ;;
    /*) ;;
    *) git_common_dir="" ;;
esac
if [ -z "$git_common_dir" ]; then
    git_common_dir="$(cd "$repo_root" && cd "$(git rev-parse --git-common-dir)" && pwd)" || {
        echo "Pre-push: cannot find this repository's git directory - push blocked" >&2
        exit 1
    }
fi
macos_history="$git_common_dir/nostrc-macos-gate-history"
# nostrc-2hmd: a developer's default keychain once pointed at a throwaway test
# keychain for days. Read-only; a no-op off macOS and in checkouts without it.
keychain_guard() {
    if [ -f "$repo_root/scripts/check-macos-keychain.sh" ] &&
       ! bash "$repo_root/scripts/check-macos-keychain.sh"; then
        echo "Pre-push: the macOS keychain configuration is not the login keychain ($1) - push blocked" >&2
        exit 1
    fi
}
keychain_guard "before the tests"
saw_ref=0
while read -r local_ref local_oid remote_ref remote_oid; do
    [ -n "${local_ref:-}" ] || continue
    saw_ref=1
    # A deleted ref has no candidate tree to validate.
    [ "$local_oid" != "$zero_oid" ] || continue

    if [ -n "$checkout" ]; then
        remove_worktree "$checkout"
        checkout=""
    fi
    checkout="$tmp/checkout"
    add_checkout "$checkout" "$local_oid"

    # Static checks shipped with the candidate (none in older commits).
    for check in scripts/check-linux-ci-packages.py scripts/check-unsequenced-args.py scripts/check-gui-test-gdk-frame.py; do
        if [ -f "$checkout/$check" ]; then
            python3 "$checkout/$check" --root "$checkout"
        fi
    done

    base="$remote_oid"
    if [ "$base" = "$zero_oid" ]; then
        base="$(git -C "$repo_root" merge-base "$local_oid" refs/remotes/origin/master 2>/dev/null || true)"
    fi

    # The Linux stages get their own checkout: the macOS build rewrites
    # committed Blueprint .ui files in its tree, which a container must not
    # copy half-written. Both containers only read it.
    linux_log="$tmp/linux.log"
    sanitizer_log="$tmp/sanitizer.log"
    if linux_gate_enabled; then
        if [ -n "$linux_src" ]; then
            remove_worktree "$linux_src"
            linux_src=""
        fi
        linux_src="$tmp/linux-src"
        add_checkout "$linux_src" "$local_oid" >/dev/null
        echo "Pre-push verification (Linux, in background): $local_ref ($local_oid)"
        "$repo_root/scripts/linux-gate.sh" "$linux_src" < /dev/null > "$linux_log" 2>&1 &
        linux_pid=$!
    fi
    # The sanitizer tests wait for this file, so they run after the macOS
    # build: under a build's load their exit races lose into leak reports.
    host_build_done="$tmp/host-build/done"
    mkdir -p "$tmp/host-build"
    rm -f "$host_build_done"
    if sanitizer_gate_wanted "$base" "$local_oid"; then
        echo "Pre-push verification (Linux ASAN+UBSAN+LSan, in background): $local_ref ($local_oid)"
        NOSTRC_GATE_HOST_BUILD_SIGNAL="$host_build_done" \
            "$repo_root/scripts/linux-gate.sh" --sanitizers "$linux_src" < /dev/null > "$sanitizer_log" 2>&1 &
        sanitizer_pid=$!
    fi

    groundhog=OFF
    if [ -z "$base" ]; then
        # Without a known base, validate the optional component too.
        groundhog=ON
    # Groundhog links gnostr-secret, nip19, nostr, and nostr_gobject;
    # nostr_gobject generates its signer proxy from NIP-55L's D-Bus XML.
    # Include their build configuration, the copied account-test schema, and CI recipe.
    elif ! git -C "$repo_root" diff --quiet "$base" "$local_oid" -- \
        CMakeLists.txt cmake/ \
        gnome/groundhog/ gnome/seahorse/ \
        libnostr/ nostr-gobject/ nips/nip19/ nips/nip55l/ \
        apps/gnostr/data/schemas/org.gnostr.gnostr.gschema.xml \
        .github/workflows/groundhog-ci.yml; then
        groundhog=ON
    fi

    build="$tmp/build"
    echo "Pre-push verification: $local_ref ($local_oid), BUILD_GROUNDHOG=$groundhog"
    cmake -S "$checkout" -B "$build" -DCMAKE_BUILD_TYPE=Debug -DBUILD_GROUNDHOG="$groundhog"
    cmake --build "$build"
    : > "$host_build_done"
    finish_stages if-done
    test_count="$(ctest --test-dir "$build" -N | awk '/^Total Tests: [0-9]+$/ { print $3 }')"
    if ! [[ "$test_count" =~ ^[1-9][0-9]*$ ]]; then
        echo "No registered CTest tests for $local_ref (count=${test_count:-unknown}) - push blocked" >&2
        exit 1
    fi
    # The full run, and a rerun of what failed in it, as in the Linux stage:
    # scripts/linux-gate-smoke.sh (this checkout's, beside linux-gate.sh). A
    # rerun is announced, its first output printed, and it is counted in the
    # history shared by every worktree of this repository. Each test's result
    # is printed as it comes; an interrupted run keeps its log in the history.
    echo "Pre-push verification: macOS CTest run for $local_ref ($local_oid)"
    mkdir -p "$tmp/macos-gate"
    BUILD_DIR="$build" STATE_DIR="$tmp/macos-gate" HISTORY_DIR="$macos_history" \
        JOBS="${CTEST_PARALLEL_LEVEL:-1}" TEST_REGEX=. DISPLAY_WRAP=0 CTEST_TIMEOUT= \
        GATE="macOS gate" SUITE="tests" PROGRESS=1 \
        bash "$repo_root/scripts/linux-gate-smoke.sh"
    keychain_guard "after the macOS tests: a test changed it"
    rm -rf "$build"
    finish_stages
done

if [ "$saw_ref" -eq 0 ]; then
    echo "No pre-push refs received - push blocked" >&2
    exit 1
fi
exit
}
