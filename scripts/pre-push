#!/usr/bin/env bash
# Pre-push: cheap static guards, then affected local tests on pushed trees.
#
# The guards run first: whitespace errors in the pushed range (git diff --check),
# and the repository static checkers on the pushed tree (not the working tree):
#   scripts/check-unsequenced-args.py, scripts/check-gui-test-gdk-frame.py,
#   scripts/check-linux-ci-packages.py, gnome/groundhog/tests/check_privacy.py
# Each checker runs only if the pushed commit ships it. The guard phase is cheap;
# selected builds/tests follow unless explicitly bypassed.
#
# The former full gate (macOS build + CTest, Linux Docker build, sanitizer
# stage) is scripts/full-gate.sh. Opt in per push with
#   NOSTRC_FULL_GATE=1 git push ...
# NOSTRC_SKIP_PRE_PUSH=1 skips this hook's static and affected checks (announced).
# Affected local tests run after these guards by default. NOSTRC_SELECTIVE_GATE=0
# is an announced local-test bypass; NOSTRC_FULL_GATE=1 runs the real full gate.
set -euo pipefail
{

repo_root="$(git rev-parse --show-toplevel)"

if [ "${NOSTRC_FULL_GATE:-0}" = 1 ]; then
    echo "Pre-push: NOSTRC_FULL_GATE=1, running scripts/full-gate.sh"
    exec "$repo_root/scripts/full-gate.sh" "$@"
fi

input="$(cat)"
if [ -z "$input" ]; then
    echo "No pre-push refs received - push blocked" >&2
    exit 1
fi
tmp="$(mktemp -d)"
checkout=""
remove_checkout() {
    if [ -n "$checkout" ]; then
        git -C "$repo_root" worktree remove --force "$checkout" >/dev/null 2>&1 || true
        checkout=""
    fi
}
cleanup() {
    remove_checkout
    rm -rf "$tmp"
}
trap cleanup EXIT

printf '%s\n' "$input" > "$tmp/refs"
if [ "${NOSTRC_SKIP_PRE_PUSH:-0}" = 1 ]; then
    echo "!! Pre-push: static and affected checks SKIPPED (NOSTRC_SKIP_PRE_PUSH=1)." >&2
    if [ "${NOSTRC_SELECTIVE_GATE:-0}" = 1 ]; then
        # Plan-only evidence makes this explicit bypass visible; no execution
        # or receipt may suggest the skipped mandatory static checks passed.
        bash "$repo_root/scripts/test-gate.sh" --repo "$repo_root" --pre-push --explain --refs-file "$tmp/refs"
    fi
    exit 0
fi
is_zero_oid() { [[ "$1" =~ ^0+$ ]]; }
failed=0
while read -r local_ref local_oid _remote_ref remote_oid; do
    [ -n "${local_ref:-}" ] || continue
    # A deleted ref has no tree to check.
    ! is_zero_oid "$local_oid" || continue

    base="$remote_oid"
    if is_zero_oid "$base"; then
        base="$(git -C "$repo_root" merge-base "$local_oid" refs/remotes/origin/master 2>/dev/null || true)"
    fi
    echo "Pre-push checks: $local_ref ($local_oid)"
    if [ -n "$base" ]; then
        if ! git -C "$repo_root" diff --check "$base" "$local_oid" -- . ":(exclude).beads/**"; then
            echo "Pre-push: whitespace errors in $local_ref (git diff --check $base $local_oid)" >&2
            failed=1
        fi
    fi

    # The pushed tree: a detached checkout without submodules (no build).
    remove_checkout
    checkout="$tmp/checkout"
    git -c core.hooksPath=/dev/null -C "$repo_root" worktree add -q --detach "$checkout" "$local_oid"

    for check in scripts/check-unsequenced-args.py scripts/check-gui-test-gdk-frame.py scripts/check-linux-ci-packages.py; do
        if [ -f "$checkout/$check" ] && ! python3 "$checkout/$check" --root "$checkout"; then
            echo "Pre-push: $check failed for $local_ref" >&2
            failed=1
        fi
    done
    privacy=gnome/groundhog/tests/check_privacy.py
    if [ -f "$checkout/$privacy" ] && ! python3 "$checkout/$privacy" "$checkout/gnome/groundhog"; then
        echo "Pre-push: $privacy failed for $local_ref" >&2
        failed=1
    fi
done <<< "$input"

if [ "$failed" -ne 0 ]; then
    echo "Pre-push static checks failed - push blocked (NOSTRC_SKIP_PRE_PUSH=1 bypasses)" >&2
    exit 1
fi
if [ "${NOSTRC_SELECTIVE_GATE:-1}" != 0 ]; then
    echo "Pre-push: affected local tests (legacy CMake/CTest; not whole-CI coverage)"
    bash "$repo_root/scripts/test-gate.sh" --execution legacy --repo "$repo_root" --pre-push --refs-file "$tmp/refs"
else
    echo "!! Pre-push: affected local tests SKIPPED (NOSTRC_SELECTIVE_GATE=0)." >&2
fi
exit 0
}
