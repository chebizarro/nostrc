# Public settings and protected-file paths only; no secret values.
# Production deployment uses deploy/README.md and its separate deploy.env layout.
# Paths below are IN-CONTAINER paths; install/mount real protected files first.
SIGNET_REQUIRE_ENCRYPTED_DB=true
SIGNET_DB_KEY_FILE=/run/secrets/signet_db_key
SIGNET_BUNKER_NSEC_FILE=/run/secrets/signet_bunker_nsec
# Ops service only (do not mount backup/provisioner keys into signetd):
# SIGNET_BACKUP_KEY_FILE=/run/secrets/signet_backup_key
# Operator workstation only:
# SIGNET_PROVISIONER_NSEC_FILE=/secure/signet-provisioner.nsec
# SIGNET_BUNKER_PUBKEY=<public hex or npub>
SIGNET_RELAYS=wss://nos.lol,wss://relay.nostr.band
SIGNET_DB_PATH=/data/signet.db
SIGNET_POLICY_PATH=/data/policies.conf
SIGNET_AUDIT_PATH=/data/audit.jsonl
SIGNET_HEALTH_PORT=8080
SIGNET_BOOTSTRAP_PORT=0
# Optional passkeys image only; single-instance PSK file:
# SIGNET_PASSKEYS_SYNC_KEY_FILE=/run/secrets/signet_passkey_sync_key
# Provisioner desired state belongs in rw /etc/signet/signet.conf, not env.
# Files: effective-UID-owned, owner-only, non-symlink. See README for key rules.
