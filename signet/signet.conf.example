# SPDX-License-Identifier: MIT
#
# Signet configuration (GKeyFile INI format)
#
# Required environment variables (Signet refuses to start without these):
#   SIGNET_DB_KEY       - Master key for SQLCipher (min 32 bytes, base64 or hex encoded)
#   SIGNET_BUNKER_NSEC_FILE - file containing Signet's bunker identity nsec
#
# All config values may be overridden by SIGNET_-prefixed environment variables.
# Lists use semicolons as separators (GKeyFile format).
#
# RELOADING (SIGHUP)
# ------------------
# `kill -HUP <signetd pid>` re-reads this whole file, validates it, and either
# applies it or keeps running on the last valid configuration. It also rotates
# the audit log and reloads the policy file.
#
# Live-reloadable:
#   [nostr] relays, provisioner_pubkeys, reconnect_interval_s
#   [policy_defaults] default_decision, allowed_kinds, rate_limit_rpm
#   [server] log_level
#   the policy file's contents
#
# Restart-only (a change is WARNED in the log, never silently ignored):
#   listeners        - [server] health_port, [bootstrap] port, [dbus] *,
#                      [nip5l] *, [ssh_agent] *
#   storage bindings - [store] db_path, [audit] *, [policy_defaults] policy_file,
#                      [replay] *
#   identity         - [nostr] identity, bunker_pubkey, [uid_map], [passkeys] *
#
# provisioner_pubkeys is DESIRED STATE: on reload this list wins, so removing a
# pubkey here and sending SIGHUP revokes it. The reverse is NOT true — a
# provisioner revoked at runtime (config/revoke-provisioner) is never restored
# by a reload, even if this file still lists it. Runtime grants and revocations
# are written back into this file so the two never disagree; signetd therefore
# needs write access to it. Setting SIGNET_PROVISIONER_PUBKEYS defeats that
# write-back — prefer the file.

[server]
log_level = info
health_port = 8080

[store]
# Path to SQLCipher database file
db_path = /data/signet.db
# Master key injected via env: SIGNET_DB_KEY (required, no default)
# Minimum 32 bytes of entropy, base64 or hex encoded

[nostr]
# Signet's own bunker identity
# Read from the path in SIGNET_BUNKER_NSEC_FILE (required, no default)

# Bunker public key (npub or 64-char hex). Lets clients (e.g. signetctl) address
# the bunker WITHOUT its secret. Ignored by the daemon (it derives the pubkey
# from SIGNET_BUNKER_NSEC_FILE). Env override: SIGNET_BUNKER_PUBKEY.
# bunker_pubkey = npub1...

# Relay URLs (semicolon-separated)
relays = wss://relay.example.com

reconnect_interval_s = 30

# Pubkeys authorized to send management events (hex, semicolon-separated)
provisioner_pubkeys = aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Identity name for this bunker instance
identity = default

[policy_defaults]
default_decision = deny
# Path to policy JSON file (optional)
policy_file =
allowed_kinds =
rate_limit_rpm = 0

# Replay protection
[replay]
max_entries = 50000
ttl_seconds = 600
skew_seconds = 120

# Audit logging (structured JSON to stdout, 12-factor)
[audit]
path =
stdout = true

[bootstrap]
# HTTP bootstrap listener; Wave 0 automated delivery sends bunker:// handoff
# payloads over NIP-17/NIP-59 gift-wrap instead.
port = 0

[uid_map]
# SO_PEERCRED peer UID -> agent_id mapping for the local D-Bus Unix and SSH
# agent transports. Each entry is "<numeric-uid> = <agent_id>". A caller whose
# peer UID is not listed here is rejected (Unauthorized). Required to make the
# D-Bus Unix / SSH agent transports usable.
# 1000 = agent-alpha
# 1001 = agent-beta

[passkeys]
# Programmatic WebAuthn/FIDO2 authenticator API. Off by default.
enabled = false
backend = software-openssl
# Frozen Signet software-authenticator AAGUID. Override to all-zero for max privacy.
aaguid = 80c64041-9927-4901-957f-e0032db96bee
attestation = none
# Headless UP is always asserted after Signet policy approval. UV-required ceremonies
# default-deny unless this explicit opt-in is true.
allow_headless_uv = false
# Optional Linux-only /dev/uhid virtual CTAP-HID device for browser/libfido2 use.
# Disabled by default; requires SIGNET_ENABLE_PASSKEYS build, Linux, and /dev/uhid access.
virtual_ctap = false
# Fleet PSK for portable passkey credential wrapping (64 hex chars), or a file
# containing the same. Prefer sync_key_file or SIGNET_PASSKEYS_SYNC_KEY_FILE.
sync_key =
sync_key_file =
