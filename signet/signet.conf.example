# SPDX-License-Identifier: MIT
#
# Signet configuration (GKeyFile INI format)
#
# Production inputs (0.8.0 file-key contract):
#   SIGNET_DB_KEY_FILE - protected master-key file (>=32 bytes key material)
#   SIGNET_BUNKER_NSEC_FILE - protected bunker identity file
#   SIGNET_REQUIRE_ENCRYPTED_DB=true - require a usable persistent SQLCipher store
#   SIGNET_BACKUP_KEY_FILE - independent protected key for local backup/restore
# Master/backup files: effective-UID-owned regular files, no group/world bits,
# no symlinks, <=4 KiB, nonempty single line; one trailing LF/CRLF is stripped.
# Do not combine a nonempty legacy SIGNET_DB_KEY / SIGNET_BACKUP_KEY value with
# its *_FILE path. Keep secret values out of environment files and argv.
#
# Supported overrides are listed in README.md (not every INI field has one).
# Lists use semicolons as separators (GKeyFile format).
#
# RELOADING (SIGHUP)
# ------------------
# `kill -HUP <signetd pid>` re-reads this whole file, validates it, and either
# applies it or keeps running on the last valid configuration. It also rotates
# the audit log and reloads the policy file.
#
# Live-reloadable:
#   [nostr] relays, provisioner_pubkeys, reconnect_interval_s
#   [policy_defaults] default_decision, allowed_kinds, rate_limit_rpm
#   [server] log_level
#   the policy file's contents
#
# Restart-only (a change is WARNED in the log, never silently ignored):
#   listeners        - [server] health_port, [bootstrap] *, [dbus] *,
#                      [nip5l] *, [ssh_agent] *
#   storage bindings - [store] db_path, [audit] *, [policy_defaults] policy_file,
#                      [replay] *
#   identity         - [nostr] identity, bunker_pubkey, [uid_map], [passkeys] *
#
# provisioner_pubkeys is DESIRED STATE: on reload this list wins, so removing a
# pubkey here and sending SIGHUP revokes it. A tombstone blocks a listed key
# only while this file's mtime <= its revocation time: a later edit to a stale
# list can re-grant a revoked key if runtime write-back had failed.
# Runtime grants/revocations persist first, then write the effective list back.
# Mount /etc/signet as a rw directory owned by 10001:10001 (0750); atomic rename
# needs directory write access. Edit + reload OR use signed runtime commands;
# do not mix without reloading. Never set SIGNET_PROVISIONER_PUBKEYS in production:
# it shadows the file, defeats write-back and is older than every revocation.
# See deploy/README.md for preflight and observable write-back failures.

# Independent backend authority: both public pins required. Disabled by default.
# Storage must NOT be cloned with gateway disks. Pins are immutable/restart-only.
# [backend_admission]
# authority_id = 11111111-1111-1111-1111-111111111111
# operator_pubkey = <64 lowercase hex public key>
# Env: SIGNET_BACKEND_AUTHORITY_ID and SIGNET_BACKEND_OPERATOR_PUBKEY.

[server]
log_level = info
health_port = 8080

[store]
# Path to SQLCipher database file
db_path = /data/signet.db
# Master key via SIGNET_DB_KEY_FILE (no value stored in this INI).
# Generate >=32 bytes with a CSPRNG; length validation is not entropy measurement.

[nostr]
# Signet's own bunker identity
# Read from the path in SIGNET_BUNKER_NSEC_FILE (required, no default)

# Bunker public key (npub or 64-char hex). Lets clients (e.g. signetctl) address
# the bunker WITHOUT its secret. Ignored by the daemon (it derives the pubkey
# from SIGNET_BUNKER_NSEC_FILE). Env override: SIGNET_BUNKER_PUBKEY.
# bunker_pubkey = npub1...

# Relay URLs (semicolon-separated)
relays = wss://relay.example.com

reconnect_interval_s = 30

# Pubkeys authorized to send management events (hex, semicolon-separated)
provisioner_pubkeys = aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Identity name for this bunker instance
identity = default

[policy_defaults]
default_decision = deny
# GKeyFile INI policy file: see policies.conf.example, [identity.<name>] groups.
# Mutable state; runtime policy updates persist here.
policy_file = /data/policies.conf
allowed_kinds =
rate_limit_rpm = 0

# Replay protection. ttl_seconds and max_entries apply to NIP-46 requests;
# management requests must be within skew_seconds of Signet's clock (by their
# authenticated created_at) and their ids are kept for 2 * skew_seconds.
[replay]
max_entries = 50000
ttl_seconds = 600
skew_seconds = 120

# Separate unchained operational audit stream; preserve with the backup bundle.
[audit]
path = /data/audit.jsonl
stdout = false

[bootstrap]
# Packaged but disabled at launch: no production HTTP session-token consumer.
# Optional Caddy profile only; listener is loopback, never public health/metrics.
port = 0
# 0.8.0 TLS trust contract (restart-only): trusted TCP peer AND exactly one
# X-Forwarded-Proto: https. Loopback trust separates on-box from off-box only.
require_tls = true
trusted_proxy_cidrs = 127.0.0.0/8;::1/128;
# Env: SIGNET_BOOTSTRAP_REQUIRE_TLS; SIGNET_BOOTSTRAP_TRUSTED_PROXY_CIDRS (CSV).

[dbus]
unix_enabled = false
tcp_enabled = false
tcp_port = 47472

[nip5l]
enabled = false
socket_path = /run/signet/nip5l.sock

[ssh_agent]
enabled = false
socket_path = /run/signet/ssh-agent.sock

[uid_map]
# SO_PEERCRED peer UID -> agent_id mapping for the local D-Bus Unix and SSH
# agent transports. Each entry is "<numeric-uid> = <agent_id>". A caller whose
# peer UID is not listed here is rejected (Unauthorized). Required to make the
# D-Bus Unix / SSH agent transports usable.
# 1000 = agent-alpha
# 1001 = agent-beta

[passkeys]
# Programmatic WebAuthn/FIDO2 authenticator API. Off by default.
enabled = false
backend = software-openssl
# Frozen Signet software-authenticator AAGUID. Override to all-zero for max privacy.
aaguid = 80c64041-9927-4901-957f-e0032db96bee
attestation = none
# Headless UP is always asserted after Signet policy approval. UV-required ceremonies
# default-deny unless this explicit opt-in is true.
allow_headless_uv = false
# Optional Linux-only /dev/uhid virtual CTAP-HID device for browser/libfido2 use.
# Disabled by default; requires SIGNET_ENABLE_PASSKEYS build, Linux, and /dev/uhid access.
virtual_ctap = false
# Single-instance fleet PSK (64 hex chars); no cross-instance sync at launch.
# Keep separately from exported containers and backup objects. Prefer a mounted
# file via sync_key_file or SIGNET_PASSKEYS_SYNC_KEY_FILE, not a value in this INI.
sync_key =
sync_key_file =
