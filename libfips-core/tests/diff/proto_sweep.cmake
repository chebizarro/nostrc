execute_process(COMMAND "${RUNNER}" proto RESULT_VARIABLE status
  OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "proto runner failed (${status}):\n${output}${errors}")
endif()
string(REPLACE "\r\n" "\n" output "${output}")
string(REPLACE "\n" ";" lines "${output}")
set(summaries 0)
set(skips 0)
foreach(line IN LISTS lines)
  if(line MATCHES "^proto:")
    if(NOT line STREQUAL "proto: 28 checked, 0 skipped, 0 failed")
      message(FATAL_ERROR "Unexpected proto summary: ${line}")
    endif()
    math(EXPR summaries "${summaries} + 1")
  endif()
  if(line MATCHES "^SKIP ")
    math(EXPR skips "${skips} + 1")
  endif()
endforeach()
if(NOT summaries EQUAL 1 OR NOT skips EQUAL 0)
  message(FATAL_ERROR "Expected one summary and zero skips:\n${output}")
endif()
message(STATUS "${output}")
