# No source fixtures are mutated: every negative uses this private build copy.
file(REMOVE_RECURSE "${TEMP}")
file(MAKE_DIRECTORY "${TEMP}")
file(COPY "${VECTORS}/rekey-legacy" DESTINATION "${TEMP}")
set(doc "${TEMP}/rekey-legacy/v050-v051-fmp-current-initiates.json")
file(READ "${doc}" original)
function(expect_failure pattern label)
  execute_process(COMMAND "${RUNNER}" rekey-legacy "${TEMP}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT result STREQUAL "1" OR NOT "${out}${err}" MATCHES "${pattern}")
    file(REMOVE_RECURSE "${TEMP}")
    message(FATAL_ERROR "${label}: expected exit 1 / ${pattern}, got ${result}:\n${out}${err}")
  endif()
  message(STATUS "PASS ${label}: rejected")
endfunction()
execute_process(COMMAND "${RUNNER}" rekey-legacy "${TEMP}" RESULT_VARIABLE baseline OUTPUT_QUIET)
if(NOT baseline STREQUAL "0")
  file(REMOVE_RECURSE "${TEMP}")
  message(FATAL_ERROR "Unmodified legacy copy must pass before corruption")
endif()
file(REMOVE "${doc}")
expect_failure("cannot read" "missing legacy matrix cell")
file(WRITE "${doc}" "${original}")
string(JSON bad SET "${original}" pin "\"0000000000000000000000000000000000000000\"")
file(WRITE "${doc}" "${bad}")
expect_failure("pin mismatch" "legacy pin mismatch")
string(JSON bad SET "${original}" cases final_state 0 sent 999)
file(WRITE "${doc}" "${bad}")
expect_failure("sent: expected 999" "legacy final-state mismatch")
string(JSON bad SET "${original}" cases events 0 state_after sent 999)
file(WRITE "${doc}" "${bad}")
expect_failure("sent: expected 999" "legacy event-state mismatch")
string(JSON bad SET "${original}" cases legacy_initiates true)
file(WRITE "${doc}" "${bad}")
expect_failure("legacy matrix mismatch" "swapped matrix role")
file(WRITE "${doc}" "${original}")
string(JSON bin GET "${original}" cases events 0 outputs 0 bytes file)
file(WRITE "${TEMP}/rekey-legacy/${bin}" "corrupt")
expect_failure("sha256 mismatch|length mismatch" "legacy sidecar corruption")
file(REMOVE_RECURSE "${TEMP}")
message(STATUS "FipsDiffRekeyLegacySelfTest: all negative checks passed")
