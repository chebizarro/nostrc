# Every runner call is a fresh process using only this test's disposable copy.
file(REMOVE_RECURSE "${TEMP}")
file(MAKE_DIRECTORY "${TEMP}")
file(GLOB entropy_files "${VECTORS}/entropy-*.bin" "${VECTORS}/entropy.json")
function(reset_fixtures)
  file(COPY ${entropy_files} DESTINATION "${TEMP}")
endfunction()
function(expect_failure pattern label)
  execute_process(COMMAND "${RUNNER}" entropy "${TEMP}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(output "${out}${err}")
  if(NOT result STREQUAL "1" OR NOT output MATCHES "${pattern}")
    file(REMOVE_RECURSE "${TEMP}")
    message(FATAL_ERROR "${label}: expected exit 1 / ${pattern}, got ${result}:\n${output}")
  endif()
  message(STATUS "PASS ${label}: rejected with exit ${result}\n${output}")
endfunction()

reset_fixtures()
execute_process(COMMAND "${RUNNER}" entropy "${TEMP}" RESULT_VARIABLE baseline)
if(NOT baseline STREQUAL "0")
  file(REMOVE_RECURSE "${TEMP}")
  message(FATAL_ERROR "Unmodified entropy copy must pass before corruption")
endif()
foreach(mode bin hex)
  reset_fixtures()
  execute_process(COMMAND "${RUNNER}" --mutate "${mode}" "${TEMP}" RESULT_VARIABLE mutation)
  if(NOT mutation STREQUAL "0")
    file(REMOVE_RECURSE "${TEMP}")
    message(FATAL_ERROR "Could not mutate ${mode} fixture")
  endif()
  if(mode STREQUAL "bin")
    expect_failure("sha256 mismatch" "binary SHA-256 corruption")
  else()
    expect_failure("entropy/0/stream: first differing offset 0 .*expected length 1024.*expected:.*actual:" "inline hex offset diagnostic")
  endif()
endforeach()

# Provenance and structural failures must never turn into skipped coverage.
reset_fixtures()
file(READ "${TEMP}/entropy.json" original)
string(REGEX REPLACE "\"pin\": \"[0-9a-f]+\"" "\"pin\": \"0000000000000000000000000000000000000000\"" wrong_pin "${original}")
file(WRITE "${TEMP}/entropy.json" "${wrong_pin}")
expect_failure("pin mismatch: expected" "upstream pin mismatch")
string(REPLACE "\"length\": 42" "\"length\": 43" wrong_length "${original}")
file(WRITE "${TEMP}/entropy.json" "${wrong_length}")
expect_failure("length mismatch" "sidecar length mismatch")
file(REMOVE_RECURSE "${TEMP}")
message(STATUS "FipsDiffSelfTest: all negative checks passed; temporary fixtures removed")
