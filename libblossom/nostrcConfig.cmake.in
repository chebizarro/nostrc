@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(PkgConfig)
foreach(component IN LISTS nostrc_FIND_COMPONENTS)
  if(NOT component STREQUAL "blossom")
    set(nostrc_${component}_FOUND FALSE)
  else()
    # Use the installed pc dependency closure for both shared and static
    # consumers; no build-tree paths or sibling src directories are exported.
    set(_nostrc_saved_args "${PKG_CONFIG_ARGN}")
    list(APPEND PKG_CONFIG_ARGN --static)
    pkg_check_modules(NOSTRC_BLOSSOM REQUIRED IMPORTED_TARGET blossom)
    set(PKG_CONFIG_ARGN "${_nostrc_saved_args}")
    if(NOT TARGET nostrc::blossom)
      add_library(nostrc::blossom INTERFACE IMPORTED)
      set_property(TARGET nostrc::blossom PROPERTY INTERFACE_LINK_LIBRARIES PkgConfig::NOSTRC_BLOSSOM)
    endif()
    set(nostrc_blossom_FOUND TRUE)
  endif()
endforeach()
check_required_components(nostrc)
