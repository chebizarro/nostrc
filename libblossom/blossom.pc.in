prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
Name: blossom
Description: Content-addressed Blossom client with BUD-02 authorization
Version: @blossom_VERSION@
Requires.private: nostr libnostrgo libcurl openssl jansson libsecp256k1 libwebsockets
Libs: -L${libdir} -lblossom
Libs.private: @BLOSSOM_NSYNC_SEARCH@ -lbud02 -lpthread
Cflags: -I${includedir}
