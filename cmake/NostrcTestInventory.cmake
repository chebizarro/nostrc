# Additive selection metadata. Python owns the File API query and consumes this
# export only after configure AND generate have completed successfully.
include_guard(GLOBAL)

function(nostrc_describe_test name)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "" "EXPECTED" "OWNER;TARGETS;INPUTS;REQUIRES")
  if(ARG_UNPARSED_ARGUMENTS OR NOT TEST "${name}")
    message(FATAL_ERROR "nostrc_describe_test: invalid or unregistered test '${name}'")
  endif()
  get_property(_described TEST "${name}" PROPERTY NOSTRC_SELECTION_DESCRIBED)
  if(_described)
    message(FATAL_ERROR "nostrc_describe_test: duplicate descriptor for '${name}'")
  endif()
  set_property(TEST "${name}" PROPERTY NOSTRC_SELECTION_DESCRIBED TRUE)
  foreach(_field OWNER TARGETS INPUTS REQUIRES EXPECTED)
    set_property(TEST "${name}" PROPERTY "NOSTRC_SELECTION_${_field}" "${ARG_${_field}}")
  endforeach()
  foreach(_owner IN LISTS ARG_OWNER)
    set_property(TEST "${name}" APPEND PROPERTY LABELS "selection:${_owner}")
  endforeach()
endfunction()

function(_nostrc_inventory_string out value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(REPLACE "\t" "\\t" value "${value}")
  set(${out} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(_nostrc_inventory_directory out dir)
  get_property(_tests DIRECTORY "${dir}" PROPERTY TESTS)
  get_property(_binary DIRECTORY "${dir}" PROPERTY BINARY_DIR)
  set(_result "")
  foreach(_test IN LISTS _tests)
    get_property(_described TEST "${_test}" DIRECTORY "${dir}" PROPERTY NOSTRC_SELECTION_DESCRIBED)
    _nostrc_inventory_string(_name "${_test}")
    _nostrc_inventory_string(_source "${dir}")
    _nostrc_inventory_string(_build "${_binary}")
    set(_record "{\"name\":${_name},\"source_dir\":${_source},\"binary_dir\":${_build}")
    foreach(_field OWNER TARGETS INPUTS REQUIRES EXPECTED DECLARED_DEPENDS)
      get_property(_values TEST "${_test}" DIRECTORY "${dir}" PROPERTY "NOSTRC_SELECTION_${_field}")
      if(_field STREQUAL "DECLARED_DEPENDS")
        get_property(_values TEST "${_test}" DIRECTORY "${dir}" PROPERTY DEPENDS)
      endif()
      string(TOLOWER "${_field}" _key)
      set(_array "")
      foreach(_value IN LISTS _values)
        if(_field STREQUAL "INPUTS" AND NOT IS_ABSOLUTE "${_value}")
          get_filename_component(_value "${_value}" ABSOLUTE BASE_DIR "${dir}")
        endif()
        _nostrc_inventory_string(_value "${_value}")
        list(APPEND _array "${_value}")
      endforeach()
      list(JOIN _array "," _array)
      string(APPEND _record ",\"${_key}\":[${_array}]")
    endforeach()
    string(APPEND _record "}")
    list(APPEND _result "${_record}")
  endforeach()
  get_property(_children DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
  foreach(_child IN LISTS _children)
    _nostrc_inventory_directory(_entries "${_child}")
    list(APPEND _result ${_entries})
  endforeach()
  set(${out} "${_result}" PARENT_SCOPE)
endfunction()

function(nostrc_finalize_test_inventory)
  get_property(_done GLOBAL PROPERTY NOSTRC_TEST_INVENTORY_FINALIZED)
  if(_done)
    message(FATAL_ERROR "nostrc_finalize_test_inventory called twice")
  endif()
  set_property(GLOBAL PROPERTY NOSTRC_TEST_INVENTORY_FINALIZED TRUE)
  _nostrc_inventory_directory(_records "${CMAKE_SOURCE_DIR}")
  list(JOIN _records ",\n" _records)
  _nostrc_inventory_string(_token "${NOSTRC_TEST_SELECTION_TOKEN}")
  file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/nostrc-test-descriptors-$<CONFIG>.json"
    CONTENT "{\"schema_version\":1,\"generation_token\":${_token},\"tests\":[${_records}]}\n")
endfunction()
