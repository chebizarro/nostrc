# Select the OpenSSL ABI used by libwebsockets: its TLS callbacks pass SSL_CTX
# objects to libnostr, so mixing OpenSSL major versions corrupts those objects.
function(nostrc_openssl_root_from_linkage output linkage)
  string(REGEX MATCH "[ \t]([^ \t\n]+/lib/libssl\\.[0-9]+\\.dylib)[ \t]" _match "${linkage}")
  if(_match)
    get_filename_component(_libdir "${CMAKE_MATCH_1}" DIRECTORY)
    get_filename_component(_root "${_libdir}" DIRECTORY)
    set(${output} "${_root}" PARENT_SCOPE)
  else()
    set(${output} "" PARENT_SCOPE)
  endif()
endfunction()

function(nostrc_macos_lws_openssl_root output)
  find_package(PkgConfig QUIET)
  if(PKG_CONFIG_FOUND)
    pkg_check_modules(_nostrc_lws QUIET libwebsockets)
  endif()
  find_library(_nostrc_lws_library NAMES websockets HINTS ${_nostrc_lws_LIBRARY_DIRS})
  find_program(_nostrc_otool otool)
  set(_root "")
  if(_nostrc_lws_library AND _nostrc_otool)
    execute_process(COMMAND "${_nostrc_otool}" -L "${_nostrc_lws_library}"
      OUTPUT_VARIABLE _linkage RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0)
      message(FATAL_ERROR "Cannot inspect libwebsockets TLS linkage: ${_error}")
    endif()
    nostrc_openssl_root_from_linkage(_root "${_linkage}")
  endif()
  set(${output} "${_root}" PARENT_SCOPE)
endfunction()
