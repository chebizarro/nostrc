prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
Name: vault
Description: Shared-vault rings, epochs, grants, owner-sequencer fold and discovery
Version: @vault_VERSION@
Requires: porthome blossom
Requires.private: nostr openssl
Libs: -L${libdir} -lvault
Libs.private: -lnostr_nip44_core
Cflags: -I${includedir}
